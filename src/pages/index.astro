    <!-- Drawer Footer -->
    <div class="p-4 border-t border-slate-100 bg-slate-50/80 text-center">
      <div class="inline-flex items-center gap-2 text-xs font-semibold text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Zero Server Uploads • Private
