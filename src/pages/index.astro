      { name: "Convert Image to 300 DPI", url: "/convert-image-to-300-dpi/", category: "DPI", badge: "300 DPI", keywords: "dpi 300 photo print crisp passport visa" },
      { name: "3.5 x 4.5 cm Photo 50KB", url: "/photo-3-5-x-4-5-cm-50kb/", category: "Dimensions", badge: "Passport CM", keywords: "3.5 4.5 cm photo passport exam" },
      { name: "Compress PDF to 100KB", url: "/compress-pdf-to-100kb/", category: "PDF", badge: "Max 100KB", keywords: "pdf 100kb document marksheet certificate" },
      { name: "Compress PDF to 200KB", url: "/compress-pdf-to-200kb/", category: "PDF", badge: "Max 200KB", keywords: "pdf 200kb legal scan upload" },
      { name: "Compress PDF to 50KB", url: "/compress-pdf-to-50kb/", category: "PDF", badge: "Ultra Lite", keywords: "pdf 50kb tiny" },
      { name: "Merge & Compress PDF 200KB", url: "/merge-compress-pdf-200kb/", category: "PDF", badge: "Multi-Page", keywords: "merge combine pdf 200kb multi page" },
      { name: "Compress Scanned PDF 100KB", url: "/compress-scanned-pdf-100kb/", category: "PDF", badge: "Scan Mode", keywords: "scanned marksheet pdf 100kb" },
      { name: "YouTube Thumbnail Under 2MB", url: "/compress-youtube-thumbnail-2mb/", category: "Platform", badge: "< 2MB", keywords: "youtube thumbnail 2mb creator 1280x720 video" },
      { name: "Discord Emoji / Sticker 256KB", url: "/compress-discord-emoji-256kb/", category: "Platform", badge: "256 KB", keywords: "discord emoji sticker 256kb emote" },
      { name: "Discord Image Upload Under 8MB", url: "/compress-image-for-discord-8mb/", category: "Platform", badge: "< 8MB", keywords: "discord image 8mb upload nitro free" },
      { name: "Instagram Post & Story", url: "/compress-image-for-instagram/", category: "Platform", badge: "4:5 & 9:16", keywords: "instagram post story 1080 feed carousel" },
      { name: "WhatsApp Status & DP", url: "/compress-image-for-whatsapp/", category: "Platform", badge: "Fast Send", keywords: "whatsapp dp profile status image" },
      { name: "Shopify Product Image (<100KB)", url: "/compress-image-for-shopify/", category: "Platform", badge: "< 100KB", keywords: "shopify ecommerce product photo webp" },
      { name: "SSC Photo & Signature Resizer", url: "/ssc-photo-and-signature-resizer/", category: "Exams", badge: "SSC Portal", keywords: "ssc cgl chsl photo signature 20kb 50kb 200 dpi" },
      { name: "UPSC Photo Resize (20-300KB)", url: "/upsc-photo-resize-in-kb/", category: "Exams", badge: "Civil Services", keywords: "upsc civil services photo 20kb 300kb" },
      { name: "Signature Compressor to 20KB", url: "/signature-compressor-20kb/", category: "Exams", badge: "10-20 KB", keywords: "signature sign 10kb 20kb exam ibps sbi" },
      { name: "140x60 Pixel Signature Resizer", url: "/140x60-pixel-signature-20kb/", category: "Exams", badge: "IBPS Format", keywords: "140x60 pixels signature ibps banking sign" },
      { name: "US Visa Photo 2x2 Inches (240KB)", url: "/us-visa-photo-2x2-inches/", category: "Passports", badge: "US Dept State", keywords: "us visa 2x2 inches 600x600 240kb ds160 dv lottery" },
      { name: "Passport Photo Size 50KB", url: "/convert-photo-to-passport-size-50kb/", category: "Passports", badge: "Universal ID", keywords: "passport photo 50kb online form" },
      { name: "PAN Card Photo Resizer", url: "/pan-card-photo-resize-in-kb/", category: "Passports", badge: "Tax Portal", keywords: "pan card photo nsdl uti" },
      { name: "PAN Card Signature Resize", url: "/pan-card-signature-resize-in-kb/", category: "Passports", badge: "Signature", keywords: "pan card signature resize" },
      { name: "HEIC to JPG Under 50KB", url: "/convert-heic-to-jpg-50kb/", category: "Formats", badge: "Apple iOS", keywords: "heic to jpg 50kb iphone photo" },
      { name: "KB to MB Calculator", url: "/kb-to-mb/", category: "Calculators", badge: "Data Unit", keywords: "kb to mb converter calculator 1024" },
      { name: "1024 KB to MB Calculator", url: "/1024-kb-to-mb/", category: "Calculators", badge: "Binary 1MB", keywords: "1024 kb to mb binary megabyte" }
    ];

    // 2. Interactive Live Search with Exact Deep Links
    const liveSearchInput = document.getElementById('liveSearchInput');
    const searchResultsDropdown = document.getElementById('searchResultsDropdown');
    const searchResultsList = document.getElementById('searchResultsList');
    const hubCards = document.querySelectorAll('#hubGrid .hub-card');

    if (liveSearchInput) {
      liveSearchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();

        // A. Filter Deep-Link Results in Dropdown
        if (!query) {
          searchResultsDropdown.style.display = 'none';
          searchResultsList.innerHTML = '';
        } else {
          const matchedTools = toolsRegistry.filter(tool => 
            tool.name.toLowerCase().includes(query) || 
            tool.keywords.toLowerCase().includes(query) ||
            tool.badge.toLowerCase().includes(query)
          ).slice(0, 6);

          if (matchedTools.length > 0) {
            searchResultsList.innerHTML = matchedTools.map(tool => `
              <a href="${tool.url}" class="search-result-item" role="option">
                <span class="result-name">
                  ${tool.name}
                  <span class="result-category">${tool.category}</span>
                </span>
                <span class="result-badge">${tool.badge}</span>
              </a>
            `).join('');
            searchResultsDropdown.style.display = 'block';
          } else {
            const noResults = document.createElement('div');
            noResults.className = 'no-results-msg';
            noResults.textContent = `No matching tools found for “${query}”. Try a size such as 20KB or 50KB.`;
            searchResultsList.replaceChildren(noResults);
            searchResultsDropdown.style.display = 'block';
          }
        }

        // B. Filter Master Directory Cards Below
        hubCards.forEach((card) => {
          const keywords = card.getAttribute('data-keywords') || '';
          const cardText = card.textContent.toLowerCase();
          if (!query || keywords.includes(query) || cardText.includes(query)) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });

      // Close Search Results on Click Outside
      document.addEventListener('click', (event) => {
        if (!event.target.closest('.search-container')) {
          searchResultsDropdown.style.display = 'none';
        }
      });
    }

    // 3. Category Filter Segment Bar
    const filterButtons = document.querySelectorAll('#categoryFilterBar .filter-pill-btn');
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const selectedCategory = btn.getAttribute('data-category');

        hubCards.forEach(card => {
          const cardCategory = card.getAttribute('data-category');
          if (selectedCategory === 'all' || cardCategory === selectedCategory) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // 4. Desktop Synchronized Click Dropdowns (Close siblings on open)
    const menuDetails = document.querySelectorAll('.nav-menu-item');
    menuDetails.forEach((targetDetail) => {
      targetDetail.addEventListener('toggle', () => {
        if (targetDetail.open) {
          menuDetails.forEach((detail) => {
            if (detail !== targetDetail) {
              detail.removeAttribute('open');
            }
          });
        }
      });
    });

    document.addEventListener('click', (event) => {
      if (!event.target.closest('.site-header')) {
        menuDetails.forEach((detail) => detail.removeAttribute('open'));
      }
    });

    // 5. Mobile Drawer Handlers (Streamlined Curated Drawer)
    const drawerOpenBtn = document.getElementById('mobileDrawerOpenBtn');
    const drawerCloseBtn = document.getElementById('mobileDrawerCloseBtn');
    const drawerOverlay = document.getElementById('mobileDrawerOverlay');
    const mobileDrawer = document.getElementById('mobileDrawer');

    function openMobileDrawer() {
      mobileDrawer.classList.add('open');
      drawerOverlay.style.display = 'block';
      document.body.style.overflow = 'hidden';
      mobileDrawer.setAttribute('aria-hidden', 'false');
    }

    function closeMobileDrawer() {
      mobileDrawer.classList.remove('open');
      drawerOverlay.style.display = 'none';
      document.body.style.overflow = '';
      mobileDrawer.setAttribute('aria-hidden', 'true');
    }

    if (drawerOpenBtn && drawerCloseBtn && drawerOverlay) {
      drawerOpenBtn.addEventListener('click', openMobileDrawer);
      drawerCloseBtn.addEventListener('click', closeMobileDrawer);
      drawerOverlay.addEventListener('click', closeMobileDrawer);
    }
  </script>

</body>
