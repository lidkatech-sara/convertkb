          </button>

          <!-- Collapsible Sub-menu Links -->
          <div 
            id={`drawer-sub-${cat.id}`}
            class={`accordion-content flex flex-col gap-1.5 mt-2 ${idx === 0 ? "expanded" : "collapsed"}`}
          >
            {cat.items.map((tool) => (
              <a
