---
// src/pages/index.astro
const pageTitle = "ConvertKB - Free Online Image & PDF Compressor to Exact KB (10KB, 20KB, 50KB, 100KB)";
const pageDescription = "Fast, client-side online tool to compress images, photos, signatures, and PDFs to exact KB sizes (20KB, 50KB, 100KB, 200KB) and 200/300 DPI. Worldwide portal presets for Passports, US Visas, Schengen, Social Platforms, SSC, UPSC, and Job Applications with zero server uploads.";
const canonicalURL = "https://convertkb.com/";

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://convertkb.com/#website",
      "url": "https://convertkb.com/",
      "name": "ConvertKB",
      "description": pageDescription,
      "inLanguage": "en-US"
    },
    {
      "@type": "WebApplication",
      "@id": "https://convertkb.com/#webapp",
      "url": "https://convertkb.com/",
      "name": "ConvertKB Precision Image & Document Compressor",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Runs client-side on all modern web browsers.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://convertkb.com/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does ConvertKB compress images to an exact target KB without quality loss?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ConvertKB uses client-side HTML5 Canvas and native WebAssembly binary search algorithms. Rather than applying a single arbitrary compression level, our engine runs a sub-second iterative search directly in your browser memory. It adjusts discrete cosine transform (DCT) coefficients, strips redundant metadata tags, and optimizes color lookup tables until your file precisely hits the required target (such as 20KB, 50KB, or 100KB) with minimal optical distortion."
          }
        },
        {
          "@type": "Question",
          "name": "Are my uploaded photos, ID cards, marksheet scans, or signatures stored on your servers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Never. All image compression, DPI configuration, format conversion, and PDF optimization happen entirely on your local device memory using client-side JavaScript and HTML5 Canvas APIs. Zero byte payloads or metadata details are transmitted over the internet to any external server or third-party storage bucket."
          }
        },
        {
          "@type": "Question",
          "name": "How do international passport, visa, and consular portals enforce file limits?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Consular portals such as the US Department of State CEAC, Schengen VFS Global, UK Visas and Immigration (UKVI), and Canada IRCC enforce strict intake gates. Most require JPEG format, maximum file caps like 240KB, square aspect ratios (e.g., 2x2 inches or 600x600 pixels), and 300 DPI print fidelity. ConvertKB calibrates both binary file weights and DPI metadata tags to ensure first-time acceptance."
          }
        },
        {
          "@type": "Question",
          "name": "Why do social media and messaging apps compress my images into blurry files?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Platforms like WhatsApp, Discord, Instagram, and LinkedIn aggressively downscale uploads larger than their standard byte limits. Pre-compressing images to exact platform targets (e.g., Discord 256KB emoji or under 8MB image limits, WhatsApp status under 16MB, YouTube thumbnail under 2MB) preserves sharpness and prevents aggressive platform re-compression."
          }
        },
        {
          "@type": "Question",
          "name": "How can I convert an iPhone HEIC photo to JPG below 50KB?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Modern iPhones capture images in Apple's High Efficiency Image Container (HEIC) format by default, which recruitment portals cannot read. Using our HEIC to JPG under 50KB tool, your browser unpacks the HEIC container locally, converts the color matrices into a standard JPEG color space, and resizes the file below 50KB within seconds."
          }
        },
        {
          "@type": "Question",
          "name": "How do I resize a signature to 10KB-20KB with 140x60 pixels?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Select our specialized 140x60 Pixel Signature Resizer. The tool sets your canvas to the exact 140 x 60 pixel aspect ratio, adjusts contrast to keep ink strokes sharp against a pure white background, and compresses the final file to fit between 10KB and 20KB for banking (IBPS/SBI) and government forms."
          }
        }
      ]
    }
  ]
};

const schemaJson = JSON.stringify(schemaData);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonicalURL} />
  
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#ffffff" />

  <script type="application/ld+json" set:html={schemaJson}></script>

  <style>
    :root {
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --primary-light: #eff6ff;
      --primary-glow: rgba(37, 99, 235, 0.16);
      --accent: #0ea5e9;
      --accent-light: #f0f9ff;
      --text-main: #0f172a;
      --text-muted: #475569;
      --text-light: #64748b;
      --bg-body: #fafafa;
      --bg-card: #ffffff;
      --border: #e2e8f0;
      --border-focus: #bfdbfe;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --shadow-sm: 0 1px 3px 0 rgba(0, 0, 0, 0.04);
      --shadow-md: 0 4px 14px -2px rgba(15, 23, 42, 0.06), 0 2px 4px -2px rgba(15, 23, 42, 0.03);
      --shadow-lg: 0 20px 35px -8px rgba(15, 23, 42, 0.1), 0 8px 16px -6px rgba(15, 23, 42, 0.04);
      --shadow-dropdown: 0 16px 36px -4px rgba(15, 23, 42, 0.14), 0 4px 12px -2px rgba(15, 23, 42, 0.06);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background-color: var(--bg-body);
      color: var(--text-main);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    .container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* ==================== HEADER ==================== */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(226, 232, 240, 0.85);
      transition: all 0.25s ease;
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 72px;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 1.45rem;
      font-weight: 800;
      text-decoration: none;
      color: var(--text-main);
      letter-spacing: -0.03em;
    }

    .logo-badge {
      width: 36px;
      height: 36px;
      background: linear-gradient(135deg, var(--primary), var(--accent));
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
      font-size: 0.95rem;
      font-weight: 900;
      box-shadow: 0 4px 12px var(--primary-glow);
    }

    .brand-badge {
      color: var(--primary);
      font-weight: 700;
    }

    /* Desktop Navigation */
    .nav-root {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .nav-menu-item {
      position: relative;
    }

    .nav-summary {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 9px 15px;
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--text-muted);
      cursor: pointer;
      list-style: none;
      border-radius: var(--radius-sm);
      transition: all 0.15s ease;
      user-select: none;
    }

    .nav-summary::-webkit-details-marker {
      display: none;
    }

    .nav-summary:hover,
    .nav-menu-item[open] > .nav-summary {
      color: var(--primary);
      background: var(--primary-light);
    }

    .arrow-icon {
      font-size: 0.72rem;
      transition: transform 0.2s ease;
      opacity: 0.7;
    }

    .nav-menu-item[open] .arrow-icon {
      transform: rotate(180deg);
      opacity: 1;
    }

    .megamenu-panel {
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-dropdown);
      padding: 24px;
      gap: 28px;
      z-index: 1050;
      animation: menuFadeIn 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes menuFadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .megamenu-panel.cols-2 {
      min-width: 500px;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }

    .megamenu-panel.cols-3 {
      min-width: 740px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
    }

    .nav-menu-item:last-child .megamenu-panel,
    .nav-menu-item:nth-last-child(2) .megamenu-panel {
      left: auto;
      right: 0;
    }

    .megamenu-col h4 {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--text-light);
      margin-bottom: 12px;
      padding-bottom: 6px;
      border-bottom: 1px solid var(--border);
    }

    .megamenu-col ul {
      list-style: none;
    }

    .megamenu-col li {
      margin-bottom: 4px;
    }

    .megamenu-col a {
      display: block;
      font-size: 0.885rem;
      color: var(--text-muted);
      text-decoration: none;
      padding: 5px 8px;
      border-radius: 6px;
      transition: all 0.15s ease;
    }

    .megamenu-col a:hover {
      color: var(--primary);
      background: var(--primary-light);
      transform: translateX(2px);
    }

    .megamenu-col .hub-pill {
      display: inline-block;
      margin-top: 10px;
      font-weight: 600;
      color: var(--primary);
      font-size: 0.85rem;
    }

    /* Mobile Hamburger Trigger */
    .mobile-hamburger {
      display: none;
      background: #f1f5f9;
      border: 1px solid var(--border);
      border-radius: 10px;
      cursor: pointer;
      width: 42px;
      height: 42px;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 5px;
      transition: background 0.15s ease;
    }

    .mobile-hamburger span {
      display: block;
      width: 20px;
      height: 2px;
      background: var(--text-main);
      border-radius: 2px;
    }

    /* Mobile Drawer */
    .mobile-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.5);
      backdrop-filter: blur(4px);
      z-index: 1999;
    }

    .mobile-drawer {
      position: fixed;
      top: 0;
      right: -100%;
      width: 86%;
      max-width: 380px;
      height: 100vh;
      height: 100dvh;
      background: #ffffff;
      z-index: 2000;
      box-shadow: -10px 0 30px rgba(0, 0, 0, 0.15);
      transition: right 0.28s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      flex-direction: column;
    }

    .mobile-drawer.open {
      right: 0;
    }

    .mobile-drawer-header {
      padding: 18px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
    }

    .mobile-close-btn {
      background: #f1f5f9;
      border: none;
      width: 34px;
      height: 34px;
      border-radius: 8px;
      font-size: 1.3rem;
      color: var(--text-muted);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .mobile-drawer-body {
      padding: 16px 18px 30px;
      overflow-y: auto;
      flex: 1;
    }

    .mobile-accordion {
      border-bottom: 1px solid var(--border);
      padding: 6px 0;
    }

    .mobile-summary {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text-main);
      cursor: pointer;
      list-style: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 4px;
    }

    .mobile-summary::-webkit-details-marker {
      display: none;
    }

    .mobile-accordion[open] .mobile-summary {
      color: var(--primary);
    }

    .mobile-accordion[open] .mobile-summary .arrow-icon {
      transform: rotate(180deg);
    }

    .mobile-sub-group {
      padding: 6px 4px 12px;
    }

    .mobile-sub-group ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .mobile-sub-group a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 10px;
      border-radius: 8px;
      font-size: 0.885rem;
      font-weight: 600;
      color: var(--text-muted);
      text-decoration: none;
      background: var(--bg-body);
      border: 1px solid var(--border);
    }

    .mobile-sub-group a:hover,
    .mobile-sub-group a:active {
      background: var(--primary-light);
      border-color: var(--border-focus);
      color: var(--primary);
    }

    .mobile-tag {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--primary);
      background: #dbeafe;
      padding: 2px 8px;
      border-radius: 9999px;
    }

    .mobile-drawer-footer {
      padding: 14px 18px;
      border-top: 1px solid var(--border);
      background: #f8fafc;
      font-size: 0.8rem;
      color: var(--text-light);
      text-align: center;
    }

    /* ==================== HERO & SEARCH ==================== */
    .hero {
      text-align: center;
      padding: 68px 0 46px;
      background: radial-gradient(circle at 50% 5%, #eff6ff 0%, #fafafa 80%);
      border-bottom: 1px solid var(--border);
    }

    .hero-title {
      font-size: 3.25rem;
      font-weight: 800;
      color: var(--text-main);
      line-height: 1.15;
      letter-spacing: -0.035em;
      margin-bottom: 18px;
    }

    .hero-title span {
      background: linear-gradient(135deg, var(--primary), var(--accent));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-subtitle {
      font-size: 1.2rem;
      color: var(--text-muted);
      max-width: 780px;
      margin: 0 auto 30px;
      font-weight: 400;
    }

    .hero-stats {
      display: flex;
      justify-content: center;
      gap: 14px;
      flex-wrap: wrap;
      margin-bottom: 32px;
    }

    .stat-badge {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.885rem;
      font-weight: 600;
      color: var(--text-muted);
      background: #ffffff;
      padding: 6px 16px;
      border-radius: 9999px;
      border: 1px solid var(--border);
      box-shadow: var(--shadow-sm);
    }

    /* Search Box */
    .search-container {
      max-width: 580px;
      margin: 0 auto;
      position: relative;
    }

    .search-input-wrapper {
      position: relative;
    }

    .search-input {
      width: 100%;
      padding: 15px 22px 15px 48px;
      font-size: 1rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      background: #ffffff;
      color: var(--text-main);
      box-shadow: var(--shadow-md);
      outline: none;
      transition: all 0.2s ease;
    }

    .search-input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 4px var(--primary-glow);
    }

    .search-icon {
      position: absolute;
      left: 18px;
      top: 50%;
      transform: translateY(-50%);
      color: #94a3b8;
      font-size: 1.1rem;
    }

    .search-results-dropdown {
      display: none;
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      right: 0;
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-dropdown);
      max-height: 380px;
      overflow-y: auto;
      z-index: 1100;
      text-align: left;
    }

    .search-results-header {
      padding: 10px 16px;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-light);
      background: #f8fafc;
      border-bottom: 1px solid var(--border);
    }

    .search-result-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      text-decoration: none;
      color: var(--text-main);
      border-bottom: 1px solid #f1f5f9;
      transition: background 0.15s ease;
    }

    .search-result-item:last-child {
      border-bottom: none;
    }

    .search-result-item:hover {
      background: var(--primary-light);
    }

    .result-name {
      font-size: 0.925rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .result-category {
      font-size: 0.75rem;
      color: var(--text-light);
      background: #f1f5f9;
      padding: 2px 8px;
      border-radius: 4px;
    }

    .result-badge {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--primary);
      background: #dbeafe;
      padding: 2px 8px;
      border-radius: 9999px;
    }

    .no-results-msg {
      padding: 20px;
      text-align: center;
      color: var(--text-light);
      font-size: 0.9rem;
    }

    /* ==================== DIRECTORY HUB ==================== */
    .hub-section {
      padding: 68px 0 84px;
    }

    .section-intro {
      text-align: center;
      max-width: 720px;
      margin: 0 auto 48px;
    }

    .section-intro h2 {
      font-size: 2.15rem;
      font-weight: 800;
      color: var(--text-main);
      letter-spacing: -0.025em;
      margin-bottom: 10px;
    }

    .section-intro p {
      color: var(--text-muted);
      font-size: 1.05rem;
    }

    .hub-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
      gap: 28px;
    }

    .hub-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 26px;
      box-shadow: var(--shadow-sm);
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
      display: flex;
      flex-direction: column;
    }

    .hub-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
      border-color: var(--border-focus);
    }

    .hub-card-header {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 12px;
    }

    .hub-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: var(--primary-light);
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 0.95rem;
    }

    .hub-card-header h3 {
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--text-main);
    }

    .hub-card-desc {
      font-size: 0.925rem;
      color: var(--text-muted);
      margin-bottom: 20px;
      line-height: 1.5;
    }

    .hub-subgroup {
      margin-bottom: 16px;
    }

    .hub-subgroup-title {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-light);
      margin-bottom: 8px;
      display: flex;
      justify-content: space-between;
      border-bottom: 1px dashed var(--border);
      padding-bottom: 4px;
    }

    .hub-links-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .hub-links-list a {
      font-size: 0.885rem;
      color: var(--text-muted);
      text-decoration: none;
      padding: 6px 10px;
      border-radius: 6px;
      transition: all 0.15s ease;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .hub-links-list a:hover {
      color: var(--primary);
      background: var(--primary-light);
    }

    .tag-badge {
      font-size: 0.72rem;
      font-weight: 600;
      color: #64748b;
      background: #f1f5f9;
      padding: 2px 8px;
      border-radius: 9999px;
      transition: all 0.15s ease;
    }

    .hub-links-list a:hover .tag-badge {
      color: var(--primary);
      background: #dbeafe;
    }

    .hub-card-action {
      margin-top: auto;
      padding-top: 16px;
      border-top: 1px solid var(--border);
    }

    .hub-card-action a {
      font-size: 0.885rem;
      font-weight: 600;
      color: var(--primary);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .hub-card-action a:hover {
      text-decoration: underline;
    }

    /* ==================== EDITORIAL SEO CONTENT ==================== */
    .content-section {
      background: #ffffff;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 88px 0;
    }

    .content-wrapper {
      max-width: 880px;
      margin: 0 auto;
    }

    .content-wrapper h2 {
      font-size: 2.15rem;
      font-weight: 800;
      color: var(--text-main);
      margin: 48px 0 18px;
      letter-spacing: -0.025em;
      line-height: 1.25;
    }

    .content-wrapper h2:first-of-type {
      margin-top: 0;
    }

    .content-wrapper h3 {
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--text-main);
      margin: 30px 0 14px;
      letter-spacing: -0.015em;
    }

    .content-wrapper p {
      color: var(--text-muted);
      font-size: 1.05rem;
      line-height: 1.8;
      margin-bottom: 22px;
    }

    .content-wrapper ul, .content-wrapper ol {
      margin: 0 0 26px 24px;
      color: var(--text-muted);
    }

    .content-wrapper li {
      font-size: 1.025rem;
      line-height: 1.7;
      margin-bottom: 12px;
    }

    .pipeline-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      margin: 32px 0 40px;
    }

    .pipeline-step {
      background: var(--bg-body);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 20px;
      position: relative;
    }

    .step-number {
      font-size: 1.8rem;
      font-weight: 800;
      color: var(--primary);
      opacity: 0.3;
      margin-bottom: 8px;
    }

    .pipeline-step h4 {
      font-size: 0.95rem;
      font-weight: 700;
      margin-bottom: 6px;
      color: var(--text-main);
    }

    .pipeline-step p {
      font-size: 0.85rem;
      line-height: 1.5;
      color: var(--text-muted);
      margin-bottom: 0;
    }

    .info-callout {
      background: var(--primary-light);
      border-left: 4px solid var(--primary);
      padding: 22px 26px;
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
      margin: 32px 0;
    }

    .info-callout h4 {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--primary);
      margin-bottom: 6px;
    }

    .info-callout p {
      margin-bottom: 0;
      font-size: 0.95rem;
      color: #1e3a8a;
    }

    .table-responsive {
      overflow-x: auto;
      margin: 34px 0;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      -webkit-overflow-scrolling: touch;
    }

    .specs-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.95rem;
      min-width: 580px;
    }

    .specs-table th {
      background: #f8fafc;
      color: var(--text-main);
      font-weight: 700;
      padding: 13px 18px;
      border-bottom: 1px solid var(--border);
    }

    .specs-table td {
      padding: 13px 18px;
      border-bottom: 1px solid var(--border);
      color: var(--text-muted);
    }

    .specs-table tr:last-child td {
      border-bottom: none;
    }

    /* FAQ BLOCK */
    .faq-block {
      margin-top: 60px;
    }

    .faq-item {
      background: var(--bg-body);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 24px;
      margin-bottom: 18px;
    }

    .faq-question {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 10px;
    }

    .faq-answer {
      font-size: 1rem;
      color: var(--text-muted);
      line-height: 1.7;
      margin: 0;
    }

    /* ==================== TWO-BLOCK FOOTER ==================== */
    .site-footer {
      background: #0f172a;
      color: #94a3b8;
      padding: 68px 0 36px;
      font-size: 0.9rem;
    }

    .footer-two-blocks {
      display: grid;
      grid-template-columns: 1.3fr 1fr;
      gap: 56px;
      margin-bottom: 44px;
    }

    .footer-brand h3 {
      color: #ffffff;
      font-size: 1.4rem;
      margin-bottom: 14px;
      font-weight: 800;
    }

    .footer-brand p {
      line-height: 1.7;
      margin-bottom: 16px;
      color: #94a3b8;
    }

    .footer-links-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .footer-links-grid h4 {
      color: #ffffff;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 16px;
      font-weight: 700;
    }

    .footer-links-grid ul {
      list-style: none;
    }

    .footer-links-grid li {
      margin-bottom: 9px;
    }

    .footer-links-grid a {
      color: #94a3b8;
      text-decoration: none;
      transition: color 0.15s ease;
    }

    .footer-links-grid a:hover {
      color: #ffffff;
    }

    .footer-bottom {
      border-top: 1px solid #1e293b;
      padding-top: 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 20px;
    }

    .legal-nav {
      display: flex;
      gap: 24px;
    }

    .legal-nav a {
      color: #94a3b8;
      text-decoration: none;
      transition: color 0.15s ease;
    }

    .legal-nav a:hover {
      color: #ffffff;
    }

    /* ==================== RESPONSIVE ==================== */
