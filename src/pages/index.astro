// src/pages/index.astro
const title = "CONVERTkb - Free Online Image & PDF Compressor to Exact KB";
const description = "Compress images, photos, and PDFs to exact file sizes (20KB, 50KB, 100KB) and DPI requirements directly in your browser. Fast, free, and completely private with zero server uploads.";
const canonicalURL = "https://convertkb.com/";

// Schema.org structured data for WebSite and FAQ
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://convertkb.com/#website",
      "url": "https://convertkb.com/",
      "name": "CONVERTkb",
      "description": description,
      "inLanguage": "en-US"
    },
    {
      "@type": "FAQPage",
      "@id": "https://convertkb.com/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does CONVERTkb compress images to an exact target KB?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "CONVERTkb uses client-side canvas binary search algorithms directly in your browser. It adjusts quality matrices and dimensional limits iteratively until the file matches your exact target file size (such as 20KB or 50KB) without transmitting raw images across external servers."
          }
        },
        {
          "@type": "Question",
          "name": "Are my uploaded photos, ID cards, and documents stored on your servers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. All image compression, DPI configuration, and PDF optimization happen on your local device memory using WebAssembly and HTML5 Canvas. Your files never leave your computer or phone."
          }
        },
        {
          "@type": "Question",
          "name": "Why do government recruitment portals reject photos even when the KB size is correct?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most portals enforce both file size limits (e.g., 20KB-50KB) and strict metadata constraints such as 200/300 DPI or fixed pixel dimensions (like 3.5 x 4.5 cm). CONVERTkb embeds proper JFIF/EXIF headers to ensure portal validation systems accept your files."
          }
        }
      ]
    }
  ]
};
