    <!-- Scrollable Sub-Menu Accordion Body -->
    <nav class="flex-1 overflow-y-auto px-4 py-4 divide-y divide-slate-100 space-y-4">
      {toolCategories.map((cat, idx) => (
        <div class="pt-3 first:pt-0">
          <!-- Accordion Toggle Button -->
