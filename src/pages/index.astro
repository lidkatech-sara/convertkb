---
// Page Metadata & Configuration
const title = "ConvertKB - Compress Images & PDFs to Exact KB";
const description = "Calibrate photos, certificates, marksheet scans, and signatures to exact file boundaries (20KB, 50KB, 100KB) directly inside your web browser.";

const menuCategories = [
  {
    id: "popular",
    name: "Popular Sizes",
    defaultOpen: true,
    items: [
      { label: "Compress to 20KB", badge: "Exact", badgeColor: "bg-blue-50 text-blue-600", href: "/compress-to-20kb" },
      { label: "Compress to 50KB", badge: "Exact", badgeColor: "bg-blue-50 text-blue-600", href: "/compress-to-50kb" },
      { label: "Compress to 100KB", badge: "Max", badgeColor: "bg-blue-50 text-blue-600", href: "/compress-to-100kb" },
      { label: "PDF to 100KB", badge: "PDF", badgeColor: "bg-red-50 text-red-600", href: "/pdf-to-100kb" },
    ]
  },
  {
    id: "identity",
    name: "Identity & Visas",
    defaultOpen: true,
    items: [
      { label: "Passport Photo 50KB", badge: "3.5x4.5", badgeColor: "bg-purple-50 text-purple-600", href: "/passport-photo-50kb" },
      { label: "US Visa 2x2\" (240KB)", badge: "DS-160", badgeColor: "bg-indigo-50 text-indigo-600", href: "/us-visa-photo" },
      { label: "Change to 200 DPI", badge: "Print", badgeColor: "bg-emerald-50 text-emerald-600", href: "/change-to-200-dpi" },
      { label: "Convert to 300 DPI", badge: "HD", badgeColor: "bg-emerald-50 text-emerald-600", href: "/convert-to-300-dpi" },
    ]
  },
  {
    id: "exams",
    name: "Exams & Signatures",
    defaultOpen: false,
    items: [
      { label: "SSC Photo & Sign", badge: "SSC CGL", badgeColor: "bg-amber-50 text-amber-700", href: "/ssc-photo-signature" },
      { label: "UPSC Document Calibrator", badge: "UPSC", badgeColor: "bg-amber-50 text-amber-700", href: "/upsc-resizer" },
      { label: "Signature Compress 10KB - 20KB", badge: "Sign", badgeColor: "bg-sky-50 text-sky-700", href: "/signature-compress" },
    ]
  }
];
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
  <style>
    /* Prevent accidental horizontal page shifting */
    html, body {
      overflow-x: hidden;
      width: 100%;
    }
  </style>
</head>

<body class="bg-slate-50 text-slate-900 antialiased font-sans selection:bg-blue-600 selection:text-white min-h-screen flex flex-col">

  <!-- ==================== TOP NAVIGATION ==================== -->
  <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 text-xl font-extrabold tracking-tight text-slate-900">
        <span class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center font-black text-sm shadow-sm">
          KB
        </span>
        <span>Convert<span class="text-blue-600">KB</span></span>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600">
        <a href="#tools" class="hover:text-blue-600 transition">Tools</a>
        <a href="#format-encoders" class="hover:text-blue-600 transition">Format Encoders</a>
        <a href="#platforms" class="hover:text-blue-600 transition">Platforms</a>
        <a href="#exam-presets" class="hover:text-blue-600 transition">Exam Presets</a>
      </nav>

      <!-- Desktop CTA & Hamburger Button -->
      <div class="flex items-center gap-3">
        <a href="#compressor" class="hidden sm:inline-flex items-center px-4 py-2 text-sm font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm transition">
          Quick Compress
        </a>

        <!-- Hamburger Toggle Button -->
        <button
          id="menu-open-btn"
          type="button"
          aria-label="Open mobile navigation menu"
          aria-expanded="false"
          aria-controls="mobile-drawer"
          class="p-2 text-slate-700 hover:text-slate-900 hover:bg-slate-100 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-600 transition"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- ==================== MOBILE MENU OVERLAY & DRAWER ==================== -->
  
  <!-- Backdrop (Dim Background) -->
  <div 
    id="menu-backdrop" 
    class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out"
    aria-hidden="true"
  ></div>

  <!-- Slide-out Drawer -->
  <aside 
    id="mobile-drawer"
    class="fixed top-0 right-0 bottom-0 z-50 w-full max-w-xs sm:max-w-sm bg-white shadow-2xl flex flex-col translate-x-full transition-transform duration-300 ease-out"
    aria-modal="true"
    role="dialog"
    aria-label="Navigation Menu"
  >
    <!-- Drawer Header -->
    <div class="h-16 px-5 border-b border-slate-200 flex items-center justify-between bg-slate-50/60">
      <div class="flex items-center gap-2">
        <span class="w-7 h-7 rounded-md bg-blue-600 text-white flex items-center justify-center font-bold text-xs shadow-xs">
          KB
        </span>
        <span class="font-bold text-slate-900 tracking-tight">Convert<span class="text-blue-600">KB</span></span>
      </div>
      
      <!-- Close Button -->
      <button 
        id="menu-close-btn"
        type="button"
        aria-label="Close menu"
        class="p-2 text-slate-500 hover:text-slate-800 hover:bg-slate-200/60 rounded-lg transition"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Scrollable Drawer Body (Sub-menu Accordions) -->
    <div class="flex-1 overflow-y-auto px-4 py-4 divide-y divide-slate-100 space-y-4">
      {menuCategories.map((cat) => (
        <div class="pt-3 first:pt-0 group">
          <!-- Accordion Header Button -->
          <button
            type="button"
            class="submenu-toggle w-full flex items-center justify-between py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 hover:text-blue-600 transition"
            aria-expanded={cat.defaultOpen ? "true" : "false"}
            data-target={`submenu-${cat.id}`}
          >
            <span>{cat.name}</span>
            <svg 
              class={`w-4 h-4 transition-transform duration-200 text-slate-400 ${cat.defaultOpen ? "rotate-180" : ""}`}
              fill="none" 
              stroke="currentColor" 
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Collapsible Sub-menu List -->
          <div 
            id={`submenu-${cat.id}`} 
            class={`submenu-content flex flex-col gap-1 mt-1 transition-all duration-200 overflow-hidden ${cat.defaultOpen ? "" : "hidden"}`}
          >
            {cat.items.map((item) => (
              <a 
                href={item.href}
                class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium text-slate-700 hover:bg-blue-50 hover:text-blue-700 transition"
              >
                <span>{item.label}</span>
                <span class={`text-[11px] font-semibold px-2 py-0.5 rounded-md border border-slate-200/50 ${item.badgeColor}`}>
                  {item.badge}
                </span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Drawer Footer Note -->
    <div class="p-4 border-t border-slate-100 bg-slate-50 text-center">
      <p class="text-xs text-slate-500 font-medium">
        🔒 100% Client-Side. No server uploads.
      </p>
    </div>
  </aside>

  <!-- ==================== MAIN HERO CONTENT ==================== -->
  <main class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 py-12 md:py-16 text-center">
    
    <!-- Verified Badge -->
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-blue-50 text-blue-700 border border-blue-200/60 mb-6">
      <span class="w-1.5 h-1.5 rounded-full bg-blue-600 animate-pulse"></span>
      Verified Client-Side Engine
    </div>

    <!-- Hero Title -->
    <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight mb-4">
      Compress Images & PDFs to <span class="text-blue-600">Exact KB</span>
    </h1>

    <!-- Subtitle -->
    <p class="text-slate-600 text-sm sm:text-base max-w-2xl mx-auto mb-8 leading-relaxed">
      Calibrate photos, certificates, marksheet scans, and signatures to exact file boundaries (20KB, 50KB, 100KB) and required 200/300 DPI specifications directly inside your web browser.
    </p>

    <!-- Key Guarantee Badges -->
    <div class="flex flex-wrap items-center justify-center gap-2.5 text-xs font-medium text-slate-700 mb-8">
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-white border border-slate-200 shadow-2xs">
        <svg class="w-3.5 h-3.5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
        In-Browser Privacy
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-white border border-slate-200 shadow-2xs">
        <svg class="w-3.5 h-3.5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
        Zero Network Delay
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-white border border-slate-200 shadow-2xs">
        <svg class="w-3.5 h-3.5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
        Strict DPI Precision
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-white border border-slate-200 shadow-2xs">
        <svg class="w-3.5 h-3.5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
        Free Forever
      </span>
    </div>

    <!-- Search Bar -->
    <div class="max-w-lg mx-auto relative mb-12">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input
        type="search"
        placeholder="Search tools: 20kb, youtube 2mb, discord..."
        class="w-full pl-10 pr-4 py-3 bg-white border border-slate-200 rounded-xl shadow-xs text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition"
      />
    </div>

    <!-- Application Sizing & Document Section -->
    <section class="text-left mt-16 pt-12 border-t border-slate-200">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">
          Application Sizing & Document Tools
        </h2>
        <p class="text-sm text-slate-500 mt-1">
          Every tool, preset, and format converter organized in a unified, crawlable index.
        </p>
      </div>

      <!-- Card Component -->
      <div class="max-w-md mx-auto bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
        <div class="flex items-center gap-3 mb-3">
          <span class="px-2 py-1 text-xs font-bold bg-blue-100 text-blue-700 rounded">IMG</span>
          <h3 class="text-lg font-bold text-slate-900">Image Compress</h3>
        </div>
        <p class="text-xs text-slate-500 mb-5 leading-relaxed">
          Targeted compression algorithms calibrated for identity cards, profile pictures, and online admissions.
        </p>

        <div class="border-t border-slate-100 pt-3 space-y-2">
          <div class="flex justify-between items-center text-xs font-semibold text-slate-400 uppercase tracking-wider pb-1">
            <span>Target KB Sizes</span>
            <span>Precision</span>
          </div>
          <div class="flex justify-between items-center text-sm py-1.5 border-b border-slate-50">
            <span class="text-slate-700">Compress Image to 50KB</span>
            <span class="text-xs font-semibold px-2 py-0.5 rounded bg-blue-50 text-blue-600 border border-blue-100">Exact 50KB</span>
          </div>
          <div class="flex justify-between items-center text-sm py-1.5 border-b border-slate-50">
            <span class="text-slate-700">Compress Image to 20KB</span>
            <span class="text-xs font-semibold px-2 py-0.5 rounded bg-blue-50 text-blue-600 border border-blue-100">Exact 20KB</span>
          </div>
          <div class="flex justify-between items-center text-sm py-1.5 border-b border-slate-50">
            <span class="text-slate-700">Compress Image to 100KB</span>
            <span class="text-xs font-semibold px-2 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-100">Under 100KB</span>
          </div>
          <div class="flex justify-between items-center text-sm py-1.5">
            <span class="text-slate-700">Compress Image to 200KB</span>
            <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-600">Web Standard</span>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- ==================== CLIENT JAVASCRIPT ==================== -->
  <script is:inline>
    (function initMenu() {
      const openBtn = document.getElementById('menu-open-btn');
      const closeBtn = document.getElementById('menu-close-btn');
      const backdrop = document.getElementById('menu-backdrop');
      const drawer = document.getElementById('mobile-drawer');
      const submenuToggles = document.querySelectorAll('.submenu-toggle');

      function openDrawer() {
        drawer.classList.remove('translate-x-full');
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        backdrop.classList.add('opacity-100', 'pointer-events-auto');
        document.body.style.overflow = 'hidden';
        openBtn.setAttribute('aria-expanded', 'true');
      }

      function closeDrawer() {
        drawer.classList.add('translate-x-full');
        backdrop.classList.remove('opacity-100', 'pointer-events-auto');
        backdrop.classList.add('opacity-0', 'pointer-events-none');
        document.body.style.overflow = '';
        openBtn.setAttribute('aria-expanded', 'false');
      }

      // Event Listeners for Open / Close
      if (openBtn) openBtn.addEventListener('click', openDrawer);
      if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
      if (backdrop) backdrop.addEventListener('click', closeDrawer);

      // Close on ESC key
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !drawer.classList.contains('translate-x-full')) {
          closeDrawer();
        }
      });

      // Sub-menu Accordion Toggle Handler
      submenuToggles.forEach((button) => {
        button.addEventListener('click', () => {
          const targetId = button.getAttribute('data-target');
          const content = document.getElementById(targetId);
          const icon = button.querySelector('svg');
          const isExpanded = button.getAttribute('aria-expanded') === 'true';

          if (isExpanded) {
            content.classList.add('hidden');
            button.setAttribute('aria-expanded', 'false');
            if (icon) icon.classList.remove('rotate-180');
          } else {
            content.classList.remove('hidden');
            button.setAttribute('aria-expanded', 'true');
            if (icon) icon.classList.add('rotate-180');
          }
        });
      });
    })();
  </script>

</body>
</html>
