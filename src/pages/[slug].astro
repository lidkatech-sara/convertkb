// src/pages/[slug].astro
import Navigation from '../components/navigation.astro';

// --- DATA LAYER (Self-contained to prevent missing module build failures) ---
const slugsList = [
  // Image Menu
  "compress-image", "compress-image-to-10kb", "compress-image-to-20kb", "compress-image-to-30kb",
  "compress-image-to-40kb", "compress-image-to-50kb", "compress-image-to-100kb", "compress-image-to-150kb",
  "compress-image-to-200kb", "compress-image-to-500kb", "compress-image-to-1mb",
  // PDF Menu
  "compress-pdf", "compress-pdf-to-20kb", "compress-pdf-to-50kb", "compress-pdf-to-100kb",
  "compress-pdf-to-200kb", "compress-pdf-to-300kb", "compress-pdf-to-400kb", "compress-pdf-to-500kb",
  "compress-pdf-to-1mb", "compress-pdf-to-2mb",
  // Image Formats Menu
  "compress-jpeg", "compress-jpeg-to-10kb", "compress-jpeg-to-20kb", "compress-jpeg-to-30kb",
  "compress-jpeg-to-40kb", "compress-jpeg-to-50kb", "compress-jpeg-to-100kb", "compress-jpeg-to-150kb",
  "compress-jpeg-to-200kb", "compress-jpeg-to-500kb", "compress-jpg", "compress-jpg-to-10kb",
  "compress-jpg-to-20kb", "compress-jpg-to-30kb", "compress-jpg-to-40kb", "compress-jpg-to-50kb",
  "compress-jpg-to-100kb", "compress-jpg-to-150kb", "compress-jpg-to-200kb", "compress-jpg-to-500kb",
  "compress-webp", "compress-webp-to-100kb", "compress-png", "compress-png-to-10kb", "compress-png-to-20kb",
  "compress-png-to-30kb", "compress-png-to-40kb", "compress-png-to-50kb", "compress-png-to-100kb",
  "compress-png-to-150kb", "compress-png-to-200kb", "compress-png-to-500kb", "compress-png-to-1mb",
  // Resize Menu
  "resize-image", "resize-image-to-10kb", "resize-image-to-20kb", "resize-image-to-30kb",
  "resize-image-to-40kb", "resize-image-to-50kb", "resize-image-to-100kb", "resize-image-to-150kb",
  "resize-image-to-200kb", "resize-image-to-500kb", "resize-image-to-1mb", "resize-pdf",
  "resize-pdf-to-10kb", "resize-pdf-to-20kb", "resize-pdf-to-30kb", "resize-pdf-to-40kb",
  "resize-pdf-to-50kb", "resize-pdf-to-100kb", "resize-pdf-to-150kb", "resize-pdf-to-200kb",
  "resize-pdf-to-500kb", "resize-pdf-to-1mb",
  // Convert Menu
  "convert-image-to-word", "convert-image-to-excel", "convert-pdf-to-word", "convert-pdf-to-excel",
  "convert-pdf-to-jpg", "convert-pdf-to-ppt", "heic-to-jpg", "heic-to-jpeg", "heic-to-pdf",
  "heic-to-png", "jpg-to-excel", "jpg-to-pdf", "jpg-to-png", "jpg-to-jpeg", "jpg-to-webp",
  "jpeg-to-jpg", "jpeg-to-pdf", "jpeg-to-png", "jpeg-to-excel", "webp-to-jpg", "webp-to-png",
  // Tools & Exams Menu
  "passport-photo-size", "pan-card-photo", "pan-card-signature", "youtube-thumbnail-size",
  "instagram-photo-size", "us-visa-photo", "upsc-photo-signature", "ssc-photo-and-signature",
  "gate-photo-and-signature", "neet-photo-and-signature", "ibps-photo-and-signature",
  "defence-photo-and-signature", "signature-resize"
];

function buildConfig(slug) {
  const isPdf = slug.includes('pdf');
  const sizeMatch = slug.match(/(\d+)(kb|mb)/i);
  const targetVal = sizeMatch ? parseInt(sizeMatch[1], 10) : (isPdf ? 100 : 50);
  const targetUnit = sizeMatch ? sizeMatch[2].toUpperCase() : 'KB';
  const cleanTitle = slug.split('-').map(s => s.charAt(0).toUpperCase() + s.slice(1)).join(' ');

  let ratio = 0;
  if (slug.includes('signature')) ratio = 2 / 1;
  else if (slug.includes('passport')) ratio = 3.5 / 4.5;
  else if (slug.includes('square') || slug.includes('upsc') || slug.includes('visa')) ratio = 1;
  else if (slug.includes('youtube')) ratio = 16 / 9;

  let portalEntity = "Official Online Verification Portals";
  if (slug.includes('upsc')) portalEntity = "UPSC Civil Services & CDS/NDA";
  else if (slug.includes('ssc')) portalEntity = "Staff Selection Commission (SSC CGL/CHSL)";
  else if (slug.includes('pan')) portalEntity = "NSDL & UTI PAN Card Applications";
  else if (slug.includes('neet')) portalEntity = "NTA NEET / JEE Mains Medical & Eng.";
  else if (slug.includes('gate')) portalEntity = "IIT GATE Examination Registration";
  else if (slug.includes('visa')) portalEntity = "US Department of State (DS-160)";
  else if (isPdf) portalEntity = "Government & Academic Document Submissions";

  const targetDisplay = targetUnit === 'MB' ? `${targetVal}MB` : `${targetVal}KB`;

  return {
    slug,
    title: `${cleanTitle} - Free Online Tool | ConvertKB`,
    h1: cleanTitle,
    desc: `Easily process and optimize files with our ${cleanTitle.toLowerCase()} tool. Fast client-side quantization, aspect ratio preservation, and zero server uploads.`,
    isPdf,
    targetKb: targetUnit === 'MB' ? targetVal * 1024 : targetVal,
    targetDisplay,
    format: isPdf ? 'application/pdf' : 'image/jpeg',
    ratio,
    portalEntity,
    intro: `Compressing files to strictly **${targetDisplay}** for **${cleanTitle}** requires precise balance between discrete cosine transform (DCT) quantization and boundary preservation. ConvertKB executes all operations in your browser's local sandbox memory without remote server uploads.`,
    specTable: [
      { label: "Target Application Category", value: portalEntity },
      { label: "Permissible File Size Threshold", value: `Strictly under ${targetDisplay}` },
      { label: "Dimensional Constraints", value: ratio ? "Aspect Ratio Calibrated & Locked" : "Original / Auto-Calibrated" },
      { label: "Output Format Standard", value: isPdf ? "PDF Document (.pdf)" : "JPEG / WebP / PNG" },
      { label: "Processing Mechanism", value: "Hardware-Accelerated Client-Side V8 Sandbox" },
      { label: "Data Transmission Policy", value: "0% Server Upload - 100% Local Device Privacy" }
    ],
    sections: [
      {
        h2: `1. Understanding the Engineering Behind ${cleanTitle}`,
        paragraphs: [
          `Modern smartphone cameras and digital flatbed scanners capture high-resolution imagery containing millions of discrete pixel coordinates. A standard 12MP or 48MP smartphone sensor generates uncompressed RAW image payloads ranging from 5MB to 25MB (5,000KB to 25,000KB). When online recruitment forms, consular visa databases, or academic management systems enforce hard thresholds around ${targetDisplay}, standard linear compression tools simply downscale pixel resolution uniformly. This produces heavy pixelation, blurred cursive signatures, and obscured facial contours that trigger automated validation rejections.`,
          `ConvertKB solves this by applying discrete cosine transform (DCT) matrix quantization on images and stream-level object downsampling on PDF documents. Human visual perception prioritizes high-frequency luminance contours—such as the stroke of a black ink signature or the outline of facial features—over subtle background color gradations. By selectively stripping high-frequency chromatic noise while locking boundary contrast, ConvertKB allows files to hit a precise ${targetDisplay} target with maximum visual sharpness.`,
          `All calculations execute client-side via hardware-accelerated Canvas and WebAssembly memory buffers. Your documents never touch external infrastructure or cloud databases, eliminating identity theft risks associated with traditional online file converters.`
        ]
      },
      {
        h2: isPdf ? "2. Multi-Page PDF Document Optimization Architecture" : "2. Aspect Ratio Preservation, Cropping, and DPI Calibration",
        paragraphs: isPdf ? [
          `Unlike text-only documents, multi-page PDFs generated by home flatbed scanners or smartphone scanning apps contain uncompressed 300 DPI raster scans on every page. A four-page academic transcript can easily exceed 8MB. Standard online PDF reducers only strip basic metadata tags (such as creator, author, and timestamp entries), saving an inconsequential 2KB to 5KB.`,
          `ConvertKB takes an architectural approach to PDF downsizing. Using Mozilla's PDF.js rendering runtime, the tool renders each PDF page into a virtual hardware-accelerated canvas at a calibrated resolution (150 DPI for documents, 72 DPI for web delivery). It flattens bloated layer trees, strips duplicate embedded font subsets, and quantizes raster streams. Finally, the pages are reassembled using PDF-Lib into an optimized container format that complies with official upload limits.`,
          `If your document contains color artifacts or shadow gradients from handheld phone captures, selecting ConvertKB's 'Grayscale' mode strips chrominance channels entirely. This reduces file size by up to 70% while improving text readability on screen.`
        ] : [
          `Aspect ratio distortion is one of the leading causes of application rejections on official job portals. For instance, if an online system expects a 3.5:4.5 cm passport ratio and you upload a square 1:1 image, automated screening bots will vertically compress or stretch your face to force it into their database constraints.`,
          `ConvertKB includes integrated Cropper.js controls with built-in aspect presets: 1:1 Square (UPSC & US Visa DS-160), 3.5:4.5 Passport (SSC, NEET, and International Passports), and 2:1 Rectangular (Candidate Signatures). Locking your crop box before compressing prevents accidental distortion.`,
          `Additionally, portals like NSDL PAN and state PSCs inspect EXIF headers for resolution density. ConvertKB allows you to specify 72, 150, 200, or 300 DPI directly in the output headers, satisfying automated metadata scanners.`
        ]
      },
      {
        h2: "3. Step-by-Step Walkthrough: Compressing and Editing Your File",
        paragraphs: [
          `Step 1: File Ingestion — Click the dropzone or drag your image (JPG, PNG, WebP, HEIC) or PDF directly into the studio card above. The file is read into your browser's local memory instantly without uploading to any server.`,
          `Step 2: Cropping and Orientation — For candidate photos or signatures, choose the appropriate aspect preset (e.g., 3.5:4.5 for passport portraits, 2:1 for signatures). Use the 90° rotation buttons if your phone captured the document in landscape orientation.`,
          `Step 3: Exposure and Contrast Tuning — If your signature or scanned document has a grayish background caused by poor lighting, select 'Document Whiten (B&W)' or increase the Contrast slider to 120%. This turns grayish paper into pure white (#FFFFFF), drastically reducing byte size.`,
          `Step 4: Target Threshold Verification — The target size is preset to ${targetDisplay}. You can adjust this value if your specific notification mandates a different limit.`,
          `Step 5: Execution and Verification — Click 'Execute & Compress File'. ConvertKB executes an 8-iteration binary search algorithm to calibrate compression quality right under your specified target size. Review the before-and-after byte counter and click 'Download File' to save your file.`
        ]
      },
      {
        h2: "4. Official Submission Best Practices for Government Portals",
        paragraphs: [
          `Recruitment agencies like UPSC, SSC, IBPS, and consular visa portals process hundreds of thousands of candidate records daily. Follow these guidelines to ensure your submission passes automated checks:`,
          `• Signature Clarity: Always sign on smooth, unlined white paper using dark black or deep navy gel ink. Avoid ballpoint pens, as they produce faint, reflective lines that break down under compression.`,
          `• Even Portrait Lighting: Position your face toward an even, diffuse light source. Shadows across one side of the face or dark backgrounds can cause automated facial recognition bots to reject the upload.`,
          `• Avoid Double Compression: Compressing an already heavily compressed JPEG introduces generation loss (checkerboard block artifacts). Always start with your original high-resolution photo or scan, crop in ConvertKB, and compress down to ${targetDisplay} in a single pass.`
        ]
      },
      {
        h2: "5. Privacy, Security, and Compliance Architecture",
        paragraphs: [
          `Identity cards, salary slips, marks sheets, and signatures contain sensitive personally identifiable information (PII). Transmitting these files to external third-party cloud conversion servers exposes users to data breaches, unauthorized caching, and surveillance.`,
          `ConvertKB operates under a zero-transmission model. All image processing, canvas operations, and PDF stream assemblies execute in client-side memory via WebAssembly and JavaScript engines. When you close the tab, all buffers are purged from your machine's temporary RAM. Your files never touch external storage.`
        ]
      }
    ],
    faqs: [
      {
        q: `Will compressing my file to ${targetDisplay} make text or details blurry?`,
        a: `No. ConvertKB prioritizes high-frequency contrast boundaries and removes low-frequency noise first, keeping text, signatures, and facial outlines sharp and legible.`
      },
      {
        q: `How does ConvertKB ensure my file lands under ${targetDisplay}?`,
        a: `The engine runs a binary bisection search across canvas quality parameters, testing up to 8 compression iterations in browser memory to find the highest quality level that fits under ${targetDisplay}.`
      },
      {
        q: `Can I calibrate the DPI to 200 DPI for exam portal compliance?`,
        a: `Yes. Use the Target DPI dropdown in the controls panel to set 72, 150, 200, or 300 DPI metadata directly into the file header.`
      },
      {
        q: `Are my confidential documents uploaded to any remote server?`,
        a: `No. ConvertKB processes all files locally inside your browser memory sandbox. No files are transmitted over the internet or saved to remote servers.`
      }
    ]
  };
}

export async function getStaticPaths() {
  return slugsList.map((slug) => {
    const config = buildConfig(slug);
    return {
      params: { slug },
      props: { page: config }
    };
  });
}

const { page } = Astro.props;
const canonicalUrl = `https://convertkb.com/${page.slug}`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": `ConvertKB ${page.h1}`,
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "All",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": page.desc
    },
    {
      "@type": "FAQPage",
      "mainEntity": page.faqs.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{page.title}</title>
  <meta name="description" content={page.desc} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

  <!-- Open Graph -->
  <meta property="og:title" content={page.title} />
  <meta property="og:description" content={page.desc} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="ConvertKB" />

  <!-- Typography & CDNs -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>
  <script is:inline src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>

  <style is:global>
    :root {
      --primary: #4f46e5;
      --primary-hover: #4338ca;
      --primary-light: #eef2ff;
      --slate-900: #0f172a;
      --slate-800: #1e293b;
      --slate-700: #334155;
      --slate-600: #475569;
      --slate-500: #64748b;
      --slate-300: #cbd5e1;
      --slate-200: #e2e8f0;
      --slate-100: #f1f5f9;
      --slate-50: #f8fafc;
      --border: #e2e8f0;
      --shadow-lg: 0 18px 38px -6px rgba(15, 23, 42, 0.12);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
      background-color: #fafbfc;
      color: var(--slate-900);
      line-height: 1.6;
    }
    a { text-decoration: none; color: inherit; }
    .container { max-width: 1240px; margin: 0 auto; padding: 0 24px; }
  </style>
</head>
<body>
  <!-- Header with all 7 Menus & Submenus -->
  <Navigation />

  <main>
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="container">
        <h1>{page.h1}</h1>
        <p>{page.intro}</p>

        <!-- Studio Suite Engine Card -->
        <div class="studio-card" data-default-mode={page.isPdf ? 'pdf' : 'image'} data-default-target={page.targetKb} data-default-ratio={page.ratio}>
          <div class="mode-tabs">
            <button class={`mode-btn ${!page.isPdf ? 'active' : ''}`} id="tabImageMode" type="button">&#128444; Image Studio &amp; Crop</button>
            <button class={`mode-btn ${page.isPdf ? 'active' : ''}`} id="tabPdfMode" type="button">&#128196; Multi-Page PDF Studio</button>
          </div>

          <div class="dropzone" id="dropArea">
            <div class="dropzone-icon">&#128194;</div>
            <h3 id="dropzoneTitle">Select or drop a file to process</h3>
            <p id="dropzoneDesc">Supports JPG, PNG, WEBP, HEIC, and PDF files</p>
            <input type="file" id="fileInput" accept={page.isPdf ? "application/pdf" : "image/*"} style="display:none;" />
          </div>

          <div class="progress-bar-container" id="progressBarContainer">
            <div class="progress-bar-fill" id="progressBarFill"></div>
          </div>

          <div class="editor-workspace" id="editorWorkspace" style="display:none;">
            <div class="workspace-grid">
              <!-- Visual Viewport -->
              <div>
                <div class="viewer-panel" id="viewerPanel">
                  <img id="imageToCrop" src="" alt="Source preview" style="display:none;" />
                  <div class="pdf-viewer-card" id="pdfViewerCard" style="display:none;">
                    <div class="pdf-icon" style="font-size:48px; margin-bottom:12px;">&#128196;</div>
                    <h3 id="pdfCardTitle" style="font-size:16px;">Document Ready</h3>
                    <div class="badge-pill" id="pdfCardStats">0 Pages</div>
                    <canvas id="pdfRenderCanvas" style="display:none; max-width:100%; margin-top:14px; border-radius:8px;"></canvas>
                  </div>
                </div>

                <div id="imageToolbar" class="sub-toolbar">
                  <button type="button" class="tool-btn" id="btnAspectSquare">1:1 Square</button>
                  <button type="button" class="tool-btn" id="btnAspectPassport">3.5:4.5 Passport</button>
                  <button type="button" class="tool-btn" id="btnAspectSignature">2:1 Signature</button>
                  <button type="button" class="tool-btn" id="btnAspectFree">Free Crop</button>
                  <button type="button" class="tool-btn" id="btnRotateL">&#8634; 90&deg;</button>
                  <button type="button" class="tool-btn" id="btnRotateR">&#8635; 90&deg;</button>
                  <button type="button" class="tool-btn" id="btnFlipH">&#8644; Flip H</button>
                  <button type="button" class="tool-btn" id="btnFlipV">&#8645; Flip V</button>
                </div>

                <div id="pdfToolbar" class="sub-toolbar" style="display:none;">
                  <button type="button" class="tool-btn" id="btnPdfPrevPage">&larr; Prev Page</button>
                  <button type="button" class="tool-btn" id="btnPdfNextPage">Next Page &rarr;</button>
                  <span id="pdfPageIndicator" style="font-size:13px; font-weight:700; align-self:center; margin-left:8px;">Page 1</span>
                </div>
              </div>

              <!-- Controls Panel -->
              <div class="controls-panel">
                <div class="card-subheading">Compression Ceiling Target</div>
                <div class="form-row">
                  <div class="form-group">
                    <label for="targetSizeVal">Target Value</label>
                    <input type="number" id="targetSizeVal" value={page.targetKb} min="5" max="50000" />
                  </div>
                  <div class="form-group">
                    <label for="targetSizeUnit">Unit</label>
                    <select id="targetSizeUnit">
                      <option value="KB" selected={page.targetKb < 1024}>KB</option>
                      <option value="MB" selected={page.targetKb >= 1024}>MB</option>
                    </select>
                  </div>
                </div>

                <!-- Image Controls -->
                <div id="imageControlGroup" style="display:flex; flex-direction:column; gap:12px;">
                  <div class="card-subheading">Image Enhancements</div>
                  <div class="form-group">
                    <label for="sliderBrightness">Brightness <span class="range-val" id="valBrightness">100%</span></label>
                    <input type="range" id="sliderBrightness" min="40" max="180" value="100" />
                  </div>
                  <div class="form-group">
                    <label for="sliderContrast">Contrast <span class="range-val" id="valContrast">100%</span></label>
                    <input type="range" id="sliderContrast" min="40" max="180" value="100" />
                  </div>
                  <div class="form-group">
                    <label for="sliderSaturation">Saturation <span class="range-val" id="valSaturation">100%</span></label>
                    <input type="range" id="sliderSaturation" min="0" max="200" value="100" />
                  </div>
                  <div class="form-row">
                    <div class="form-group">
                      <label for="selectFilterPreset">Filter Mode</label>
                      <select id="selectFilterPreset">
                        <option value="none" selected>Standard</option>
                        <option value="grayscale">Pure Grayscale</option>
                        <option value="highcontrast">Document Whiten (B&amp;W)</option>
                      </select>
                    </div>
                    <div class="form-group">
                      <label for="selectDpi">Target DPI</label>
                      <select id="selectDpi">
                        <option value="72">72 DPI</option>
                        <option value="150">150 DPI</option>
                        <option value="200" selected>200 DPI (Exam)</option>
                        <option value="300">300 DPI</option>
                      </select>
                    </div>
                  </div>
                  <div class="form-row">
                    <div class="form-group">
                      <label for="selectImageOutputFormat">Output Extension</label>
                      <select id="selectImageOutputFormat">
                        <option value="image/jpeg" selected={page.format === 'image/jpeg'}>JPG / JPEG</option>
                        <option value="image/png" selected={page.format === 'image/png'}>PNG (Lossless)</option>
                        <option value="image/webp" selected={page.format === 'image/webp'}>WebP</option>
                        <option value="application/pdf" selected={page.format === 'application/pdf'}>Compile to PDF</option>
                      </select>
                    </div>
                    <div class="form-group">
                      <label for="customWidthLock">Width Lock (px)</label>
                      <input type="number" id="customWidthLock" placeholder="Auto" />
                    </div>
                  </div>
                </div>

                <!-- PDF Controls -->
                <div id="pdfControlGroup" style="display:none; flex-direction:column; gap:12px;">
                  <div class="card-subheading">PDF Settings</div>
                  <div class="form-group">
                    <label for="pdfCompressionLevel">Compression Profile</label>
                    <select id="pdfCompressionLevel">
                      <option value="extreme">Extreme (72 DPI &bull; Maximum Compression)</option>
                      <option value="balanced" selected>Balanced (150 DPI &bull; Recommended)</option>
                      <option value="low">Low (200 DPI &bull; High Clarity)</option>
                    </select>
                  </div>
                  <div class="form-row">
                    <div class="form-group">
                      <label for="pdfPageRange">Page Filter</label>
                      <input type="text" id="pdfPageRange" value="all" placeholder="e.g. 1-3, 5" />
                    </div>
                    <div class="form-group">
                      <label for="pdfColorMode">Color Conversion</label>
                      <select id="pdfColorMode">
                        <option value="color" selected>Full Color</option>
                        <option value="grayscale">Grayscale (B&amp;W)</option>
                      </select>
                    </div>
                  </div>
                </div>

                <button class="btn-execute" id="btnExecuteProcess" type="button">Execute &amp; Compress File</button>
              </div>
            </div>

            <!-- Download Banner -->
            <div class="result-banner" id="resultBanner" style="display:none;">
              <div>
                <h4 style="color:#065f46; font-size:15px; font-weight:800;">Optimization Complete</h4>
                <p id="resultMetrics" style="font-size:13px; color:#047857; font-family:'JetBrains Mono', monospace;"></p>
              </div>
              <a href="#" id="downloadLinkBtn" class="btn-download" download="convertkb_optimized">Download File</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Technical Guide & Parameters (1,200+ Words) -->
    <section class="content-section">
      <div class="container content-body">
        <h2>Official Specification Matrix</h2>
        <p>Ensure your output metrics match official agency parameters prior to submission:</p>

        <table>
          <thead>
            <tr>
              <th>Specification Parameter</th>
              <th>Prescribed Portal Standard</th>
            </tr>
          </thead>
          <tbody>
            {page.specTable.map((row, idx) => (
              <tr key={idx}>
                <td><strong>{row.label}</strong></td>
                <td>{row.value}</td>
              </tr>
            ))}
          </tbody>
        </table>

        {page.sections.map((sec, sIdx) => (
          <div class="content-block" key={sIdx}>
            <h2>{sec.h2}</h2>
            {sec.paragraphs.map((p, pIdx) => (
              <p key={pIdx}>{p}</p>
            ))}
