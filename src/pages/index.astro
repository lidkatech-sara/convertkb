  <!-- Client-Side Engine Script -->
  <script is:inline>
    let cropper = null;
    let loadedFile = null;
    let isPdfMode = false;
    let pdfBytes = null;

    const dropArea = document.getElementById('dropArea');
    const fileInput = document.getElementById('fileInput');
    const editorWorkspace = document.getElementById('editorWorkspace');
    const imageToCrop = document.getElementById('imageToCrop');
    const cropperWrapper = document.getElementById('cropperWrapper');
    const pdfInfoPanel = document.getElementById('pdfInfoPanel');
    const imageToolButtons = document.getElementById('imageToolButtons');
    const imageFilters = document.getElementById('imageFilters');
    const pdfOptions = document.getElementById('pdfOptions');
    const tabImageMode = document.getElementById('tabImageMode');
    const tabPdfMode = document.getElementById('tabPdfMode');
    const btnExecuteProcess = document.getElementById('btnExecuteProcess');
    const resultBanner = document.getElementById('resultBanner');
    const resultStats = document.getElementById('resultStats');
    const downloadLink = document.getElementById('downloadLink');

    // Filter elements
    const brightnessSlider = document.getElementById('brightnessSlider');
    const brightnessVal = document.getElementById('brightnessVal');
    const contrastSlider = document.getElementById('contrastSlider');
    const contrastVal = document.getElementById('contrastVal');

    // Tab switching
    tabImageMode.addEventListener('click', () => {
      isPdfMode = false;
      tabImageMode.classList.add('active');
      tabPdfMode.classList.remove('active');
      fileInput.accept = "image/*";
      document.getElementById('dropzoneTitle').textContent = "Select or drop your Image";
      document.getElementById('dropzoneDesc').textContent = "Supports JPG, PNG, WEBP, and HEIC";
    });

    tabPdfMode.addEventListener('click', () => {
      isPdfMode = true;
      tabPdfMode.classList.add('active');
      tabImageMode.classList.remove('active');
      fileInput.accept = "application/pdf";
      document.getElementById('dropzoneTitle').textContent = "Select or drop your PDF";
      document.getElementById('dropzoneDesc').textContent = "Compress, optimize, and strip metadata from PDF files";
    });

    // Dropzone triggers
    dropArea.addEventListener('click', () => fileInput.click());
    dropArea.addEventListener('dragover', (e) => { e.preventDefault(); dropArea.style.borderColor = '#4f46e5'; });
    dropArea.addEventListener('dragleave', () => { dropArea.style.borderColor = '#cbd5e1'; });
    dropArea.addEventListener('drop', (e) => {
      e.preventDefault();
      dropArea.style.borderColor = '#cbd5e1';
      if (e.dataTransfer.files && e.dataTransfer.files[0]) {
        processIncomingFile(e.dataTransfer.files[0]);
      }
    });

    fileInput.addEventListener('change', (e) => {
      if (e.target.files && e.target.files[0]) {
        processIncomingFile(e.target.files[0]);
      }
    });

    function processIncomingFile(file) {
      loadedFile = file;
      resultBanner.style.display = 'none';

      if (file.type === "application/pdf") {
        isPdfMode = true;
        tabPdfMode.classList.add('active');
        tabImageMode.classList.remove('active');
        cropperWrapper.style.display = 'none';
        imageToolButtons.style.display = 'none';
        imageFilters.style.display = 'none';
        pdfOptions.style.display = 'block';
        pdfInfoPanel.style.display = 'block';

        document.getElementById('pdfFilename').textContent = file.name;
        document.getElementById('pdfFilesize').textContent = `Size: ${(file.size / 1024).toFixed(1)} KB`;

        const fileReader = new FileReader();
        fileReader.onload = function(evt) {
          pdfBytes = new Uint8Array(evt.target.result);
        };
        fileReader.readAsArrayBuffer(file);
      } else {
        isPdfMode = false;
        tabImageMode.classList.add('active');
        tabPdfMode.classList.remove('active');
        cropperWrapper.style.display = 'flex';
        imageToolButtons.style.display = 'flex';
        imageFilters.style.display = 'block';
        pdfOptions.style.display = 'none';
        pdfInfoPanel.style.display = 'none';

        const reader = new FileReader();
        reader.onload = function(e) {
          imageToCrop.src = e.target.result;
          if (cropper) { cropper.destroy(); }
          cropper = new Cropper(imageToCrop, {
            viewMode: 1,
            autoCropArea: 0.9,
            responsive: true,
            restore: false
          });
        };
        reader.readAsDataURL(file);
      }

      editorWorkspace.style.display = 'block';
    }

    // Cropper aspect presets
    document.getElementById('btnCropSquare').addEventListener('click', () => cropper && cropper.setAspectRatio(1));
    document.getElementById('btnCropPassport').addEventListener('click', () => cropper && cropper.setAspectRatio(3.5 / 4.5));
    document.getElementById('btnCropSignature').addEventListener('click', () => cropper && cropper.setAspectRatio(2 / 1));
    document.getElementById('btnCropFree').addEventListener('click', () => cropper && cropper.setAspectRatio(NaN));
    document.getElementById('btnRotateLeft').addEventListener('click', () => cropper && cropper.rotate(-90));
    document.getElementById('btnRotateRight').addEventListener('click', () => cropper && cropper.rotate(90));
    document.getElementById('btnFlipH').addEventListener('click', () => {
      if (!cropper) return;
      const data = cropper.getData();
      cropper.scaleX(data.scaleX === -1 ? 1 : -1);
    });

    // Image adjustment sliders
    brightnessSlider.addEventListener('input', (e) => {
      brightnessVal.textContent = `${e.target.value}%`;
      applyCanvasFilters();
    });
    contrastSlider.addEventListener('input', (e) => {
      contrastVal.textContent = `${e.target.value}%`;
      applyCanvasFilters();
    });

    function applyCanvasFilters() {
      if (!cropper) return;
      const imgElement = cropperWrapper.querySelector('.cropper-view-box img, .cropper-canvas img');
      if (imgElement) {
        imgElement.style.filter = `brightness(${brightnessSlider.value}%) contrast(${contrastSlider.value}%)`;
      }
    }

    // Compression processing engine
    btnExecuteProcess.addEventListener('click', async () => {
      if (!loadedFile) return;

      btnExecuteProcess.textContent = "Processing File...";
      btnExecuteProcess.disabled = true;

      const targetVal = parseFloat(document.getElementById('targetSizeInput').value) || 50;
      const targetUnit = document.getElementById('targetUnit').value;
      const targetBytes = targetVal * (targetUnit === "MB" ? 1024 * 1024 : 1024);

      if (isPdfMode) {
        try {
          const { PDFDocument } = PDFLib;
          const pdfDoc = await PDFDocument.load(pdfBytes, { ignoreEncryption: true });

          // Optimization: strip unnecessary metadata dictionaries
          pdfDoc.setTitle('');
          pdfDoc.setAuthor('');
          pdfDoc.setSubject('');
          pdfDoc.setKeywords([]);
          pdfDoc.setProducer('');
          pdfDoc.setCreator('');

          const optimizedBytes = await pdfDoc.save({ useObjectStreams: true });
          const blob = new Blob([optimizedBytes], { type: 'application/pdf' });
          presentResults(blob, loadedFile.size, blob.size, 'pdf');
        } catch (err) {
          alert('PDF parsing error: ' + err.message);
        } finally {
          btnExecuteProcess.textContent = "Execute & Compress File";
          btnExecuteProcess.disabled = false;
        }
      } else {
        // Image Processing via Canvas & Cropper
        const canvas = cropper ? cropper.getCroppedCanvas() : null;
        if (!canvas) {
          btnExecuteProcess.textContent = "Execute & Compress File";
          btnExecuteProcess.disabled = false;
          return;
        }

        // Apply filters directly to a rendering context
        const filteredCanvas = document.createElement('canvas');
        filteredCanvas.width = canvas.width;
        filteredCanvas.height = canvas.height;
        const ctx = filteredCanvas.getContext('2d');
        ctx.filter = `brightness(${brightnessSlider.value}%) contrast(${contrastSlider.value}%)`;
        ctx.drawImage(canvas, 0, 0);

        const format = document.getElementById('formatSelect').value;

        if (format === 'application/pdf') {
          // Convert cropped image to PDF directly
          const { PDFDocument } = PDFLib;
          const pdfDoc = await PDFDocument.create();
          const imgDataUrl = filteredCanvas.toDataURL('image/jpeg', 0.85);
          const embeddedImg = await pdfDoc.embedJpg(imgDataUrl);
          const page = pdfDoc.addPage([embeddedImg.width, embeddedImg.height]);
          page.drawImage(embeddedImg, { x: 0, y: 0, width: embeddedImg.width, height: embeddedImg.height });

          const compiledBytes = await pdfDoc.save();
          const blob = new Blob([compiledBytes], { type: 'application/pdf' });
          presentResults(blob, loadedFile.size, blob.size, 'pdf');
          btnExecuteProcess.textContent = "Execute & Compress File";
          btnExecuteProcess.disabled = false;
        } else {
          // Targeted Bisection Compression Algorithm
          let minQ = 0.05;
          let maxQ = 0.98;
          let iterations = 0;
          let finalBlob = null;

          function runCompressionBisection() {
            const currentQ = (minQ + maxQ) / 2;
            filteredCanvas.toBlob((blob) => {
              iterations++;
              if (!blob) return;

              if (blob.size <= targetBytes || iterations >= 7) {
                finalBlob = blob;
                minQ = currentQ;
              } else {
                maxQ = currentQ;
              }

              if (iterations < 7 && minQ < maxQ) {
                runCompressionBisection();
              } else {
                presentResults(finalBlob || blob, loadedFile.size, (finalBlob || blob).size, format.split('/')[1]);
                btnExecuteProcess.textContent = "Execute & Compress File";
                btnExecuteProcess.disabled = false;
              }
            }, format, currentQ);
          }

          runCompressionBisection();
        }
      }
    });

    function presentResults(blob, originalSize, newSize, extension) {
      resultBanner.style.display = 'flex';
      const origKb = (originalSize / 1024).toFixed(1);
      const newKb = (newSize / 1024).toFixed(1);

      resultStats.innerHTML = `<strong>Original Size:</strong> ${origKb} KB &rarr; <strong>New Size:</strong> ${newKb} KB (Target reached)`;
      const url = URL.createObjectURL(blob);
      downloadLink.href = url;
      downloadLink.download = `convertkb_${Date.now()}.${extension}`;
    }
  </script>
