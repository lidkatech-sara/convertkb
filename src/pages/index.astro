    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 group focus:outline-none focus:ring-2 focus:ring-blue-600 rounded-lg p-1">
        <span class="w-9 h-9 rounded-xl bg-blue-600 text-white font-black text-base flex items-center justify-center shadow-md shadow-blue-500/20 group-hover:scale-105 transition-transform">
          KB
        </span>
        <span class="text-xl font-black tracking-tight text-slate-900">
          Convert<span class="text-blue-600">KB</span>
        </span>
      </a>

      <!-- Desktop Crawlable Navigation -->
      <nav class="hidden md:flex items-center gap-7 text-sm font-semibold text-slate-600">
        <a href="#popular-sizes" class="hover:text-blue-600 transition">Popular Sizes</a>
        <a href="#identity-visas" class="hover:text-blue-600 transition">Visas & Passports</a>
        <a href="#government-exams" class="hover:text-blue-600 transition">Exam Portals</a>
        <a href="#format-converters" class="hover:text-blue-600 transition">Encoders</a>
        <a href="#faqs" class="hover:text-blue-600 transition">FAQ</a>
