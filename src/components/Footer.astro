---
// src/components/Footer.astro
---

<footer>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <div class="footer-brand">
          <span class="dot"></span> ConvertKB
        </div>
        <p>
          High-performance, client-side precision image editor and PDF compression utility. Crop, filter, calibrate DPI, and compress files to exact kilobyte targets directly in your browser without server uploads.
        </p>
      </div>

      <div class="footer-col">
        <h5>Popular Sizes</h5>
        <ul>
          <li><a href="/compress-image-to-20kb">Compress Image to 20KB</a></li>
          <li><a href="/compress-image-to-50kb">Compress Image to 50KB</a></li>
          <li><a href="/compress-image-to-100kb">Compress Image to 100KB</a></li>
          <li><a href="/compress-pdf-to-100kb">Compress PDF to 100KB</a></li>
          <li><a href="/compress-pdf-to-200kb">Compress PDF to 200KB</a></li>
          <li><a href="/compress-pdf-to-500kb">Compress PDF to 500KB</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h5>Exam &amp; Portal Tools</h5>
        <ul>
          <li><a href="/upsc-photo-signature">UPSC Photo &amp; Signature</a></li>
          <li><a href="/ssc-photo-and-signature">SSC Photo &amp; Signature</a></li>
          <li><a href="/pan-card-photo">PAN Card Photo &amp; Sign</a></li>
          <li><a href="/gate-photo-and-signature">GATE Exam Photo Size</a></li>
          <li><a href="/neet-photo-and-signature">NEET Postcard Photo Size</a></li>
          <li><a href="/us-visa-photo">US Visa 600x600 Spec</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h5>Legal &amp; Trust</h5>
        <ul>
          <li><a href="/about">About Us</a></li>
          <li><a href="/privacy-policy">Privacy Policy</a></li>
          <li><a href="/terms">Terms of Service</a></li>
          <li><a href="/contact">Contact Support</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} ConvertKB.com. All Rights Reserved. Engineered for speed, privacy, and zero server logging.</p>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--slate-900);
    color: #94a3b8;
    padding: 64px 0 28px;
    font-size: 14px;
    border-top: 1px solid var(--border);
  }
  .footer-brand {
    font-size: 20px;
    font-weight: 800;
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
  }
  .footer-brand .dot {
    width: 8px;
    height: 8px;
    background: var(--primary);
    border-radius: 50%;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1.2fr 1.2fr 1fr;
    gap: 36px;
    margin-bottom: 48px;
  }
  .footer-col h5 {
    color: #ffffff;
    font-size: 15px;
    margin-bottom: 16px;
    font-weight: 700;
  }
  .footer-col ul { list-style: none; padding: 0; }
  .footer-col ul li { margin-bottom: 9px; }
  .footer-col a { color: #94a3b8; transition: color 0.15s ease; }
  .footer-col a:hover { color: #ffffff; }
  .footer-bottom {
    border-top: 1px solid var(--slate-800);
    padding-top: 24px;
    text-align: center;
    font-size: 13px;
    color: var(--slate-500);
  }
  @media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 540px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
