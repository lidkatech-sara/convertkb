const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "ConvertKB File Compressor & Editor",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "All",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "Interactive online image cropper, PDF optimizer, and exact KB size file reducer."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does ConvertKB reduce PDF size to 100KB or 200KB?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The tool parses the PDF object graph directly using web assembly/PDF-lib, strips out unreferenced font glyphs, removes metadata trees, and compresses embedded images using discrete DCT re-quantization."
          }
        },
        {
          "@type": "Question",
          "name": "Can I crop and set exact passport or exam photo dimensions?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, ConvertKB has built-in Cropper.js controls with presets for 3.5x4.5cm passport dimensions, 1:1 square, and signature ratios with instant live previews."
          }
        }
      ]
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content="index, follow, max-image-preview:large" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Cropper.js & PDF-Lib CDNs -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
  <script is:inline src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <style>
    :root {
      --primary: #4f46e5;
      --primary-hover: #4338ca;
      --accent: #06b6d4;
      --slate-900: #0f172a;
      --slate-800: #1e293b;
      --slate-700: #334155;
      --slate-600: #475569;
      --slate-500: #64748b;
      --slate-200: #e2e8f0;
      --slate-100: #f1f5f9;
      --slate-50: #f8fafc;
      --card-bg: #ffffff;
      --border: #e2e8f0;
      --shadow: 0 10px 30px -5px rgba(15, 23, 42, 0.08);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
      background-color: var(--slate-50);
      color: var(--slate-900);
      line-height: 1.6;
    }
    a { text-decoration: none; color: inherit; }
    .container { max-width: 1240px; margin: 0 auto; padding: 0 24px; }

    /* Navigation */
    header {
      background: #ffffff;
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 1000;
    }
    .nav-container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 72px;
    }
    .brand-logo {
      font-size: 24px;
      font-weight: 800;
      letter-spacing: -0.5px;
      color: var(--slate-900);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .brand-logo .dot {
      width: 9px;
      height: 9px;
      background: var(--primary);
      border-radius: 50%;
    }
    .desktop-nav {
      display: flex;
      align-items: center;
      gap: 2px;
    }
    .nav-menu-item { position: relative; }
    .nav-menu-btn {
      padding: 8px 14px;
      font-size: 14px;
      font-weight: 600;
      color: var(--slate-700);
      border-radius: 6px;
      display: flex;
      align-items: center;
      gap: 5px;
      cursor: pointer;
      background: transparent;
      border: none;
    }
    .nav-menu-btn:hover { background: var(--slate-100); color: var(--primary); }
    .dropdown-content {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      background: #ffffff;
      min-width: 260px;
      max-height: 440px;
      overflow-y: auto;
      box-shadow: 0 16px 36px rgba(0,0,0,0.12);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 8px 0;
      z-index: 1100;
    }
    .nav-menu-item:hover .dropdown-content { display: block; }
    .dropdown-content a {
      display: block;
      padding: 9px 18px;
      font-size: 13px;
      font-weight: 500;
      color: var(--slate-700);
      transition: background 0.15s;
    }
    .dropdown-content a:hover { background: var(--slate-100); color: var(--primary); }

    /* Studio Hero */
    .hero-section {
      padding: 44px 0 20px;
      text-align: center;
      background: linear-gradient(180deg, #f1f5f9 0%, #f8fafc 100%);
    }
    .hero-section h1 {
      font-size: 42px;
      font-weight: 800;
      letter-spacing: -1px;
      color: var(--slate-900);
      margin-bottom: 12px;
    }
    .hero-section p {
      font-size: 18px;
      color: var(--slate-600);
      max-width: 780px;
      margin: 0 auto 32px;
    }

    /* Main Compressor & Editor Engine Card */
    .studio-card {
      max-width: 980px;
      margin: 0 auto 50px;
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: 20px;
      box-shadow: var(--shadow);
      padding: 32px;
      text-align: left;
    }
    .mode-tabs {
      display: flex;
      gap: 10px;
      border-bottom: 2px solid var(--slate-100);
      margin-bottom: 24px;
      padding-bottom: 6px;
    }
    .mode-btn {
      background: none;
      border: none;
      font-size: 15px;
      font-weight: 700;
      color: var(--slate-500);
      padding: 10px 18px;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .mode-btn.active {
      color: var(--primary);
      background: #eef2ff;
    }

    /* Upload Area */
    .dropzone {
      border: 2px dashed #cbd5e1;
      background: #f8fafc;
      border-radius: 14px;
      padding: 40px 20px;
      text-align: center;
      cursor: pointer;
      transition: all 0.2s;
    }
    .dropzone:hover { border-color: var(--primary); background: #f5f7ff; }
    .dropzone-icon { font-size: 44px; margin-bottom: 8px; }

    /* Editor Workspace Area */
    .editor-workspace {
      display: none;
      margin-top: 24px;
      border-top: 1px solid var(--border);
      padding-top: 24px;
    }
    .preview-container {
      display: grid;
      grid-template-columns: 1.3fr 1fr;
      gap: 24px;
      align-items: start;
    }
    .cropper-wrapper {
      max-height: 420px;
      background: #0f172a;
      border-radius: 12px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .cropper-wrapper img {
      max-width: 100%;
      display: block;
    }

    /* Controls Sidebar */
    .controls-panel {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .control-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .control-group label {
      font-size: 13px;
      font-weight: 700;
      color: var(--slate-700);
      display: flex;
      justify-content: space-between;
    }
    .control-group input, .control-group select {
      width: 100%;
      padding: 9px 12px;
      border-radius: 8px;
      border: 1px solid var(--border);
      font-size: 14px;
      outline: none;
      background: #ffffff;
    }
    .control-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .btn-group {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .tool-icon-btn {
      padding: 6px 12px;
      background: var(--slate-100);
      border: 1px solid var(--border);
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
    }
    .tool-icon-btn:hover { background: #e2e8f0; }

    /* Action Buttons */
    .action-btn-primary {
      background: var(--primary);
      color: #ffffff;
      border: none;
      padding: 14px 24px;
      font-size: 15px;
      font-weight: 700;
      border-radius: 10px;
      cursor: pointer;
      width: 100%;
      transition: background 0.2s;
    }
    .action-btn-primary:hover { background: var(--primary-hover); }

    /* Results Bar */
    .result-banner {
      display: none;
      margin-top: 20px;
      padding: 16px 20px;
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      border-radius: 10px;
      align-items: center;
      justify-content: space-between;
    }

    /* Content Area */
    .content-section {
      padding: 60px 0;
      background: #ffffff;
      border-top: 1px solid var(--border);
    }
    .content-body {
      max-width: 900px;
      margin: 0 auto;
      font-size: 17px;
      line-height: 1.8;
      color: var(--slate-800);
    }
    .content-body h2 {
      font-size: 28px;
      font-weight: 800;
      margin: 40px 0 16px;
      color: var(--slate-900);
      letter-spacing: -0.5px;
    }
    .content-body h3 {
      font-size: 20px;
      font-weight: 700;
      margin: 24px 0 10px;
      color: var(--slate-900);
    }
    .content-body p { margin-bottom: 20px; }
    .content-body ul, .content-body ol { margin-bottom: 24px; padding-left: 24px; }
    .content-body li { margin-bottom: 8px; }

    table {
      width: 100%;
      border-collapse: collapse;
      margin: 24px 0;
      font-size: 14px;
    }
    th, td { padding: 12px; border: 1px solid var(--border); text-align: left; }
    th { background: var(--slate-100); font-weight: 700; }

    /* FAQ */
    .faq-section { padding: 50px 0; background: var(--slate-50); }
    .faq-item {
      background: #ffffff;
      border: 1px solid var(--border);
      padding: 20px;
      border-radius: 10px;
      margin-bottom: 12px;
    }
    .faq-item h4 { font-size: 17px; font-weight: 700; margin-bottom: 6px; }
    .faq-item p { color: var(--slate-600); font-size: 14px; }

    /* Static Footer */
    footer {
      background: var(--slate-900);
      color: #94a3b8;
      padding: 60px 0 24px;
      font-size: 14px;
    }
    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 36px;
      margin-bottom: 40px;
    }
    .footer-col h5 { color: #fff; font-size: 15px; margin-bottom: 14px; }
    .footer-col ul { list-style: none; }
    .footer-col ul li { margin-bottom: 8px; }
    .footer-col a:hover { color: #fff; }
    .footer-bottom {
      border-top: 1px solid var(--slate-800);
      padding-top: 20px;
      text-align: center;
      font-size: 13px;
    }

    @media (max-width: 992px) {
      .desktop-nav { display: none; }
      .preview-container { grid-template-columns: 1fr; }
      .footer-grid { grid-template-columns: 1fr 1fr; }
    }
  </style>
</head>
<body>

  <!-- Static Header -->
  <header>
    <div class="container nav-container">
      <a href="/" class="brand-logo">
        <span class="dot"></span> ConvertKB
      </a>

      <nav class="desktop-nav">
        {navigation.map((menu) => (
          <div class="nav-menu-item">
            <button class="nav-menu-btn" type="button">
              {menu.name}
              <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </button>
            <div class="dropdown-content">
              {menu.items.map((sub) => (
                <a href={sub.href}>{sub.name}</a>
              ))}
            </div>
          </div>
        ))}
      </nav>
    </div>
  </header>

  <main>
    <!-- Hero Header -->
    <section class="hero-section">
      <div class="container">
        <h1>Compress &amp; Edit Files to Exact KB</h1>
        <p>
          Crop, rotate, enhance, and compress images and PDF documents to exact file targets (20KB, 50KB, 100KB, 200KB) with instant live preview.
        </p>

        <!-- Studio Suite Engine Card -->
        <div class="studio-card">
          <div class="mode-tabs">
            <button class="mode-btn active" id="tabImageMode" type="button">&#128444; Image Studio &amp; Crop</button>
            <button class="mode-btn" id="tabPdfMode" type="button">&#128196; PDF Compressor &amp; Optimizer</button>
          </div>

          <!-- Drag and Drop Area -->
          <div class="dropzone" id="dropArea">
            <div class="dropzone-icon">&#128194;</div>
            <h3 id="dropzoneTitle">Select or drop your file here</h3>
            <p id="dropzoneDesc">Supports JPG, PNG, WEBP, HEIC, and PDF files</p>
            <input type="file" id="fileInput" accept="image/*,application/pdf" style="display:none;" />
          </div>

          <!-- Interactive Workspace -->
          <div class="editor-workspace" id="editorWorkspace">
            <div class="preview-container">
              
              <!-- Left: Canvas / Cropper Display -->
              <div>
                <div class="cropper-wrapper" id="cropperWrapper">
                  <img id="imageToCrop" src="" alt="Workspace Preview" />
                </div>

                <!-- PDF Details View (Only visible for PDFs) -->
                <div id="pdfInfoPanel" style="display:none; padding: 24px; background: #f8fafc; border: 1px solid var(--border); border-radius: 12px; text-align: center;">
                  <div style="font-size: 40px; margin-bottom: 8px;">&#128196;</div>
