---
// src/pages/compress-image-to-10kb.astro
const pageTitle = "Compress Image to 10KB Online Free - Precision Photo & Signature Reducer";
const pageDescription = "Crop, rotate, zoom, and compress photos and signatures to strictly under 10KB online. Built-in Cropper.js tool, DPI adjustment, and instant download. 100% private client-side processing.";
const canonicalURL = "https://convertkb.com/compress-image-to-10kb/";

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://convertkb.com/compress-image-to-10kb/#webapp",
      "url": canonicalURL,
      "name": "ConvertKB 10KB Image Compressor & Cropper",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Runs client-side on all modern browsers.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://convertkb.com/compress-image-to-10kb/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://convertkb.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Image Compress",
          "item": "https://convertkb.com/image/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Compress Image to 10KB",
          "item": canonicalURL
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://convertkb.com/compress-image-to-10kb/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does Cropper.js help achieve a strict 10KB file size?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "By trimming away redundant document borders and whitespace before compression, the pixel count is substantially lowered. This allows the compression engine to preserve maximum clarity on the actual subject—such as facial features or signature lines—without wasting file weight encoding blank margins."
          }
        },
        {
          "@type": "Question",
          "name": "Why do competitive exams and government portals require images below 10KB?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Recruitment portals like SSC, UPSC, IBPS, and state PSCs process millions of applicants simultaneously. Restricting files to 10KB or 20KB prevents bandwidth bottlenecks, speeds up server ingestion, and ensures that hall tickets and admit cards print at uniform dimensions."
          }
        },
        {
          "@type": "Question",
          "name": "Are my signatures or personal identification photos stored on your server?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. All cropping, zooming, rotation, and compression are computed locally in your device's browser memory using JavaScript and HTML5 Canvas. No data is ever transmitted over the network."
          }
        },
        {
          "@type": "Question",
          "name": "How do I make a faint signature darker before compressing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Enable the Grayscale mode switch and adjust the Contrast slider to around 125%. This will push the off-white paper background to pure white while darkening the ink lines for crisp readability."
          }
        }
      ]
    }
  ]
};

const schemaJson = JSON.stringify(schemaData);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonicalURL} />
  
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#ffffff" />

  <!-- Cropper.js Official Stylesheet -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" />

  <script type="application/ld+json" set:html={schemaJson}></script>

  <style>
    :root {
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --primary-light: #eff6ff;
      --primary-glow: rgba(37, 99, 235, 0.16);
      --accent: #0ea5e9;
      --accent-light: #f0f9ff;
      --text-main: #0f172a;
      --text-muted: #475569;
      --text-light: #64748b;
      --bg-body: #fafafa;
      --bg-card: #ffffff;
      --border: #e2e8f0;
      --border-focus: #bfdbfe;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --shadow-sm: 0 1px 3px 0 rgba(0, 0, 0, 0.04);
      --shadow-md: 0 6px 16px -2px rgba(15, 23, 42, 0.06), 0 2px 6px -2px rgba(15, 23, 42, 0.03);
      --shadow-lg: 0 20px 35px -8px rgba(15, 23, 42, 0.1), 0 8px 16px -6px rgba(15, 23, 42, 0.04);
      --shadow-dropdown: 0 16px 36px -4px rgba(15, 23, 42, 0.14), 0 4px 12px -2px rgba(15, 23, 42, 0.06);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background-color: var(--bg-body);
      color: var(--text-main);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    .container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* ==================== HEADER ==================== */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(226, 232, 240, 0.9);
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 72px;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 1.45rem;
      font-weight: 800;
      text-decoration: none;
      color: var(--text-main);
      letter-spacing: -0.03em;
    }

    .logo-badge {
      width: 36px;
      height: 36px;
      background: linear-gradient(135deg, var(--primary), var(--accent));
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
      font-size: 0.95rem;
      font-weight: 900;
      box-shadow: 0 4px 12px var(--primary-glow);
    }

    .brand-badge {
      color: var(--primary);
      font-weight: 700;
    }

    /* Desktop Navigation */
    .nav-root {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .nav-menu-item {
      position: relative;
    }

    .nav-summary {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 9px 15px;
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--text-muted);
      cursor: pointer;
      list-style: none;
      border-radius: var(--radius-sm);
      transition: all 0.15s ease;
      user-select: none;
    }

    .nav-summary::-webkit-details-marker {
      display: none;
    }

    .nav-summary:hover,
    .nav-menu-item[open] > .nav-summary {
      color: var(--primary);
      background: var(--primary-light);
    }

    .arrow-icon {
      font-size: 0.72rem;
      transition: transform 0.2s ease;
      opacity: 0.7;
    }

    .nav-menu-item[open] .arrow-icon {
      transform: rotate(180deg);
      opacity: 1;
    }

    .megamenu-panel {
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-dropdown);
      padding: 24px;
      gap: 28px;
      z-index: 1050;
      animation: menuFadeIn 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes menuFadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .megamenu-panel.cols-2 {
      min-width: 500px;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }

    .megamenu-panel.cols-3 {
      min-width: 740px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
    }

    .nav-menu-item:last-child .megamenu-panel,
    .nav-menu-item:nth-last-child(2) .megamenu-panel {
      left: auto;
      right: 0;
    }

    .megamenu-col h4 {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--text-light);
      margin-bottom: 12px;
      padding-bottom: 6px;
      border-bottom: 1px solid var(--border);
    }

    .megamenu-col ul {
      list-style: none;
    }

    .megamenu-col li {
      margin-bottom: 4px;
    }

    .megamenu-col a {
      display: block;
      font-size: 0.885rem;
      color: var(--text-muted);
      text-decoration: none;
      padding: 5px 8px;
      border-radius: 6px;
      transition: all 0.15s ease;
    }

    .megamenu-col a:hover {
      color: var(--primary);
      background: var(--primary-light);
      transform: translateX(2px);
    }

    .megamenu-col .hub-pill {
      display: inline-block;
      margin-top: 10px;
      font-weight: 600;
      color: var(--primary);
      font-size: 0.85rem;
    }

    /* Mobile Hamburger Trigger */
    .mobile-hamburger {
      display: none;
      background: #f1f5f9;
      border: 1px solid var(--border);
      border-radius: 10px;
      cursor: pointer;
      width: 44px;
      height: 44px;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 5px;
      transition: background 0.15s ease;
    }

    .mobile-hamburger span {
      display: block;
      width: 20px;
      height: 2px;
      background: var(--text-main);
      border-radius: 2px;
    }

    /* Mobile Drawer */
    .mobile-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.5);
      backdrop-filter: blur(4px);
      z-index: 1999;
    }

    .mobile-drawer {
      position: fixed;
      top: 0;
      right: -100%;
      width: 86%;
      max-width: 380px;
      height: 100vh;
      height: 100dvh;
      background: #ffffff;
      z-index: 2000;
      box-shadow: -10px 0 35px rgba(0, 0, 0, 0.2);
      transition: right 0.28s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      flex-direction: column;
    }

    .mobile-drawer.open {
      right: 0;
    }

    .mobile-drawer-header {
      padding: 18px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
    }

    .mobile-close-btn {
      background: #f1f5f9;
      border: none;
      width: 36px;
      height: 36px;
      border-radius: 8px;
      font-size: 1.4rem;
      color: var(--text-muted);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .mobile-drawer-body {
      padding: 16px 18px 30px;
      overflow-y: auto;
      flex: 1;
    }

    .mobile-accordion {
      border-bottom: 1px solid var(--border);
      padding: 6px 0;
    }

    .mobile-summary {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text-main);
      cursor: pointer;
      list-style: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 4px;
    }

    .mobile-summary::-webkit-details-marker {
      display: none;
    }

    .mobile-accordion[open] .mobile-summary {
      color: var(--primary);
    }

    .mobile-accordion[open] .mobile-summary .arrow-icon {
      transform: rotate(180deg);
    }

    .mobile-sub-group {
      padding: 6px 4px 12px;
    }

    .mobile-sub-group ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .mobile-sub-group a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 10px;
      border-radius: 8px;
      font-size: 0.885rem;
      font-weight: 600;
      color: var(--text-muted);
      text-decoration: none;
      background: var(--bg-body);
      border: 1px solid var(--border);
    }

    .mobile-tag {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--primary);
      background: #dbeafe;
      padding: 2px 8px;
      border-radius: 9999px;
    }

    .mobile-drawer-footer {
      padding: 14px 18px;
      border-top: 1px solid var(--border);
      background: #f8fafc;
      font-size: 0.8rem;
      color: var(--text-light);
      text-align: center;
    }

    /* HERO */
    .hero {
      text-align: center;
      padding: 56px 0 38px;
      background: radial-gradient(circle at 50% 5%, #eff6ff 0%, #fafafa 80%);
      border-bottom: 1px solid var(--border);
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      color: #1e40af;
      font-size: 0.8rem;
      font-weight: 700;
      padding: 5px 14px;
      border-radius: 9999px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 16px;
    }

    .hero-title {
      font-size: 2.85rem;
      font-weight: 800;
      color: var(--text-main);
      line-height: 1.18;
      letter-spacing: -0.03em;
      margin-bottom: 14px;
    }

    .hero-title span {
      background: linear-gradient(135deg, var(--primary), var(--accent));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-subtitle {
      font-size: 1.12rem;
      color: var(--text-muted);
      max-width: 720px;
      margin: 0 auto;
    }

    /* WEB APP TOOL STUDIO */
    .studio-wrapper {
      padding: 44px 0 68px;
    }

    .app-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 30px;
      box-shadow: var(--shadow-md);
      position: relative;
    }

    .dropzone {
      border: 2px dashed #93c5fd;
      background: #f8fafc;
      border-radius: var(--radius-md);
      padding: 48px 20px;
      text-align: center;
      cursor: pointer;
      position: relative;
      transition: all 0.2s ease;
    }

    .dropzone:hover, .dropzone.dragover {
      border-color: var(--primary);
      background: var(--primary-light);
    }

    .dropzone input[type="file"] {
      position: absolute;
      inset: 0;
      opacity: 0;
      cursor: pointer;
      width: 100%;
      height: 100%;
    }

    .dropzone-icon {
      width: 52px;
      height: 52px;
      border-radius: 12px;
      background: #ffffff;
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      margin: 0 auto 14px;
      box-shadow: var(--shadow-sm);
    }

    .dropzone-title {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 4px;
    }

    .dropzone-desc {
      font-size: 0.88rem;
      color: var(--text-light);
    }

    /* WORKBENCH */
    .workbench {
      display: none;
      grid-template-columns: 1.4fr 1fr;
      gap: 30px;
      margin-top: 28px;
    }

    /* CROPPER STAGE WITH CHECKERBOARD PATTERN */
    .cropper-container-box {
      width: 100%;
      height: 480px;
      background-color: #1e293b;
      /* Transparent checkerboard */
      background-image: 
        linear-gradient(45deg, #0f172a 25%, transparent 25%), 
        linear-gradient(-45deg, #0f172a 25%, transparent 25%), 
        linear-gradient(45deg, transparent 75%, #0f172a 75%), 
        linear-gradient(-45deg, transparent 75%, #0f172a 75%);
      background-size: 24px 24px;
      background-position: 0 0, 0 12px, 12px -12px, -12px 0px;
      border-radius: var(--radius-md);
      overflow: hidden;
      border: 1px solid var(--border);
      position: relative;
    }

    .cropper-container-box img {
      display: block;
      max-width: 100%;
    }

    /* CONTROLS COLUMN */
    .controls-panel {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .control-group-title {
      font-size: 0.78rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-light);
      margin-bottom: 10px;
    }

    .presets-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }

    .preset-btn {
      background: var(--bg-body);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 7px 8px;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-muted);
      cursor: pointer;
      text-align: center;
      transition: all 0.15s ease;
    }

    .preset-btn:hover, .preset-btn.active {
      color: var(--primary);
      background: var(--primary-light);
      border-color: var(--border-focus);
    }

    /* SLIDERS MATCHING USER SCREENSHOT */
    .slider-control-block {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .slider-title {
      font-size: 0.92rem;
      font-weight: 700;
      color: #3b5998; /* Blue matching screenshot */
      text-align: center;
    }

    .slider-interactive-wrap {
      display: flex;
      align-items: center;
      gap: 12px;
      width: 100%;
    }

    .modern-range {
      flex: 1;
      height: 8px;
      border-radius: 9999px;
      background: #e2e8f0;
      accent-color: #0070f3;
      cursor: pointer;
    }

    .reset-circle-btn {
      background: none;
      border: none;
      font-size: 1.35rem;
      color: #ef4444;
      cursor: pointer;
      padding: 0 4px;
      line-height: 1;
      transition: opacity 0.2s ease;
    }

    .reset-circle-btn:hover {
      opacity: 0.7;
    }

    .filter-toggles {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .toggle-btn {
      background: var(--bg-body);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 8px 10px;
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--text-muted);
      cursor: pointer;
      text-align: center;
      transition: all 0.15s ease;
    }

    .toggle-btn.active {
      background: var(--primary);
      color: #ffffff;
      border-color: var(--primary);
    }

    /* METRICS BAR */
    .metrics-summary {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 12px 16px;
      display: flex;
      justify-content: space-between;
    }

    .metric-item {
      display: flex;
      flex-direction: column;
    }

    .metric-label {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--text-light);
      text-transform: uppercase;
    }

    .metric-value {
      font-size: 1rem;
      font-weight: 800;
      color: var(--text-main);
    }

    .metric-value.pass {
      color: #10b981;
    }

    /* ACTION BUTTONS */
    .action-btn {
      width: 100%;
      padding: 13px;
      border-radius: var(--radius-md);
      font-size: 0.95rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      border: none;
      transition: all 0.2s ease;
    }

    .btn-compress {
      background: linear-gradient(135deg, var(--primary), var(--accent));
      color: #ffffff;
      box-shadow: 0 4px 14px var(--primary-glow);
    }

    .btn-compress:hover {
      box-shadow: 0 6px 20px var(--primary-glow);
      transform: translateY(-1px);
    }

    .btn-download {
      background: #10b981;
      color: #ffffff;
      box-shadow: 0 4px 14px rgba(16, 185, 129, 0.25);
      display: none;
    }

    .btn-download:hover {
      background: #059669;
      transform: translateY(-1px);
    }

    /* EDITORIAL SEO CONTENT */
    .content-section {
      background: #ffffff;
      border-top: 1px solid var(--border);
      padding: 72px 0;
    }

    .content-wrapper {
      max-width: 860px;
      margin: 0 auto;
    }

    .content-wrapper h2 {
      font-size: 2rem;
      font-weight: 800;
      color: var(--text-main);
      margin: 40px 0 16px;
      letter-spacing: -0.025em;
    }

    .content-wrapper h2:first-of-type {
      margin-top: 0;
    }

    .content-wrapper h3 {
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--text-main);
      margin: 26px 0 12px;
    }

    .content-wrapper p {
      color: var(--text-muted);
      font-size: 1.025rem;
      line-height: 1.78;
      margin-bottom: 20px;
    }

    .content-wrapper ul, .content-wrapper ol {
      margin: 0 0 24px 22px;
      color: var(--text-muted);
    }

    .content-wrapper li {
      font-size: 1rem;
      line-height: 1.7;
      margin-bottom: 10px;
    }

    .info-callout {
      background: var(--primary-light);
      border-left: 4px solid var(--primary);
      padding: 20px 24px;
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
      margin: 28px 0;
    }

    .info-callout h4 {
      font-size: 1rem;
      font-weight: 700;
      color: var(--primary);
      margin-bottom: 4px;
    }

    .info-callout p {
      margin-bottom: 0;
      font-size: 0.925rem;
      color: #1e3a8a;
    }

    .table-responsive {
      overflow-x: auto;
      margin: 30px 0;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      -webkit-overflow-scrolling: touch;
    }

    .specs-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.925rem;
