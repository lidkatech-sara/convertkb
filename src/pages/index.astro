---
// src/pages/index.astro
import MainLayout from '../layouts/MainLayout.astro';
import ToolEngine from '../components/ToolEngine.astro';

const title = "ConvertKB - Precision Image & PDF Compressor to Exact KB";
const description = "Compress images and PDF files to exact target sizes like 20KB, 50KB, 100KB, 200KB. Built-in cropper, live preview, DPI calibration, and client-side processing.";
const canonicalUrl = "https://convertkb.com";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "ConvertKB Studio",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "All",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": description
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does ConvertKB achieve true PDF kilobyte compression in the browser?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ConvertKB renders PDF page matrices onto virtual hardware-accelerated canvas viewports using PDF.js, recalibrates DPI density, recompresses bitmap layers via lossy DCT quality scales, and reconstructs optimized PDFs using PDF-Lib."
          }
        },
        {
          "@type": "Question",
          "name": "Can I convert color scanned documents to pure black and white for exam uploads?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Enable the Document Whiten (B&W) mode in either the Image or PDF studio to whiten grayish background paper and reduce file size by up to 80% while retaining text contrast."
          }
        }
      ]
    }
  ]
};
---

<MainLayout title={title} description={description} canonicalUrl={canonicalUrl} schema={schema}>
  <main>
    <section class="hero-section">
      <div class="container">
        <h1>Precision Image &amp; PDF Compressor</h1>
        <p>
          Crop, rotate, filter, and compress images and multi-page PDF documents to exact file targets (20KB, 50KB, 100KB, 200KB) with instant live preview.
        </p>

        <ToolEngine defaultMode="image" defaultTargetKb={50} defaultFormat="image/jpeg" defaultRatio={0} />
      </div>
    </section>

    <section class="content-section">
      <div class="container content-body">
        <h2>Precision Kilobyte Compression &amp; Client-Side Digital Processing</h2>
        <p>
          State recruitment portals, national examination testing bodies, passport issuing offices, and financial verification platforms have enforced stringent digital submission criteria. Portals like the Union Public Service Commission (UPSC), Staff Selection Commission (SSC), National Testing Agency (NTA NEET/JEE), and the Income Tax Department for PAN cards reject candidates whose uploaded photograph or signature deviates by even a single kilobyte outside strict brackets (e.g., 20KB–50KB or strictly under 20KB).
        </p>
        <p>
          ConvertKB provides an all-in-one, browser-level optimization engine. Unlike legacy tools that depend on remote cloud servers—which expose sensitive identity documents to data breaches and third-party logging—ConvertKB runs all image manipulations and PDF multi-page downsampling sequences directly inside your device's memory sandbox using WebAssembly, Canvas API, PDF.js, and PDF-Lib.
        </p>

        <h2>Official Photographic &amp; Dimensional Specifications</h2>
        <p>Consult the official document parameter table below before preparing your submissions:</p>

        <table>
          <thead>
            <tr>
              <th>Recruitment Portal / Authority</th>
              <th>Permissible Size Ceiling</th>
              <th>Prescribed Dimensions</th>
              <th>Required Aspect Ratio</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>UPSC Civil Services Photo</strong></td>
              <td>20 KB to 300 KB</td>
              <td>350 x 350 px (Min)</td>
              <td>1:1 Square</td>
            </tr>
            <tr>
              <td><strong>UPSC Signature Upload</strong></td>
              <td>20 KB to 300 KB</td>
              <td>350 x 350 px (Min)</td>
              <td>1:1 Square</td>
            </tr>
            <tr>
              <td><strong>SSC CGL / CHSL Photo</strong></td>
              <td>20 KB to 50 KB</td>
              <td>3.5 cm x 4.5 cm</td>
              <td>3.5:4.5 Passport</td>
            </tr>
            <tr>
              <td><strong>SSC Candidate Signature</strong></td>
              <td>10 KB to 20 KB</td>
              <td>4.0 cm x 2.0 cm</td>
              <td>2:1 Rectangular</td>
            </tr>
            <tr>
              <td><strong>NSDL / UTI PAN Card Photo</strong></td>
              <td>Under 50 KB</td>
              <td>2.5 cm x 3.5 cm (200 DPI)</td>
              <td>Portrait</td>
            </tr>
            <tr>
              <td><strong>NSDL PAN Signature</strong></td>
              <td>Under 20 KB</td>
              <td>2.0 cm x 4.5 cm (200 DPI)</td>
              <td>Landscape 2:1</td>
            </tr>
            <tr>
              <td><strong>US Visa Application (DS-160)</strong></td>
              <td>Under 240 KB</td>
              <td>600 x 600 px (2x2 inches)</td>
              <td>1:1 Square</td>
            </tr>
            <tr>
              <td><strong>NTA NEET / JEE Candidate Photo</strong></td>
              <td>10 KB to 200 KB</td>
              <td>Postcard &amp; Passport</td>
              <td>Vertical Portrait</td>
            </tr>
          </tbody>
        </table>

        <h2>How ConvertKB Compresses Multi-Page PDFs Without Quality Destruction</h2>
        <p>
          Many tools simply attempt to clear metadata from a PDF file. However, metadata stripping only saves 2 to 5 KB. When a PDF contains multiple scanned pages or high-resolution images, true compression requires full raster downsampling:
        </p>
        
        <h3>1. Virtual Page Rendering (PDF.js Engine)</h3>
        <p>
          ConvertKB reads the binary bytecode of your document and feeds it to Mozilla's PDF.js runtime. Each page's vector and bitmap content is drawn onto a dedicated offscreen canvas at a calculated target viewport scale. This flattens bloated layer hierarchies, embedded transparency masks, and duplicate font subsets.
        </p>

        <h3>2. Iterative Discrete Cosine Transform (DCT) Quantization</h3>
        <p>
          The rendered canvas frame is encoded into a high-efficiency JPEG byte stream. High-frequency image noise that the human eye cannot discern on mobile screens or standard monitors is systematically eliminated. For text documents, our Grayscale Mode extracts luminance channels while whitening grayish backgrounds, cutting file weights by up to 80% while retaining crisp font edges.
        </p>

        <h3>3. Document Reassembly (PDF-Lib &amp; jsPDF)</h3>
        <p>
          The compressed page streams are recompiled into a lightweight PDF container using PDF-Lib. Unreferenced object identifiers are dropped, resulting in a portable PDF that uploads cleanly to strict submission portals without rejection errors.
        </p>
      </div>
    </section>

    <section class="faq-section">
      <div class="container content-body">
        <h2 style="text-align: center; margin-bottom: 28px; border:none;">Frequently Asked Questions</h2>
        <div class="faq-card">
          <h4>Why did my PDF fail to compress on other online websites?</h4>
          <p>Most basic compressors only strip text metadata, which fails to shrink high-resolution document scans. ConvertKB uses PDF.js and offscreen canvas re-quantization to downsample the actual page bitmaps, delivering real kilobyte reductions.</p>
        </div>
        <div class="faq-card">
          <h4>How do I compress my scanned signature strictly under 20KB?</h4>
          <p>Upload your signature image, select the '2:1 Signature' crop preset, set your Target Value to '20' and Unit to 'KB', choose JPG or PNG, and click Execute. The engine uses a bisection search algorithm to calibrate compression quality right under the 20KB threshold.</p>
        </div>
        <div class="faq-card">
          <h4>Are my confidential identification documents uploaded to any server?</h4>
          <p>No. ConvertKB operates completely within your web browser. All image cropping, PDF page rendering, canvas quantization, and file assembly execute locally on your machine.</p>
        </div>
      </div>
    </section>
  </main>
</MainLayout>

<style>
  .hero-section {
    padding: 48px 0 24px;
    text-align: center;
    background: radial-gradient(circle at 50% 0%, #edf2ff 0%, #fafbfc 75%);
  }
  .hero-section h1 {
    font-size: 44px;
    font-weight: 800;
    letter-spacing: -1.2px;
    color: var(--slate-900);
    margin-bottom: 12px;
  }
  .hero-section p {
    font-size: 18px;
    color: var(--slate-600);
    max-width: 780px;
    margin: 0 auto 36px;
  }
  .content-section {
    padding: 60px 0;
    background: #ffffff;
    border-top: 1px solid var(--border);
  }
  .content-body {
    max-width: 900px;
    margin: 0 auto;
    font-size: 17px;
    line-height: 1.8;
    color: var(--slate-800);
  }
  .content-body h2 {
    font-size: 28px;
    font-weight: 800;
    margin: 44px 0 16px;
    color: var(--slate-900);
    letter-spacing: -0.6px;
    border-bottom: 2px solid var(--slate-100);
    padding-bottom: 8px;
  }
  .content-body h3 {
    font-size: 21px;
    font-weight: 700;
    margin: 28px 0 10px;
    color: var(--slate-900);
  }
  .content-body p { margin-bottom: 20px; }
  table {
    width: 100%;
    border-collapse: collapse;
    margin: 28px 0;
    font-size: 14px;
  }
  th, td { padding: 13px 16px; border: 1px solid var(--border); text-align: left; }
  th { background: var(--slate-50); font-weight: 700; color: var(--slate-900); }
  .faq-section { padding: 50px 0 80px; background: #fafbfc; }
  .faq-card {
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 22px 24px;
    margin-bottom: 14px;
    box-shadow: var(--shadow-sm);
  }
  .faq-card h4 { font-size: 17px; font-weight: 700; margin-bottom: 8px; color: var(--slate-900); }
  .faq-card p { font-size: 15px; color: var(--slate-600); margin: 0; }
  @media (max-width: 576px) {
    .hero-section h1 { font-size: 32px; }
  }
</style>
