  <!-- ==================== CLIENT-SIDE WEB APP SCRIPTS ==================== -->
  <script is:inline>
    // 1. Tool Registry Database for Instant Deep-Link Results
    const toolsRegistry = [
      { name: "Compress Image to 20KB", url: "/compress-image-to-20kb/", category: "Image", badge: "Exact 20KB", keywords: "image 20kb photo compress size reduce" },
