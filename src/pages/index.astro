---
import BaseLayout from '../layouts/layout.astro';
import ToolEngine from '../components/toolengine.astro';
import { pagesData } from '../data/pages.js';

const title = "ConvertKB - Free Online Image & PDF Compressor, Resizer & Converter Hub";
const description = "ConvertKB is the ultimate browser-based utility platform. Compress images and PDFs to exact KB limits, crop for exam portals, and convert formats 100% locally with zero server uploads.";
const canonicalURL = "https://convertkb.com/";
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL}>
  <section style="text-align: center; padding: 64px 0 40px; background: radial-gradient(circle at 50% 0%, #eff6ff 0%, #fafafa 70%); border-bottom: 1px solid var(--border);">
    <div class="container" style="max-width: 960px;">
      <h1 style="font-size: 2.8rem; font-weight: 800; color: var(--text-main); margin-bottom: 16px; letter-spacing: -0.03em;">
        The Ultimate <span style="background: linear-gradient(135deg, var(--primary), var(--accent)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Image &amp; PDF</span> Utility Hub
      </h1>
      <p style="font-size: 1.15rem; color: var(--text-muted); max-width: 720px; margin: 0 auto 30px; line-height: 1.6;">
        Instantly compress photographs to exact byte limits, manage multi-page PDF documents, and format passport, visa, and exam credentials 100% locally in your browser.
      </p>
    </div>
  </section>

  <main class="container" style="padding: 50px 24px; max-width: 1040px;">
    <!-- Interactive Tool Engine Workspace -->
    <ToolEngine toolType="image-compressor" targetSize="50KB" />

    <article style="margin-top: 60px; line-height: 1.8; color: var(--text-muted);">
      <h2 style="font-size: 1.8rem; font-weight: 800; color: var(--text-main); margin-bottom: 16px;">
        Complete Browser-Based Optimization Suite
      </h2>
      <p style="margin-bottom: 16px;">
        ConvertKB provides professional-grade browser utilities for students, applicants, and professionals. Whether you need to compress photographs down to 10KB for strict government examination portals, resize multi-page PDF certificates under 200KB, or convert document formats, our client-side engine executes all tasks directly in your device memory.
      </p>
    </article>
  </main>
</BaseLayout>
