                <!-- PDF Specific Options -->
                <div id="pdfOptions" style="display:none;">
                  <div class="control-group">
                    <label for="pdfCompressionMode">Optimization Strategy</label>
                    <select id="pdfCompressionMode">
                      <option value="aggressive">Aggressive (Downsample &amp; Strip Fonts)</option>
                      <option value="balanced" selected>Balanced (Web &amp; Upload Optimizations)</option>
                      <option value="lossless">Preserve Maximum Vector Clarity</option>
                    </select>
                  </div>
                </div>

                <button class="action-btn-primary" id="btnExecuteProcess" type="button">Execute &amp; Compress File</button>
              </div>

