      <!-- Right Header Actions -->
      <div class="flex items-center gap-3">
        <a 
          href="#interactive-compressor" 
          class="hidden sm:inline-flex items-center px-4 py-2 text-xs font-bold uppercase tracking-wider text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm hover:shadow transition"
        >
          Compress Now
        </a>

        <!-- Mobile Drawer Toggle Button -->
        <button
          id="mobile-menu-trigger"
          type="button"
          aria-label="Open directory menu"
          aria-expanded="false"
          aria-controls="mobile-side-drawer"
          class="md:hidden p-2.5 rounded-lg border border-slate-200 text-slate-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-600 transition"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </header>

  <!-- ======================== MOBILE SLIDE-OUT DRAWER ======================== -->
  
  <!-- Backdrop Overlay -->
  <div 
    id="drawer-backdrop" 
    class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out"
    aria-hidden="true"
  ></div>

  <!-- Side-Drawer Menu -->
  <aside
    id="mobile-side-drawer"
    class="fixed top-0 right-0 bottom-0 z-50 w-[86vw] max-w-sm bg-white shadow-2xl flex flex-col translate-x-full transition-transform duration-300 ease-in-out"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile Navigation"
  >
    <!-- Drawer Header -->
    <div class="h-16 px-5 border-b border-slate-100 flex items-center justify-between bg-slate-50">
      <div class="flex items-center gap-2">
        <span class="w-8 h-8 rounded-lg bg-blue-600 text-white font-black text-xs flex items-center justify-center">
