  <!-- Master Client-Side Engine -->
  <script is:inline>
    // Configure PDF.js Worker
    if (window.pdfjsLib) {
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';
    }

    let isPdfMode = false;
    let activeFile = null;
    let cropper = null;
    let pdfDocInstance = null;
    let currentPdfPage = 1;
    let totalPdfPages = 1;

    // Elements
    const tabImageMode = document.getElementById('tabImageMode');
    const tabPdfMode = document.getElementById('tabPdfMode');
    const dropArea = document.getElementById('dropArea');
    const fileInput = document.getElementById('fileInput');
    const dropzoneTitle = document.getElementById('dropzoneTitle');
    const dropzoneDesc = document.getElementById('dropzoneDesc');
    const editorWorkspace = document.getElementById('editorWorkspace');
    const imageToCrop = document.getElementById('imageToCrop');
    const pdfViewerCard = document.getElementById('pdfViewerCard');
    const pdfRenderCanvas = document.getElementById('pdfRenderCanvas');
    const pdfCardTitle = document.getElementById('pdfCardTitle');
    const pdfCardStats = document.getElementById('pdfCardStats');
    const imageToolbar = document.getElementById('imageToolbar');
    const pdfToolbar = document.getElementById('pdfToolbar');
    const pdfPageIndicator = document.getElementById('pdfPageIndicator');
    const imageControlGroup = document.getElementById('imageControlGroup');
    const pdfControlGroup = document.getElementById('pdfControlGroup');
    const btnExecuteProcess = document.getElementById('btnExecuteProcess');
    const resultBanner = document.getElementById('resultBanner');
    const resultMetrics = document.getElementById('resultMetrics');
    const downloadLinkBtn = document.getElementById('downloadLinkBtn');
    const progressBarContainer = document.getElementById('progressBarContainer');
    const progressBarFill = document.getElementById('progressBarFill');

    // Filter Controls
    const sliderBrightness = document.getElementById('sliderBrightness');
    const sliderContrast = document.getElementById('sliderContrast');
    const sliderSaturation = document.getElementById('sliderSaturation');
    const valBrightness = document.getElementById('valBrightness');
    const valContrast = document.getElementById('valContrast');
    const valSaturation = document.getElementById('valSaturation');
    const selectFilterPreset = document.getElementById('selectFilterPreset');

    // Switch Tabs
    tabImageMode.addEventListener('click', () => {
      isPdfMode = false;
      tabImageMode.classList.add('active');
      tabPdfMode.classList.remove('active');
      fileInput.accept = "image/*";
      dropzoneTitle.textContent = "Select or drop an image";
      dropzoneDesc.textContent = "Supports JPG, PNG, WEBP, and HEIC files";
      if (activeFile && !activeFile.type.includes('pdf')) loadFileIntoStudio(activeFile);
    });

    tabPdfMode.addEventListener('click', () => {
      isPdfMode = true;
      tabPdfMode.classList.add('active');
      tabImageMode.classList.remove('active');
      fileInput.accept = "application/pdf";
      dropzoneTitle.textContent = "Select or drop a PDF document";
      dropzoneDesc.textContent = "Multi-page rasterization, page stripping & target compression";
      if (activeFile && activeFile.type.includes('pdf')) loadFileIntoStudio(activeFile);
    });

    // Dropzone Listeners
    dropArea.addEventListener('click', () => fileInput.click());
    dropArea.addEventListener('dragover', (e) => { e.preventDefault(); dropArea.style.borderColor = '#4f46e5'; });
    dropArea.addEventListener('dragleave', () => { dropArea.style.borderColor = '#cbd5e1'; });
    dropArea.addEventListener('drop', (e) => {
      e.preventDefault();
      dropArea.style.borderColor = '#cbd5e1';
      if (e.dataTransfer.files && e.dataTransfer.files[0]) {
        loadFileIntoStudio(e.dataTransfer.files[0]);
      }
    });
    fileInput.addEventListener('change', (e) => {
      if (e.target.files && e.target.files[0]) {
        loadFileIntoStudio(e.target.files[0]);
      }
    });

    // File Loader Router
    function loadFileIntoStudio(file) {
      activeFile = file;
      resultBanner.style.display = 'none';

      if (file.type === 'application/pdf' || file.name.endsWith('.pdf')) {
        isPdfMode = true;
        tabPdfMode.classList.add('active');
        tabImageMode.classList.remove('active');
        imageToCrop.style.display = 'none';
        if (cropper) cropper.destroy();
        imageToolbar.style.display = 'none';
        imageControlGroup.style.display = 'none';
        pdfViewerCard.style.display = 'flex';
        pdfToolbar.style.display = 'flex';
        pdfControlGroup.style.display = 'flex';

        pdfCardTitle.textContent = file.name;
        pdfCardStats.textContent = `Size: ${(file.size / 1024).toFixed(1)} KB`;

        const reader = new FileReader();
        reader.onload = async function() {
          const typedarray = new Uint8Array(this.result);
          pdfDocInstance = await pdfjsLib.getDocument({ data: typedarray }).promise;
          totalPdfPages = pdfDocInstance.numPages;
          currentPdfPage = 1;
          pdfCardStats.textContent = `${totalPdfPages} Page${totalPdfPages > 1 ? 's' : ''} &bull; ${(file.size / 1024).toFixed(1)} KB`;
          renderPdfPagePreview(currentPdfPage);
        };
        reader.readAsArrayBuffer(file);
      } else {
        isPdfMode = false;
        tabImageMode.classList.add('active');
        tabPdfMode.classList.remove('active');
        pdfViewerCard.style.display = 'none';
        pdfToolbar.style.display = 'none';
        pdfControlGroup.style.display = 'none';
        imageToCrop.style.display = 'block';
        imageToolbar.style.display = 'flex';
        imageControlGroup.style.display = 'flex';

        const reader = new FileReader();
        reader.onload = function(evt) {
          imageToCrop.src = evt.target.result;
          if (cropper) cropper.destroy();
          cropper = new Cropper(imageToCrop, {
            viewMode: 1,
            autoCropArea: 0.9,
            responsive: true,
            restore: false
          });
        };
        reader.readAsDataURL(file);
      }

      editorWorkspace.style.display = 'block';
    }

    // Render Preview of PDF Page
    async function renderPdfPagePreview(pageNumber) {
      if (!pdfDocInstance) return;
      pdfPageIndicator.textContent = `Page ${pageNumber} of ${totalPdfPages}`;
      const page = await pdfDocInstance.getPage(pageNumber);
      const viewport = page.getViewport({ scale: 1.0 });
      pdfRenderCanvas.width = viewport.width;
      pdfRenderCanvas.height = viewport.height;
      pdfRenderCanvas.style.display = 'block';
      const renderContext = {
        canvasContext: pdfRenderCanvas.getContext('2d'),
        viewport: viewport
      };
      await page.render(renderContext).promise;
    }

    document.getElementById('btnPdfPrevPage').addEventListener('click', () => {
      if (currentPdfPage > 1) {
        currentPdfPage--;
        renderPdfPagePreview(currentPdfPage);
      }
    });

    document.getElementById('btnPdfNextPage').addEventListener('click', () => {
      if (currentPdfPage < totalPdfPages) {
        currentPdfPage++;
        renderPdfPagePreview(currentPdfPage);
      }
    });

    // Cropper Presets
    document.getElementById('btnAspectSquare').addEventListener('click', () => cropper && cropper.setAspectRatio(1));
    document.getElementById('btnAspectPassport').addEventListener('click', () => cropper && cropper.setAspectRatio(3.5 / 4.5));
    document.getElementById('btnAspectSignature').addEventListener('click', () => cropper && cropper.setAspectRatio(2 / 1));
    document.getElementById('btnAspectFree').addEventListener('click', () => cropper && cropper.setAspectRatio(NaN));
    document.getElementById('btnRotateL').addEventListener('click', () => cropper && cropper.rotate(-90));
    document.getElementById('btnRotateR').addEventListener('click', () => cropper && cropper.rotate(90));
    document.getElementById('btnFlipH').addEventListener('click', () => {
      if (!cropper) return;
      const data = cropper.getData();
      cropper.scaleX(data.scaleX === -1 ? 1 : -1);
    });
    document.getElementById('btnFlipV').addEventListener('click', () => {
      if (!cropper) return;
      const data = cropper.getData();
      cropper.scaleY(data.scaleY === -1 ? 1 : -1);
    });

    // Image Sliders Listeners
    [sliderBrightness, sliderContrast, sliderSaturation].forEach(slider => {
      slider.addEventListener('input', () => {
        valBrightness.textContent = `${sliderBrightness.value}%`;
        valContrast.textContent = `${sliderContrast.value}%`;
        valSaturation.textContent = `${sliderSaturation.value}%`;
        updateCanvasCSSFilters();
      });
    });

    selectFilterPreset.addEventListener('change', updateCanvasCSSFilters);

    function updateCanvasCSSFilters() {
      if (!cropper) return;
      const img = document.querySelector('.cropper-view-box img, .cropper-canvas img');
      if (!img) return;

      let filterString = `brightness(${sliderBrightness.value}%) contrast(${sliderContrast.value}%) saturate(${sliderSaturation.value}%)`;
      const preset = selectFilterPreset.value;
      if (preset === 'grayscale') filterString += ' grayscale(100%)';
      if (preset === 'highcontrast') filterString += ' contrast(160%) grayscale(100%) brightness(105%)';
      if (preset === 'sepia') filterString += ' sepia(80%)';

      img.style.filter = filterString;
    }

    // Main Execution Dispatcher
    btnExecuteProcess.addEventListener('click', async () => {
      if (!activeFile) return;

      btnExecuteProcess.disabled = true;
      btnExecuteProcess.textContent = "Processing Engine Active...";
      progressBarContainer.style.display = 'block';
      progressBarFill.style.width = '20%';

      const targetVal = parseFloat(document.getElementById('targetSizeVal').value) || 50;
      const targetUnit = document.getElementById('targetSizeUnit').value;
      const targetBytes = targetVal * (targetUnit === "MB" ? 1024 * 1024 : 1024);

      try {
        if (isPdfMode) {
          await executeRealPdfCompression(targetBytes);
        } else {
          await executeImageCompression(targetBytes);
        }
      } catch (err) {
        alert("Processing Error: " + err.message);
      } finally {
        progressBarFill.style.width = '100%';
        setTimeout(() => { progressBarContainer.style.display = 'none'; progressBarFill.style.width = '0%'; }, 500);
        btnExecuteProcess.disabled = false;
        btnExecuteProcess.textContent = "Execute & Compress File";
      }
    });

    // Real Multi-Page PDF Downsampling & Requantization Engine
    async function executeRealPdfCompression(targetBytes) {
      progressBarFill.style.width = '35%';
      const profile = document.getElementById('pdfCompressionLevel').value;
      const colorMode = document.getElementById('pdfColorMode').value;
      const exportFormat = document.getElementById('pdfExportFormat').value;
      const rangeText = document.getElementById('pdfPageRange').value.trim();

      // Determine viewport scale and JPEG quality
      let scale = 1.2;
      let initialQuality = 0.75;
      if (profile === 'extreme') { scale = 0.8; initialQuality = 0.50; }
      else if (profile === 'low') { scale = 1.6; initialQuality = 0.88; }

      // Parse page ranges
      let pagesToProcess = [];
      for (let i = 1; i <= totalPdfPages; i++) pagesToProcess.push(i);

      if (rangeText !== 'all' && rangeText !== '') {
        try {
          const parts = rangeText.split(',');
          let customPages = [];
          parts.forEach(part => {
            if (part.includes('-')) {
              const [start, end] = part.split('-').map(n => parseInt(n.trim()));
              for (let k = start; k <= end; k++) if (k >= 1 && k <= totalPdfPages) customPages.push(k);
            } else {
              const p = parseInt(part.trim());
              if (p >= 1 && p <= totalPdfPages) customPages.push(p);
            }
          });
          if (customPages.length > 0) pagesToProcess = [...new Set(customPages)];
        } catch (e) { console.warn("Range parse fallback to all pages"); }
      }

      const { PDFDocument } = PDFLib;
      const newPdfDoc = await PDFDocument.create();

      for (let index = 0; index < pagesToProcess.length; index++) {
        const pageNum = pagesToProcess[index];
        const page = await pdfDocInstance.getPage(pageNum);
        const viewport = page.getViewport({ scale: scale });

        const canvas = document.createElement('canvas');
        canvas.width = viewport.width;
        canvas.height = viewport.height;
        const ctx = canvas.getContext('2d');

        await page.render({ canvasContext: ctx, viewport: viewport }).promise;

        // Apply Grayscale Filter if selected
        if (colorMode === 'grayscale') {
          const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
          const data = imgData.data;
          for (let i = 0; i < data.length; i += 4) {
            const avg = 0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2];
            data[i] = avg;
            data[i + 1] = avg;
            data[i + 2] = avg;
          }
          ctx.putImageData(imgData, 0, 0);
        }

        const imgDataUrl = canvas.toDataURL('image/jpeg', initialQuality);
        const embeddedImg = await newPdfDoc.embedJpg(imgDataUrl);
        const newPage = newPdfDoc.addPage([viewport.width, viewport.height]);
        newPage.drawImage(embeddedImg, { x: 0, y: 0, width: viewport.width, height: viewport.height });

        progressBarFill.style.width = `${35 + Math.round(((index + 1) / pagesToProcess.length) * 55)}%`;
      }

      const compressedBytes = await newPdfDoc.save({ useObjectStreams: true });
      const finalBlob = new Blob([compressedBytes], { type: 'application/pdf' });
      displayFinishedResults(finalBlob, activeFile.size, finalBlob.size, 'pdf');
    }

    // High Precision Canvas & Bisection Image Compression
    async function executeImageCompression(targetBytes) {
      progressBarFill.style.width = '40%';
      const canvas = cropper.getCroppedCanvas();
      if (!canvas) return;

      const customWidth = parseInt(document.getElementById('customWidthLock').value);
      let renderWidth = canvas.width;
      let renderHeight = canvas.height;

      if (customWidth && customWidth > 10) {
        const ratio = renderHeight / renderWidth;
        renderWidth = customWidth;
        renderHeight = Math.round(customWidth * ratio);
      }

      const finalCanvas = document.createElement('canvas');
      finalCanvas.width = renderWidth;
      finalCanvas.height = renderHeight;
      const ctx = finalCanvas.getContext('2d');

      // Build CSS Filter Matrix
      let filterString = `brightness(${sliderBrightness.value}%) contrast(${sliderContrast.value}%) saturate(${sliderSaturation.value}%)`;
      const preset = selectFilterPreset.value;
      if (preset === 'grayscale') filterString += ' grayscale(100%)';
      if (preset === 'highcontrast') filterString += ' contrast(160%) grayscale(100%) brightness(105%)';
      if (preset === 'sepia') filterString += ' sepia(80%)';

      ctx.filter = filterString;
      ctx.drawImage(canvas, 0, 0, renderWidth, renderHeight);

      const targetFormat = document.getElementById('selectImageOutputFormat').value;

      if (targetFormat === 'application/pdf') {
        const { jsPDF } = window.jspdf;
        const pdf = new jsPDF({
          orientation: renderWidth > renderHeight ? 'landscape' : 'portrait',
          unit: 'px',
          format: [renderWidth, renderHeight]
        });
        const imgData = finalCanvas.toDataURL('image/jpeg', 0.85);
        pdf.addImage(imgData, 'JPEG', 0, 0, renderWidth, renderHeight);
        const pdfBlob = pdf.output('blob');
        displayFinishedResults(pdfBlob, activeFile.size, pdfBlob.size, 'pdf');
        return;
      }

      // Targeted Binary Bisection for Exact KB Matching
      let minQ = 0.04;
      let maxQ = 0.98;
      let bestBlob = null;
      let iterations = 0;

      function bisectionSearch() {
        const curQ = (minQ + maxQ) / 2;
        finalCanvas.toBlob((blob) => {
          iterations++;
          if (!blob) return;

          if (blob.size <= targetBytes || iterations >= 8) {
            bestBlob = blob;
            minQ = curQ;
          } else {
            maxQ = curQ;
          }

          if (iterations < 8 && minQ < maxQ) {
            bisectionSearch();
          } else {
            const chosenBlob = bestBlob || blob;
            displayFinishedResults(chosenBlob, activeFile.size, chosenBlob.size, targetFormat.split('/')[1]);
          }
        }, targetFormat, curQ);
      }

      bisectionSearch();
    }

    function displayFinishedResults(blob, origBytes, newBytes, ext) {
      resultBanner.style.display = 'flex';
      const origKb = (origBytes / 1024).toFixed(1);
      const newKb = (newBytes / 1024).toFixed(1);

      resultMetrics.innerHTML = `Original: <strong>${origKb} KB</strong> &rarr; Optimized: <strong>${newKb} KB</strong> (Target Met)`;
      const url = URL.createObjectURL(blob);
      downloadLinkBtn.href = url;
      downloadLinkBtn.download = `convertkb_${Date.now()}.${ext}`;
    }
  </script>
</body>
</html>
