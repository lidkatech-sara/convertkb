const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "ConvertKB Studio",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "All",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "Professional client-side Image & PDF editing, raster downsampling, and target KB compression suite."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does ConvertKB achieve true PDF kilobyte compression in the browser?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ConvertKB renders PDF page matrices onto virtual hardware-accelerated canvas viewports using PDF.js, recalibrates DPI density, recompresses bitmap layers via lossy DCT quality scales, and reconstructs optimized PDFs using PDF-Lib and jsPDF."
          }
        },
        {
          "@type": "Question",
          "name": "Can I convert color scanned documents to pure black and white for exam uploads?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Enable the Grayscale / B&W mode in either the Image or PDF studio to whiten grayish background paper and reduce file size by up to 80% while retaining text contrast."
          }
        }
      ]
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content="index, follow, max-image-preview:large" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />

  <!-- Client-Side Engine CDNs -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>
  <script is:inline src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <style>
    :root {
      --primary: #4f46e5;
      --primary-hover: #4338ca;
      --primary-light: #eef2ff;
      --accent: #06b6d4;
      --slate-900: #0f172a;
      --slate-800: #1e293b;
      --slate-700: #334155;
      --slate-600: #475569;
      --slate-500: #64748b;
      --slate-300: #cbd5e1;
      --slate-200: #e2e8f0;
      --slate-100: #f1f5f9;
      --slate-50: #f8fafc;
      --card-bg: #ffffff;
      --border: #e2e8f0;
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.05);
      --shadow-md: 0 4px 20px -2px rgba(15, 23, 42, 0.08);
      --shadow-lg: 0 18px 38px -6px rgba(15, 23, 42, 0.12);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
      background-color: #fafbfc;
      color: var(--slate-900);
      line-height: 1.6;
    }
    a { text-decoration: none; color: inherit; }
    .container { max-width: 1240px; margin: 0 auto; padding: 0 24px; }

    /* Sticky Navigation */
    header {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 1000;
    }
    .nav-container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 72px;
    }
    .brand-logo {
      font-size: 24px;
      font-weight: 800;
      letter-spacing: -0.6px;
      color: var(--slate-900);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .brand-logo .dot {
      width: 10px;
      height: 10px;
      background: var(--primary);
      border-radius: 50%;
    }
    .desktop-nav {
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .nav-menu-item { position: relative; }
    .nav-menu-btn {
      padding: 8px 14px;
      font-size: 14px;
      font-weight: 600;
      color: var(--slate-700);
      border-radius: 8px;
      display: flex;
      align-items: center;
      gap: 5px;
      cursor: pointer;
      background: transparent;
      border: none;
      transition: all 0.15s ease;
    }
    .nav-menu-btn:hover { background: var(--slate-100); color: var(--primary); }
    .dropdown-content {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      background: #ffffff;
      min-width: 270px;
      max-height: 460px;
      overflow-y: auto;
      box-shadow: var(--shadow-lg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 8px 0;
      z-index: 1100;
    }
    .nav-menu-item:hover .dropdown-content { display: block; }
    .dropdown-content a {
      display: block;
      padding: 9px 20px;
      font-size: 13px;
      font-weight: 500;
      color: var(--slate-700);
      transition: background 0.15s, color 0.15s;
    }
    .dropdown-content a:hover { background: var(--primary-light); color: var(--primary); }

    /* Studio Header Hero */
    .hero-section {
      padding: 48px 0 24px;
      text-align: center;
      background: radial-gradient(circle at 50% 0%, #edf2ff 0%, #fafbfc 75%);
    }
    .hero-section h1 {
      font-size: 44px;
      font-weight: 800;
      letter-spacing: -1.2px;
      color: var(--slate-900);
      margin-bottom: 12px;
      line-height: 1.2;
    }
    .hero-section p {
      font-size: 18px;
      color: var(--slate-600);
      max-width: 780px;
      margin: 0 auto 36px;
    }

    /* Studio Master Card */
    .studio-card {
      max-width: 1040px;
      margin: 0 auto 50px;
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: 24px;
      box-shadow: var(--shadow-lg);
      padding: 34px;
      text-align: left;
    }
    .mode-tabs {
      display: flex;
      gap: 12px;
      border-bottom: 2px solid var(--slate-100);
      margin-bottom: 28px;
      padding-bottom: 8px;
    }
    .mode-btn {
      background: none;
      border: none;
      font-size: 15px;
      font-weight: 700;
      color: var(--slate-500);
      padding: 10px 20px;
      border-radius: 10px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
    }
    .mode-btn.active {
      color: var(--primary);
      background: var(--primary-light);
    }

    /* Dropzone Upload */
    .dropzone {
      border: 2px dashed var(--slate-300);
      background: #fbfcfe;
      border-radius: 16px;
      padding: 48px 24px;
      text-align: center;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .dropzone:hover { border-color: var(--primary); background: #f5f7ff; }
    .dropzone-icon {
      font-size: 48px;
      margin-bottom: 12px;
      display: inline-block;
      color: var(--primary);
    }
    .dropzone h3 { font-size: 19px; font-weight: 700; color: var(--slate-800); margin-bottom: 4px; }
    .dropzone p { font-size: 14px; color: var(--slate-500); }

    /* Interactive Workspace Container */
    .editor-workspace {
      display: none;
      margin-top: 32px;
      border-top: 1px solid var(--border);
      padding-top: 28px;
    }
    .workspace-grid {
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      gap: 28px;
      align-items: start;
    }

    /* Visual Viewer Canvas */
    .viewer-panel {
      background: #0f172a;
      border-radius: 16px;
      overflow: hidden;
      min-height: 440px;
      max-height: 520px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }
    .viewer-panel img { max-width: 100%; display: block; }
    .viewer-panel canvas { max-width: 100%; max-height: 500px; display: block; }

    /* PDF View Card */
    .pdf-viewer-card {
      width: 100%;
      height: 100%;
      padding: 32px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: #fff;
      text-align: center;
    }
    .pdf-viewer-card .pdf-icon { font-size: 56px; margin-bottom: 12px; }
    .badge-pill {
      display: inline-block;
      padding: 4px 10px;
      background: rgba(255,255,255,0.15);
      border-radius: 9999px;
      font-size: 12px;
      font-family: 'JetBrains Mono', monospace;
      margin-top: 8px;
    }

    /* Sub Toolbar */
    .sub-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 12px;
    }
    .tool-btn {
      padding: 7px 12px;
      background: var(--slate-100);
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      color: var(--slate-700);
      cursor: pointer;
      transition: background 0.15s;
    }
    .tool-btn:hover { background: var(--slate-200); color: var(--slate-900); }

    /* Control Panel Forms */
    .controls-panel {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .card-subheading {
      font-size: 15px;
      font-weight: 800;
      color: var(--slate-900);
      border-bottom: 1px solid var(--slate-100);
      padding-bottom: 6px;
      margin-top: 4px;
    }
    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .form-group label {
      font-size: 13px;
      font-weight: 700;
      color: var(--slate-700);
      display: flex;
      justify-content: space-between;
    }
    .form-group input, .form-group select {
      width: 100%;
      padding: 9px 12px;
      border-radius: 8px;
      border: 1px solid var(--border);
      font-size: 14px;
      outline: none;
      background: #ffffff;
      color: var(--slate-800);
    }
    .form-group input:focus, .form-group select:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
    }
    .range-val { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--primary); }

    /* Master Action Button */
    .btn-execute {
      background: var(--primary);
      color: #ffffff;
      border: none;
      padding: 15px 24px;
      font-size: 16px;
      font-weight: 700;
      border-radius: 12px;
      cursor: pointer;
      width: 100%;
      margin-top: 8px;
      box-shadow: 0 4px 14px rgba(79, 70, 229, 0.3);
      transition: background 0.2s, transform 0.1s;
    }
    .btn-execute:hover { background: var(--primary-hover); }
    .btn-execute:active { transform: scale(0.99); }

    /* Results Bar */
    .result-banner {
      display: none;
      margin-top: 24px;
      padding: 18px 24px;
      background: #ecfdf5;
      border: 1px solid #a7f3d0;
      border-radius: 14px;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    .result-banner h4 { color: #065f46; font-size: 16px; font-weight: 800; margin-bottom: 2px; }
    .result-banner p { font-size: 14px; color: #047857; margin: 0; font-family: 'JetBrains Mono', monospace; }
    .btn-download {
      background: #059669;
      color: #ffffff;
      font-weight: 700;
      font-size: 14px;
      padding: 10px 20px;
      border-radius: 8px;
      white-space: nowrap;
      transition: background 0.15s;
    }
    .btn-download:hover { background: #047857; }

    /* Progress Overlay */
    .progress-bar-container {
      display: none;
      width: 100%;
      height: 8px;
      background: var(--slate-100);
      border-radius: 9999px;
      overflow: hidden;
      margin-top: 14px;
    }
    .progress-bar-fill {
      width: 0%;
      height: 100%;
      background: var(--primary);
      transition: width 0.2s ease;
    }

    /* Long-Form Article Body (AdSense & SEO Optimized) */
    .content-section {
      padding: 60px 0;
      background: #ffffff;
      border-top: 1px solid var(--border);
    }
    .content-body {
      max-width: 900px;
      margin: 0 auto;
      font-size: 17px;
      line-height: 1.8;
      color: var(--slate-800);
    }
    .content-body h2 {
      font-size: 28px;
      font-weight: 800;
      margin: 44px 0 16px;
      color: var(--slate-900);
      letter-spacing: -0.6px;
      border-bottom: 2px solid var(--slate-100);
      padding-bottom: 8px;
    }
    .content-body h3 {
      font-size: 21px;
      font-weight: 700;
      margin: 28px 0 10px;
      color: var(--slate-900);
    }
    .content-body p { margin-bottom: 20px; }
    .content-body ul, .content-body ol { margin-bottom: 24px; padding-left: 24px; }
    .content-body li { margin-bottom: 8px; }

    table {
      width: 100%;
      border-collapse: collapse;
      margin: 28px 0;
      font-size: 14px;
    }
