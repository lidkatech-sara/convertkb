      <div class="flex items-center gap-2">
        <span class="w-6 h-6 rounded-md bg-blue-600 text-white font-bold flex items-center justify-center text-xs">KB</span>
        <span class="font-bold text-slate-800">ConvertKB.com</span>
        <span>&copy; {new Date().getFullYear()} All rights reserved.</span>
      </div>

      <nav class="flex flex-wrap justify-center gap-6 font-medium">
        <a href="/privacy-policy" class="hover:text-blue-600 transition">Privacy Policy</a>
        <a href="/terms-of-service" class="hover:text-blue-600 transition">Terms of Service</a>
        <a href="/sitemap.xml" class="hover:text-blue-600 transition">XML Sitemap</a>
        <a href="#interactive-compressor" class="hover:text-blue-600 transition">Back to Top</a>
      </nav>

      <p class="text-slate-400 text-center md:text-right">
        Secure in-browser WebAssembly calibration.
      </p>
    </div>
  </footer>

  <!-- ======================== CLIENT JAVASCRIPT LOGIC ======================== -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Mobile Drawer Navigation Controller
      const menuTrigger = document.getElementById('mobile-menu-trigger');
      const drawerClose = document.getElementById('drawer-close-btn');
      const backdrop = document.getElementById('drawer-backdrop');
      const drawer = document.getElementById('mobile-side-drawer');
      const navLinks = document.querySelectorAll('.mobile-nav-link');

      function openDrawer() {
        drawer.classList.remove('translate-x-full');
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        backdrop.classList.add('opacity-100', 'pointer-events-auto');
        document.body.style.overflow = 'hidden'; // Lock background scrolling
        menuTrigger.setAttribute('aria-expanded', 'true');
      }

      function closeDrawer() {
        drawer.classList.add('translate-x-full');
        backdrop.classList.remove('opacity-100', 'pointer-events-auto');
        backdrop.classList.add('opacity-0', 'pointer-events-none');
        document.body.style.overflow = ''; // Unlock scrolling
        menuTrigger.setAttribute('aria-expanded', 'false');
      }

      if (menuTrigger) menuTrigger.addEventListener('click', openDrawer);
      if (drawerClose) drawerClose.addEventListener('click', closeDrawer);
      if (backdrop) backdrop.addEventListener('click', closeDrawer);

      // Close on clicking any sub link
      navLinks.forEach(link => {
        link.addEventListener('click', closeDrawer);
      });

      // Close on ESC key press
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !drawer.classList.contains('translate-x-full')) {
          closeDrawer();
        }
      });

      // 2. Mobile Drawer Sub-Menu Accordion Logic
      const accordionTriggers = document.querySelectorAll('.accordion-trigger');
      accordionTriggers.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetId = btn.getAttribute('data-target');
          const content = document.getElementById(targetId);
          const icon = btn.querySelector('svg');
          const isExpanded = btn.getAttribute('aria-expanded') === 'true';

          if (isExpanded) {
            content.classList.remove('expanded');
            content.classList.add('collapsed');
            btn.setAttribute('aria-expanded', 'false');
            if (icon) icon.classList.remove('rotate-180');
          } else {
            content.classList.remove('collapsed');
            content.classList.add('expanded');
            btn.setAttribute('aria-expanded', 'true');
            if (icon) icon.classList.add('rotate-180');
          }
        });
      });

      // 3. Fast Client-side Tool Filter (Instant Search)
      const searchInput = document.getElementById('tool-search-input');
      const toolItems = document.querySelectorAll('.tool-list-item');
      const categoryCards = document.querySelectorAll('.category-card');
      const feedback = document.getElementById('search-feedback');

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          const query = e.target.value.toLowerCase().trim();

          if (query === '') {
            toolItems.forEach(el => el.classList.remove('hidden'));
            categoryCards.forEach(card => card.classList.remove('hidden'));
            feedback.classList.add('hidden');
            return;
          }

          feedback.classList.remove('hidden');

          categoryCards.forEach(card => {
            const itemsInCard = card.querySelectorAll('.tool-list-item');
            let hasVisibleMatch = false;

            itemsInCard.forEach(item => {
              const text = item.textContent.toLowerCase();
              if (text.includes(query)) {
                item.classList.remove('hidden');
                hasVisibleMatch = true;
              } else {
                item.classList.add('hidden');
              }
            });

            // If no child links match, hide the whole category card
            if (hasVisibleMatch) {
              card.classList.remove('hidden');
            } else {
              card.classList.add('hidden');
            }
          });
        });
      }
    });
  </script>
</body>
</html>
