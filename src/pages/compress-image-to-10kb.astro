  <!-- Load Cropper.js from CDN -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>

  <!-- ==================== INTERACTIVE JAVASCRIPT LOGIC ==================== -->
  <script is:inline>
    let cropper = null;
    let isGrayscale = false;
    let isHighContrast = false;

    // Elements
    const fileInput = document.getElementById('fileInput');
    const dropzone = document.getElementById('dropzone');
    const workbench = document.getElementById('workbench');
    const imageElement = document.getElementById('imageElement');

    const rotateSlider = document.getElementById('rotateSlider');
    const zoomSlider = document.getElementById('zoomSlider');
    const resetRotateBtn = document.getElementById('resetRotateBtn');
    const resetZoomBtn = document.getElementById('resetZoomBtn');

    const grayscaleToggle = document.getElementById('grayscaleToggle');
    const highContrastToggle = document.getElementById('highContrastToggle');

    const origSize = document.getElementById('origSize');
    const resSize = document.getElementById('resSize');
    const compressBtn = document.getElementById('compressBtn');
    const downloadBtn = document.getElementById('downloadBtn');

    // Drag & Drop
    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('dragover');
    });
    dropzone.addEventListener('dragleave', () => dropzone.classList.remove('dragover'));
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('dragover');
      if (e.dataTransfer.files && e.dataTransfer.files[0]) handleFile(e.dataTransfer.files[0]);
    });
    fileInput.addEventListener('change', (e) => {
      if (e.target.files && e.target.files[0]) handleFile(e.target.files[0]);
    });

    function formatBytes(bytes) {
      if (!bytes) return '0 KB';
      return (bytes / 1024).toFixed(2) + ' KB';
    }

    function handleFile(file) {
      origSize.innerText = formatBytes(file.size);
      const reader = new FileReader();
      reader.onload = (e) => {
        if (cropper) {
          cropper.destroy();
        }

        imageElement.src = e.target.result;
        workbench.style.display = 'grid';
        downloadBtn.style.display = 'none';
        resSize.innerText = '--';

        // Initialize Cropper.js instance matching screenshot properties[cite: 1]
        cropper = new Cropper(imageElement, {
          viewMode: 1,
          dragMode: 'move',
          autoCropArea: 0.85,
          restore: false,
          guides: true,
          center: true,
          highlight: false,
          cropBoxMovable: true,
          cropBoxResizable: true,
          toggleDragModeOnDblclick: false,
          ready() {
            rotateSlider.value = 0;
            zoomSlider.value = 1;
          }
        });
      };
      reader.readAsDataURL(file);
    }

    // Rotation Slider Handler[cite: 1]
    rotateSlider.addEventListener('input', (e) => {
      if (cropper) {
        cropper.rotateTo(parseFloat(e.target.value));
      }
    });

    resetRotateBtn.addEventListener('click', () => {
      if (cropper) {
        rotateSlider.value = 0;
        cropper.rotateTo(0);
      }
    });

    // Zoom Slider Handler[cite: 1]
    zoomSlider.addEventListener('input', (e) => {
      if (cropper) {
        cropper.zoomTo(parseFloat(e.target.value));
      }
    });

    resetZoomBtn.addEventListener('click', () => {
      if (cropper) {
        zoomSlider.value = 1;
        cropper.zoomTo(1);
      }
    });

    // Preset Aspect Ratios
    document.querySelectorAll('.presets-grid .preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        if (!cropper) return;
        document.querySelectorAll('.presets-grid .preset-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const ratio = btn.getAttribute('data-ratio');
        if (ratio === 'free') {
          cropper.setAspectRatio(NaN);
        } else {
          cropper.setAspectRatio(parseFloat(ratio));
        }
      });
    });

    // Filter Toggles
    grayscaleToggle.addEventListener('click', () => {
      isGrayscale = !isGrayscale;
      grayscaleToggle.classList.toggle('active', isGrayscale);
      updateCanvasFilters();
    });

    highContrastToggle.addEventListener('click', () => {
      isHighContrast = !isHighContrast;
      highContrastToggle.classList.toggle('active', isHighContrast);
      updateCanvasFilters();
    });

    function updateCanvasFilters() {
      if (!imageElement) return;
      const g = isGrayscale ? 'grayscale(100%) ' : '';
      const c = isHighContrast ? 'contrast(135%) ' : '';
      imageElement.style.filter = `${g}${c}`.trim();
    }

    // Binary Search Compression Loop (Target <= 10 KB)
    compressBtn.addEventListener('click', async () => {
      if (!cropper) return;
      compressBtn.innerText = 'Compressing to 10KB...';
      compressBtn.disabled = true;

      // 1. Get raw cropped canvas
      let croppedCanvas = cropper.getCroppedCanvas({
        imageSmoothingEnabled: true,
        imageSmoothingQuality: 'high'
      });

      // 2. Apply filters onto intermediate canvas
      const intermediate = document.createElement('canvas');
      intermediate.width = croppedCanvas.width;
      intermediate.height = croppedCanvas.height;
      const intCtx = intermediate.getContext('2d');

      const g = isGrayscale ? 'grayscale(100%) ' : '';
      const c = isHighContrast ? 'contrast(135%) ' : '';
      intCtx.filter = `${g}${c}`.trim();
      intCtx.drawImage(croppedCanvas, 0, 0);

      // 3. Binary Search loop for target <= 10240 bytes
      const targetBytes = 10 * 1024;
      let low = 0.05, high = 0.92;
      let bestBlob = null;
      let currentCanvas = intermediate;

      // Downscale if aspect is too high to ever fit 10KB
      let maxDim = Math.max(currentCanvas.width, currentCanvas.height);
      if (maxDim > 500) {
        const resizeCanvas = document.createElement('canvas');
        const ratio = 500 / maxDim;
        resizeCanvas.width = Math.floor(currentCanvas.width * ratio);
        resizeCanvas.height = Math.floor(currentCanvas.height * ratio);
        resizeCanvas.getContext('2d').drawImage(currentCanvas, 0, 0, resizeCanvas.width, resizeCanvas.height);
        currentCanvas = resizeCanvas;
      }

      const getBlob = (canvas, q) => new Promise(res => canvas.toBlob(res, 'image/jpeg', q));

      for (let i = 0; i < 7; i++) {
        let mid = (low + high) / 2;
        let blob = await getBlob(currentCanvas, mid);
        if (blob.size <= targetBytes) {
          bestBlob = blob;
          low = mid; // Try higher quality
        } else {
          high = mid; // Too large, decrease quality
        }
      }

      // Progressive scale down if quality loop is still over 10KB
      let attempts = 0;
      while ((!bestBlob || bestBlob.size > targetBytes) && attempts < 4) {
        const scaledCanvas = document.createElement('canvas');
        scaledCanvas.width = Math.floor(currentCanvas.width * 0.8);
        scaledCanvas.height = Math.floor(currentCanvas.height * 0.8);
        scaledCanvas.getContext('2d').drawImage(currentCanvas, 0, 0, scaledCanvas.width, scaledCanvas.height);
        currentCanvas = scaledCanvas;
        bestBlob = await getBlob(currentCanvas, 0.4);
        attempts++;
      }

      if (bestBlob) {
        resSize.innerText = formatBytes(bestBlob.size);
        const url = URL.createObjectURL(bestBlob);
        downloadBtn.href = url;
        downloadBtn.style.display = 'flex';
        downloadBtn.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else {
        resSize.innerText = 'Failed: Re-crop smaller';
      }

      compressBtn.innerHTML = '<span>&#9889;</span> Compress to Under 10KB';
      compressBtn.disabled = false;
    });

    // Synchronize Desktop Click-to-Open Menus
    const menuDetails = document.querySelectorAll('.nav-menu-item');
    menuDetails.forEach((targetDetail) => {
      targetDetail.addEventListener('toggle', () => {
        if (targetDetail.open) {
          menuDetails.forEach((detail) => {
            if (detail !== targetDetail) detail.removeAttribute('open');
          });
        }
      });
    });

    document.addEventListener('click', (event) => {
      if (!event.target.closest('.site-header')) {
        menuDetails.forEach((detail) => detail.removeAttribute('open'));
      }
    });

    // Mobile Drawer Handlers
    const drawerOpenBtn = document.getElementById('mobileDrawerOpenBtn');
    const drawerCloseBtn = document.getElementById('mobileDrawerCloseBtn');
    const drawerOverlay = document.getElementById('mobileDrawerOverlay');
    const mobileDrawer = document.getElementById('mobileDrawer');

    function openMobileDrawer() {
      mobileDrawer.classList.add('open');
      drawerOverlay.style.display = 'block';
      document.body.style.overflow = 'hidden';
      mobileDrawer.setAttribute('aria-hidden', 'false');
    }

    function closeMobileDrawer() {
      mobileDrawer.classList.remove('open');
      drawerOverlay.style.display = 'none';
      document.body.style.overflow = '';
      mobileDrawer.setAttribute('aria-hidden', 'true');
    }

    if (drawerOpenBtn && drawerCloseBtn && drawerOverlay) {
      drawerOpenBtn.addEventListener('click', openMobileDrawer);
      drawerCloseBtn.addEventListener('click', closeMobileDrawer);
      drawerOverlay.addEventListener('click', closeMobileDrawer);
    }
  </script>

</body>
