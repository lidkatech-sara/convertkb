// Page Metadata & Canonical URLs
const siteUrl = "https://convertkb.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();
const pageTitle = "ConvertKB — Compress Images & PDFs to Exact KB Online";
const pageDescription = "Calibrate photos, certificates, signature scans, and documents to exact file targets (20KB, 50KB, 100KB, 200KB) and print-ready 200/300 DPI specifications 100% client-side.";

// Unified Crawlable Directory Architecture
const toolCategories = [
  {
    id: "popular-sizes",
    name: "Popular Target Sizes",
    description: "Targeted binary size compression engines for online portals.",
    badge: "Most Used",
    items: [
      { name: "Compress Image to 20KB", href: "/compress-image-to-20kb", tag: "Exact 20KB", tagStyle: "bg-blue-50 text-blue-700 border-blue-200" },
      { name: "Compress Image to 50KB", href: "/compress-image-to-50kb", tag: "Exact 50KB", tagStyle: "bg-blue-50 text-blue-700 border-blue-200" },
      { name: "Compress Image to 100KB", href: "/compress-image-to-100kb", tag: "Max 100KB", tagStyle: "bg-indigo-50 text-indigo-700 border-indigo-200" },
      { name: "Compress Image to 200KB", href: "/compress-image-to-200kb", tag: "Standard", tagStyle: "bg-slate-100 text-slate-700 border-slate-200" },
      { name: "Compress PDF to 100KB", href: "/compress-pdf-to-100kb", tag: "PDF Engine", tagStyle: "bg-rose-50 text-rose-700 border-rose-200" },
      { name: "Compress PDF to 200KB", href: "/compress-pdf-to-200kb", tag: "PDF Engine", tagStyle: "bg-rose-50 text-rose-700 border-rose-200" }
    ]
  },
  {
    id: "identity-visas",
    name: "Identity, Visas & Passports",
    description: "Official biometric dimension and print resolution calibration.",
    badge: "Official Specs",
    items: [
      { name: "Passport Photo 50KB (3.5x4.5 cm)", href: "/passport-photo-size-50kb", tag: "35x45 mm", tagStyle: "bg-emerald-50 text-emerald-700 border-emerald-200" },
      { name: "US Visa Photo 2x2 Inch (240KB)", href: "/us-visa-photo-size", tag: "DS-160 Ready", tagStyle: "bg-emerald-50 text-emerald-700 border-emerald-200" },
      { name: "Schengen Visa Photo Resizer", href: "/schengen-visa-photo", tag: "EU Spec", tagStyle: "bg-emerald-50 text-emerald-700 border-emerald-200" },
      { name: "Convert Image to 200 DPI", href: "/convert-to-200-dpi", tag: "Print Standard", tagStyle: "bg-purple-50 text-purple-700 border-purple-200" },
      { name: "Convert Image to 300 DPI", href: "/convert-to-300-dpi", tag: "HD Print", tagStyle: "bg-purple-50 text-purple-700 border-purple-200" }
    ]
  },
  {
    id: "government-exams",
    name: "Exams & Public Service Portals",
    description: "Strict dimension, DPI, and file limits for recruitment portals.",
    badge: "Govt Portals",
    items: [
      { name: "SSC CGL / CHSL Photo & Sign Resizer", href: "/ssc-photo-signature-resizer", tag: "SSC Standard", tagStyle: "bg-amber-50 text-amber-800 border-amber-200" },
      { name: "UPSC Civil Services Photo & Document", href: "/upsc-photo-signature-resizer", tag: "UPSC Format", tagStyle: "bg-amber-50 text-amber-800 border-amber-200" },
      { name: "Signature Resizer 10KB to 20KB", href: "/signature-resizer-10kb-20kb", tag: "Exact Sign", tagStyle: "bg-sky-50 text-sky-700 border-sky-200" },
      { name: "IBPS / Banking Exam Photo Resizer", href: "/ibps-photo-signature-compressor", tag: "Banking Format", tagStyle: "bg-amber-50 text-amber-800 border-amber-200" }
    ]
  },
  {
    id: "format-converters",
    name: "Encoders & Converters",
    description: "Next-gen web encoders and document conversions with zero quality loss.",
    badge: "High Speed",
    items: [
      { name: "JPG to WebP Compressor", href: "/jpg-to-webp-compressor", tag: "WebP Ultra", tagStyle: "bg-cyan-50 text-cyan-700 border-cyan-200" },
      { name: "PNG to JPG 50KB Calibrator", href: "/png-to-jpg-50kb", tag: "Color Balance", tagStyle: "bg-cyan-50 text-cyan-700 border-cyan-200" },
      { name: "HEIC to JPG Converter", href: "/heic-to-jpg", tag: "Apple HEIC", tagStyle: "bg-slate-100 text-slate-700 border-slate-200" },
      { name: "Image to PDF Multi-Page Merger", href: "/image-to-pdf-merger", tag: "Batch PDF", tagStyle: "bg-rose-50 text-rose-700 border-rose-200" }
    ]
  }
];

const faqs = [
  {
    question: "How does ConvertKB hit exact KB boundaries (like exactly 20KB or 50KB)?",
    answer: "Unlike typical lossy tools that apply a static compression slider, ConvertKB executes an in-browser binary search iteration over WebAssembly/Canvas encoding matrixes. It calculates the resulting byte count directly in memory until the target file boundary is achieved without exceeding limits."
  },
  {
    question: "Are my photos, certificates, or signature uploads saved to a server?",
    answer: "No. All calibration, DPI adjustment, and compression logic is executed 100% client-side via JavaScript and HTML5 Canvas API inside your browser. No files are ever uploaded or transmitted across an external network."
  },
  {
    question: "Does reducing image file size remove DPI resolution?",
    answer: "No. You can explicitly calibrate your DPI (e.g., 200 DPI or 300 DPI) while compressing file bytes. Our engine embeds proper EXIF and JFIF metadata density headers so government validators accept your file."
  }
];

// Structured Data (JSON-LD)
const schemaWebApplication = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "ConvertKB",
  "url": siteUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": pageDescription
};

const schemaFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
