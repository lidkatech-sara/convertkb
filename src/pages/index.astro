---
// src/pages/index.astro
const pageTitle = "CONVERTkb - Free Online Image & PDF Compressor to Exact KB";
const pageDescription = "Compress images, signatures, marksheet scans, and PDFs to exact file sizes (10KB, 20KB, 50KB, 100KB) and configure 200/300 DPI directly in your browser. Fast, free, and completely private with zero server uploads.";
const canonicalURL = "https://convertkb.com/";

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://convertkb.com/#website",
      "url": "https://convertkb.com/",
      "name": "CONVERTkb",
      "description": pageDescription,
      "inLanguage": "en-US"
    },
    {
      "@type": "WebApplication",
      "@id": "https://convertkb.com/#webapp",
      "url": "https://convertkb.com/",
      "name": "CONVERTkb Client-Side Image & PDF Optimizer",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Runs client-side on all modern browsers.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://convertkb.com/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does CONVERTkb compress images to an exact target KB without quality loss?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "CONVERTkb uses client-side HTML5 Canvas and native WebAssembly binary search algorithms. Rather than applying a single arbitrary compression level, our engine runs a sub-second iterative search directly in your browser memory. It adjusts discrete cosine transform (DCT) coefficients, strips redundant metadata tags, and optimizes color lookup tables until your file precisely hits the required target (such as 20KB, 50KB, or 100KB) with minimal optical distortion."
          }
        },
        {
          "@type": "Question",
          "name": "Are my uploaded photos, ID cards, marksheet scans, or signatures stored on your servers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Never. All image compression, DPI configuration, format conversion, and PDF optimization happen entirely on your local device memory using client-side JavaScript and HTML5 Canvas APIs. Zero byte payloads or metadata details are transmitted over the internet to any external server or third-party storage bucket."
          }
        },
        {
          "@type": "Question",
          "name": "Why do government recruitment portals reject photos even when the file is under 50KB?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Government portals employ multi-layered server verification. Beyond file weight limits, their automated systems evaluate pixel aspect ratios (e.g., 200x230 pixels), physical dimensions (3.5 cm x 4.5 cm), and embedded DPI metadata (usually 200 or 300 DPI). If an image has the correct KB size but lacks the expected DPI header, the intake script rejects it. Our tools synchronize all three parameters simultaneously."
          }
        },
        {
          "@type": "Question",
          "name": "How can I convert an iPhone HEIC photo to JPG below 50KB?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Modern iPhones capture images in Apple's High Efficiency Image Container (HEIC) format by default, which recruitment portals cannot read. Using our HEIC to JPG under 50KB tool, your browser unpacks the HEIC container locally, converts the color matrices into a standard JPEG color space, and resizes the file below 50KB within seconds."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between image resizing and image compression?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Resizing changes the physical dimensions or total number of pixels (for example, lowering a 4000x3000 photo to 600x800). Compression optimizes the underlying binary data within those pixels, reducing color redundancy and discarding unneeded EXIF headers to lower byte weight while maintaining identical canvas dimensions."
          }
        },
        {
          "@type": "Question",
          "name": "How do I resize a signature to 10KB-20KB with 140x60 pixels?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Select our specialized 140x60 Pixel Signature Resizer. The tool sets your canvas to the exact 140 x 60 pixel aspect ratio, adjusts contrast to keep ink strokes sharp against a pure white background, and compresses the final file to fit between 10KB and 20KB for banking (IBPS/SBI) and government forms."
          }
        }
      ]
    }
  ]
};

const schemaJson = JSON.stringify(schemaData);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonicalURL} />
  
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta name="robots" content="index, follow" />

  <script type="application/ld+json" set:html={schemaJson}></script>

  <style>
    :root {
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --primary-light: #eff6ff;
      --accent: #0ea5e9;
      --accent-glow: rgba(14, 165, 233, 0.15);
      --text-main: #0f172a;
      --text-muted: #475569;
      --text-light: #64748b;
      --bg-body: #f8fafc;
      --bg-card: #ffffff;
      --border: #e2e8f0;
      --border-hover: #cbd5e1;
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
      --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.07), 0 2px 4px -2px rgba(0, 0, 0, 0.04);
      --shadow-lg: 0 14px 28px -4px rgba(0, 0, 0, 0.08), 0 8px 12px -4px rgba(0, 0, 0, 0.03);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background-color: var(--bg-body);
      color: var(--text-main);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }

    .container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* ==================== ATTRACTIVE HEADER ==================== */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 9999;
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 72px;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 1.5rem;
      font-weight: 800;
      text-decoration: none;
      color: var(--text-main);
      letter-spacing: -0.03em;
    }

    .brand-badge {
      background: linear-gradient(135deg, var(--primary), var(--accent));
      color: #ffffff;
      padding: 3px 8px;
      border-radius: 6px;
      font-size: 0.9rem;
      font-weight: 700;
    }

    /* Desktop Navigation & Mega-Menus */
    .nav-root {
      display: flex;
      list-style: none;
      gap: 6px;
    }

    .nav-item {
      position: relative;
    }

    .nav-link {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 10px 14px;
      font-size: 0.925rem;
      font-weight: 600;
      color: var(--text-muted);
      text-decoration: none;
      border-radius: var(--radius-sm);
      transition: all 0.2s ease;
    }

    .nav-link:hover, .nav-item:focus-within > .nav-link {
      color: var(--primary);
      background: var(--primary-light);
    }

    .megamenu-panel {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-lg);
      padding: 24px;
      gap: 24px;
      z-index: 10000;
      margin-top: 4px;
    }

    .nav-item.has-megamenu:hover .megamenu-panel,
    .nav-item.has-megamenu:focus-within .megamenu-panel {
      display: grid;
    }

    .megamenu-panel.cols-2 {
      min-width: 500px;
      grid-template-columns: repeat(2, 1fr);
    }

    .megamenu-panel.cols-3 {
      min-width: 720px;
      grid-template-columns: repeat(3, 1fr);
    }

    .nav-item:last-child .megamenu-panel,
    .nav-item:nth-last-child(2) .megamenu-panel {
      left: auto;
      right: 0;
    }

    .megamenu-col h4 {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-light);
      margin-bottom: 12px;
      padding-bottom: 6px;
      border-bottom: 1px solid var(--border);
    }

    .megamenu-col ul {
      list-style: none;
    }

    .megamenu-col li {
      margin-bottom: 6px;
    }

    .megamenu-col a {
      display: block;
      font-size: 0.875rem;
      color: var(--text-muted);
      text-decoration: none;
      padding: 4px 0;
      transition: color 0.15s ease;
    }

    .megamenu-col a:hover {
      color: var(--primary);
      font-weight: 500;
    }

    .megamenu-col .hub-pill {
      display: inline-block;
      margin-top: 10px;
      font-weight: 600;
      color: var(--primary);
      font-size: 0.85rem;
    }

    /* Mobile Drawer Checkbox Pattern */
    .mobile-menu-toggle {
      display: none;
    }

    .mobile-hamburger {
      display: none;
      background: none;
      border: none;
      cursor: pointer;
      padding: 8px;
    }

    .mobile-hamburger span {
      display: block;
      width: 24px;
      height: 2.5px;
      background: var(--text-main);
      margin: 5px 0;
      border-radius: 2px;
    }

    .mobile-drawer {
      display: none;
    }

    /* ==================== HERO SECTION ==================== */
    .hero {
      text-align: center;
      padding: 70px 0 45px;
      background: radial-gradient(circle at 50% 20%, #eff6ff 0%, #f8fafc 70%);
      border-bottom: 1px solid var(--border);
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #e0e7ff;
      color: #3730a3;
      font-size: 0.8rem;
      font-weight: 700;
      padding: 6px 14px;
      border-radius: 9999px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 20px;
    }

    .hero-title {
      font-size: 3rem;
      font-weight: 800;
      color: var(--text-main);
      line-height: 1.18;
      letter-spacing: -0.035em;
      margin-bottom: 18px;
    }

    .hero-title span {
      background: linear-gradient(135deg, var(--primary), var(--accent));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-subtitle {
      font-size: 1.2rem;
      color: var(--text-muted);
      max-width: 760px;
      margin: 0 auto 32px;
      font-weight: 400;
    }

    .hero-stats {
      display: flex;
      justify-content: center;
      gap: 28px;
      flex-wrap: wrap;
    }

    .stat-badge {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--text-muted);
      background: #ffffff;
      padding: 8px 18px;
      border-radius: 9999px;
      border: 1px solid var(--border);
      box-shadow: var(--shadow-sm);
    }

    /* ==================== DIRECTORY HUB ==================== */
    .hub-section {
      padding: 50px 0 70px;
    }

    .section-intro {
      text-align: center;
      max-width: 680px;
      margin: 0 auto 40px;
    }

    .section-intro h2 {
      font-size: 2rem;
      font-weight: 800;
      color: var(--text-main);
      letter-spacing: -0.02em;
      margin-bottom: 8px;
    }

    .section-intro p {
      color: var(--text-muted);
      font-size: 1rem;
    }

    .hub-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
      gap: 28px;
    }

    .hub-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 28px;
      box-shadow: var(--shadow-sm);
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
      display: flex;
      flex-direction: column;
    }

    .hub-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
      border-color: var(--border-hover);
    }

    .hub-card-header {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 14px;
    }

    .hub-icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      background: var(--primary-light);
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 0.95rem;
    }

    .hub-card-header h3 {
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--text-main);
    }

    .hub-card-desc {
      font-size: 0.925rem;
      color: var(--text-muted);
      margin-bottom: 22px;
      line-height: 1.5;
    }

    .hub-subgroup {
      margin-bottom: 18px;
    }

    .hub-subgroup-title {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-light);
      margin-bottom: 8px;
      display: flex;
      justify-content: space-between;
    }

    .hub-links-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .hub-links-list a {
      font-size: 0.885rem;
      color: var(--text-muted);
      text-decoration: none;
      padding: 5px 8px;
      border-radius: 6px;
      transition: all 0.15s ease;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .hub-links-list a:hover {
      color: var(--primary);
      background: var(--primary-light);
    }

    .hub-links-list a span {
      font-size: 0.75rem;
      color: #94a3b8;
    }

    .hub-card-action {
      margin-top: auto;
      padding-top: 18px;
      border-top: 1px solid var(--border);
    }

    .hub-card-action a {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--primary);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .hub-card-action a:hover {
      color: var(--primary-hover);
      text-decoration: underline;
    }

    /* ==================== EDITORIAL SEO CONTENT ==================== */
    .content-section {
      background: #ffffff;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 80px 0;
    }

    .content-wrapper {
      max-width: 880px;
      margin: 0 auto;
    }

    .content-wrapper h2 {
      font-size: 2.1rem;
      font-weight: 800;
      color: var(--text-main);
      margin: 44px 0 18px;
      letter-spacing: -0.025em;
      line-height: 1.25;
    }

    .content-wrapper h2:first-of-type {
      margin-top: 0;
    }

    .content-wrapper h3 {
      font-size: 1.45rem;
      font-weight: 700;
      color: var(--text-main);
      margin: 28px 0 14px;
      letter-spacing: -0.015em;
    }

    .content-wrapper p {
      color: var(--text-muted);
      font-size: 1.05rem;
      line-height: 1.78;
      margin-bottom: 20px;
    }

    .content-wrapper ul, .content-wrapper ol {
      margin: 0 0 24px 24px;
      color: var(--text-muted);
    }

    .content-wrapper li {
      font-size: 1.025rem;
      line-height: 1.7;
      margin-bottom: 10px;
    }

    .table-responsive {
      overflow-x: auto;
      margin: 30px 0;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
    }

    .specs-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.95rem;
    }

    .specs-table th {
      background: #f1f5f9;
      color: var(--text-main);
      font-weight: 700;
      padding: 12px 16px;
      border-bottom: 1px solid var(--border);
    }

    .specs-table td {
      padding: 12px 16px;
      border-bottom: 1px solid var(--border);
      color: var(--text-muted);
    }

    .specs-table tr:last-child td {
      border-bottom: none;
    }

    /* FAQ BLOCK */
    .faq-block {
      margin-top: 50px;
    }

    .faq-item {
      background: var(--bg-body);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 24px;
      margin-bottom: 20px;
    }

    .faq-question {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 10px;
    }

    .faq-answer {
      font-size: 1rem;
      color: var(--text-muted);
      line-height: 1.7;
      margin: 0;
    }

    /* ==================== FOOTER ==================== */
    .site-footer {
      background: #0f172a;
      color: #94a3b8;
      padding: 60px 0 35px;
      font-size: 0.9rem;
    }

    .footer-top {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 40px;
      margin-bottom: 40px;
    }

    .footer-brand h3 {
      color: #ffffff;
      font-size: 1.4rem;
      margin-bottom: 14px;
      font-weight: 800;
    }

    .footer-brand p {
      line-height: 1.65;
      margin-bottom: 16px;
      color: #94a3b8;
      max-width: 520px;
    }

    .footer-col h4 {
      color: #ffffff;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 16px;
      font-weight: 700;
    }

    .footer-col ul {
      list-style: none;
    }

    .footer-col li {
      margin-bottom: 10px;
    }

    .footer-col a {
      color: #94a3b8;
      text-decoration: none;
      transition: color 0.15s ease;
    }

    .footer-col a:hover {
      color: #ffffff;
    }

    .footer-bottom {
      border-top: 1px solid #1e293b;
      padding-top: 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 20px;
    }

    .legal-nav {
      display: flex;
      gap: 24px;
    }

    .legal-nav a {
      color: #94a3b8;
      text-decoration: none;
      transition: color 0.15s ease;
    }

    .legal-nav a:hover {
      color: #ffffff;
    }

    /* ==================== RESPONSIVE RULES ==================== */
    @media (max-width: 1024px) {
      .nav-root { display: none; }
      .mobile-hamburger { display: block; }

      .mobile-menu-toggle:checked ~ .mobile-drawer {
        display: block;
      }

      .mobile-drawer {
        background: #ffffff;
        border-bottom: 1px solid var(--border);
        padding: 20px 24px;
      }

      .mobile-nav-group {
        margin-bottom: 20px;
      }

      .mobile-nav-group h4 {
        font-size: 0.8rem;
        text-transform: uppercase;
        color: var(--primary);
        font-weight: 700;
        margin-bottom: 10px;
      }

      .mobile-nav-group ul {
        list-style: none;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
      }

      .mobile-nav-group a {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.9rem;
      }

      .footer-top { grid-template-columns: 1fr; }
    }

    @media (max-width: 680px) {
      .hero-title { font-size: 2.2rem; }
      .hub-grid { grid-template-columns: 1fr; }
      .mobile-nav-group ul { grid-template-columns: 1fr; }
      .footer-bottom { flex-direction: column; text-align: center; }
      .legal-nav { flex-wrap: wrap; justify-content: center; }
    }
  </style>
</head>
<body>

  <!-- ==================== HEADER ==================== -->
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand-logo" title="CONVERTkb Homepage">
        CONVERT<span class="brand-badge">kb</span>
      </a>

      <!-- Desktop Nav with Multi-Column Mega-Menus -->
      <nav aria-label="Main Navigation">
        <ul class="nav-root">
          
          <!-- MENU 1: IMAGE -->
          <li class="nav-item has-megamenu">
            <a href="/image/" class="nav-link">Image &blacktriangledown;</a>
            <div class="megamenu-panel cols-3">
              <div class="megamenu-col">
                <h4>Target Sizes</h4>
                <ul>
                  <li><a href="/compress-image-to-10kb/">Compress Image to 10KB</a></li>
                  <li><a href="/compress-image-to-20kb/">Compress Image to 20KB</a></li>
                  <li><a href="/compress-image-to-30kb/">Compress Image to 30KB</a></li>
                  <li><a href="/compress-image-to-50kb/">Compress Image to 50KB</a></li>
                  <li><a href="/compress-image-to-100kb/">Compress Image to 100KB</a></li>
                  <li><a href="/compress-image-to-200kb/">Compress Image to 200KB</a></li>
                  <li><a href="/compress-image-to-500kb/">Compress Image to 500KB</a></li>
                </ul>
              </div>
              <div class="megamenu-col">
                <h4>DPI &amp; Dimensions</h4>
                <ul>
                  <li><a href="/change-dpi-to-200/">Change Image DPI to 200</a></li>
                  <li><a href="/convert-image-to-300-dpi/">Convert Image to 300 DPI</a></li>
                  <li><a href="/photo-3-5-x-4-5-cm-50kb/">3.5 x 4.5 cm Photo (50KB)</a></li>
                  <li><a href="/resize-image-pixels-and-kb/">Resize in Pixels and KB</a></li>
                  <li><a href="/resize-image-cm-and-kb/">Resize Image in CM and KB</a></li>
                </ul>
              </div>
              <div class="megamenu-col">
                <h4>General Tools</h4>
                <ul>
                  <li><a href="/reduce-image-size-in-kb/">Reduce Image Size in KB</a></li>
                  <li><a href="/reduce-image-size-below-50kb/">Reduce Below 50KB</a></li>
                  <li><a href="/increase-image-size-in-kb/">Increase Image Size in KB</a></li>
                  <li><a href="/convert-photo-to-50kb/">Convert Photo to 50KB</a></li>
                  <li><a href="/image-kb-reducer/">Image KB Reducer &amp; Resizer</a></li>
                  <li><a href="/image/" class="hub-pill">All Image Tools &rarr;</a></li>
                </ul>
              </div>
            </div>
          </li>

