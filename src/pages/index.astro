---
// src/pages/index.astro
const pageTitle = "Image & PDF Compressor Online | ConvertKB";
const pageDescription = "Compress images and PDFs to a target file size, resize photos and signatures, and prepare files for online forms. Use free browser-based tools for JPG, PNG, WebP, PDF, KB, MB, and DPI tasks.";
const canonicalURL = "https://convertkb.com/";

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://convertkb.com/#website",
      "url": "https://convertkb.com/",
      "name": "ConvertKB",
      "description": pageDescription,
      "inLanguage": "en"
    },
    {
      "@type": "WebApplication",
      "@id": "https://convertkb.com/#webapp",
      "url": "https://convertkb.com/",
      "name": "ConvertKB Image and PDF Tools",
      "description": pageDescription,
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Any",
      "browserRequirements": "JavaScript enabled browser",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
const schemaJson = JSON.stringify(schemaData);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonicalURL} />
  
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="ConvertKB" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#ffffff" />

  <script type="application/ld+json" set:html={schemaJson}></script>

  <style>
    :root {
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --primary-light: #eff6ff;
      --primary-glow: rgba(37, 99, 235, 0.16);
      --accent: #0ea5e9;
      --accent-light: #f0f9ff;
      --text-main: #0f172a;
      --text-muted: #475569;
      --text-light: #64748b;
      --bg-body: #f8fafc;
      --bg-card: #ffffff;
      --border: #e2e8f0;
      --border-focus: #bfdbfe;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --shadow-sm: 0 1px 3px 0 rgba(0, 0, 0, 0.04);
      --shadow-md: 0 6px 16px -2px rgba(15, 23, 42, 0.06), 0 2px 6px -2px rgba(15, 23, 42, 0.03);
      --shadow-lg: 0 20px 35px -8px rgba(15, 23, 42, 0.1), 0 8px 16px -6px rgba(15, 23, 42, 0.04);
      --shadow-dropdown: 0 16px 36px -4px rgba(15, 23, 42, 0.14), 0 4px 12px -2px rgba(15, 23, 42, 0.06);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background-color: var(--bg-body);
      color: var(--text-main);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    .skip-link {
      position: absolute;
      left: 12px;
      top: -60px;
      z-index: 3000;
      padding: 10px 14px;
      color: #fff;
      background: var(--text-main);
      border-radius: 8px;
      text-decoration: none;
    }
    .skip-link:focus { top: 12px; }

    .container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 20px;
    }

    /* ==================== APP-LIKE FROSTED HEADER ==================== */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(226, 232, 240, 0.9);
      transition: all 0.25s ease;
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 68px;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 1.4rem;
      font-weight: 800;
      text-decoration: none;
      color: var(--text-main);
      letter-spacing: -0.03em;
    }

    .logo-badge {
      width: 36px;
      height: 36px;
      background: linear-gradient(135deg, var(--primary), var(--accent));
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
      font-size: 0.9rem;
      font-weight: 900;
      box-shadow: 0 4px 12px var(--primary-glow);
    }

    .brand-badge {
      color: var(--primary);
      font-weight: 700;
    }

    /* Desktop Navigation with Click-to-Open Dropdowns */
    .nav-root {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .nav-menu-item {
      position: relative;
    }

    .nav-summary {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 8px 14px;
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--text-muted);
      cursor: pointer;
      list-style: none;
      border-radius: var(--radius-sm);
      transition: all 0.15s ease;
      user-select: none;
    }

    .nav-summary::-webkit-details-marker {
      display: none;
    }

    .nav-summary:hover,
    .nav-menu-item[open] > .nav-summary {
      color: var(--primary);
      background: var(--primary-light);
    }

    .arrow-icon {
      font-size: 0.7rem;
      transition: transform 0.2s ease;
      opacity: 0.7;
    }

    .nav-menu-item[open] .arrow-icon {
      transform: rotate(180deg);
      opacity: 1;
    }

    .megamenu-panel {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-dropdown);
      padding: 24px;
      gap: 28px;
      z-index: 1050;
      animation: menuFadeIn 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes menuFadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .megamenu-panel.cols-2 {
      min-width: 500px;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }

    .megamenu-panel.cols-3 {
      min-width: 740px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
    }

    .nav-menu-item:last-child .megamenu-panel,
    .nav-menu-item:nth-last-child(2) .megamenu-panel {
      left: auto;
      right: 0;
    }

    .megamenu-col h4 {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--text-light);
      margin-bottom: 12px;
      padding-bottom: 6px;
      border-bottom: 1px solid var(--border);
    }

    .megamenu-col ul {
      list-style: none;
    }

    .megamenu-col li {
      margin-bottom: 4px;
    }

    .megamenu-col a {
      display: block;
      font-size: 0.885rem;
      color: var(--text-muted);
      text-decoration: none;
      padding: 5px 8px;
      border-radius: 6px;
      transition: all 0.15s ease;
    }

    .megamenu-col a:hover {
      color: var(--primary);
      background: var(--primary-light);
      transform: translateX(2px);
    }

    .megamenu-col .hub-pill {
      display: inline-block;
      margin-top: 10px;
      font-weight: 600;
      color: var(--primary);
      font-size: 0.85rem;
    }

    /* Modern Mobile Hamburger */
    .mobile-hamburger {
      display: none;
      background: #f1f5f9;
      border: 1px solid var(--border);
      border-radius: 10px;
      cursor: pointer;
      width: 42px;
      height: 42px;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 5px;
      transition: background 0.15s ease;
    }

    .mobile-hamburger:hover {
      background: #e2e8f0;
    }

    .mobile-hamburger span {
      display: block;
      width: 20px;
      height: 2px;
      background: var(--text-main);
      border-radius: 2px;
    }

    /* Curated Streamlined Mobile Drawer */
    .mobile-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.5);
      backdrop-filter: blur(4px);
      z-index: 1999;
    }

    .mobile-drawer {
      position: fixed;
      top: 0;
      right: -100%;
      width: 85%;
      max-width: 360px;
      height: 100vh;
      height: 100dvh;
      background: #ffffff;
      z-index: 2000;
      box-shadow: -10px 0 30px rgba(0, 0, 0, 0.15);
      transition: right 0.28s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      flex-direction: column;
    }

    .mobile-drawer.open {
      right: 0;
    }

    .mobile-drawer-header {
      padding: 18px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
    }

    .mobile-close-btn {
      background: #f1f5f9;
      border: none;
      width: 34px;
      height: 34px;
      border-radius: 8px;
      font-size: 1.3rem;
      color: var(--text-muted);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .mobile-drawer-body {
      padding: 16px 18px 30px;
      overflow-y: auto;
      flex: 1;
    }

    .mobile-section-title {
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-light);
      margin: 16px 0 8px;
    }

    .mobile-section-title:first-of-type {
      margin-top: 0;
    }

    .mobile-quick-links {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .mobile-quick-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 12px;
      border-radius: 8px;
      font-size: 0.925rem;
      font-weight: 600;
      color: var(--text-main);
      text-decoration: none;
      background: var(--bg-body);
      border: 1px solid var(--border);
      transition: background 0.15s ease, border-color 0.15s ease;
    }

    .mobile-quick-link:hover,
    .mobile-quick-link:active {
      background: var(--primary-light);
      border-color: var(--border-focus);
      color: var(--primary);
    }

    .mobile-tag {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--primary);
      background: #dbeafe;
      padding: 2px 8px;
      border-radius: 9999px;
    }

    .mobile-drawer-footer {
      padding: 14px 18px;
      border-top: 1px solid var(--border);
      background: #f8fafc;
      font-size: 0.8rem;
      color: var(--text-light);
      text-align: center;
    }

    /* ==================== HERO SECTION & APP SEARCH ==================== */
    .hero {
      text-align: center;
      padding: 64px 0 42px;
      background: radial-gradient(circle at 50% 5%, #eff6ff 0%, #f8fafc 80%);
      border-bottom: 1px solid var(--border);
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      color: #1e40af;
      font-size: 0.8rem;
      font-weight: 700;
      padding: 6px 16px;
      border-radius: 9999px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 18px;
    }

    .hero-title {
      font-size: 3.1rem;
      font-weight: 800;
      color: var(--text-main);
      line-height: 1.15;
      letter-spacing: -0.035em;
      margin-bottom: 16px;
    }

    .hero-title span {
      background: linear-gradient(135deg, var(--primary), var(--accent));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-subtitle {
      font-size: 1.15rem;
      color: var(--text-muted);
      max-width: 760px;
      margin: 0 auto 28px;
      font-weight: 400;
    }

    .hero-stats {
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 30px;
    }

    .stat-badge {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
      background: #ffffff;
      padding: 6px 14px;
      border-radius: 9999px;
      border: 1px solid var(--border);
      box-shadow: var(--shadow-sm);
    }

    /* Live Interactive Search Box */
    .search-container {
      max-width: 580px;
      margin: 0 auto;
      position: relative;
    }

    .search-input-wrapper {
      position: relative;
    }

    .search-input {
      width: 100%;
      padding: 14px 20px 14px 46px;
      font-size: 0.98rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      background: #ffffff;
      color: var(--text-main);
      box-shadow: var(--shadow-md);
      outline: none;
      transition: all 0.2s ease;
    }

    .search-input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 4px var(--primary-glow);
    }

    .search-icon {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      color: #94a3b8;
      font-size: 1.1rem;
    }

    .search-results-dropdown {
      display: none;
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      right: 0;
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-dropdown);
      max-height: 380px;
      overflow-y: auto;
      z-index: 1100;
      text-align: left;
    }

    .search-results-header {
      padding: 10px 16px;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-light);
      background: #f8fafc;
      border-bottom: 1px solid var(--border);
    }

    .search-result-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      text-decoration: none;
      color: var(--text-main);
      border-bottom: 1px solid #f1f5f9;
      transition: background 0.15s ease;
    }

    .search-result-item:last-child {
      border-bottom: none;
    }

    .search-result-item:hover {
      background: var(--primary-light);
    }

    .result-name {
      font-size: 0.925rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .result-category {
      font-size: 0.75rem;
      color: var(--text-light);
      background: #f1f5f9;
      padding: 2px 8px;
      border-radius: 4px;
    }

    .result-badge {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--primary);
      background: #dbeafe;
      padding: 2px 8px;
      border-radius: 9999px;
    }

    .no-results-msg {
      padding: 20px;
      text-align: center;
      color: var(--text-light);
      font-size: 0.9rem;
    }

    /* Category Filter Segment Bar */
    .filter-bar-wrapper {
      margin-top: 26px;
      display: flex;
      justify-content: center;
      overflow-x: auto;
      padding-bottom: 6px;
      -webkit-overflow-scrolling: touch;
    }

    .filter-pills {
      display: inline-flex;
      background: #f1f5f9;
      padding: 4px;
      border-radius: 9999px;
      gap: 4px;
    }

    .filter-pill-btn {
      background: none;
      border: none;
      padding: 7px 14px;
      border-radius: 9999px;
      font-size: 0.84rem;
      font-weight: 600;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.15s ease;
      white-space: nowrap;
    }

    .filter-pill-btn:hover {
      color: var(--text-main);
    }

    .filter-pill-btn.active {
      background: #ffffff;
      color: var(--primary);
      box-shadow: var(--shadow-sm);
    }

    /* ==================== COMPLETE IN-BETWEEN DIRECTORY HUB ==================== */
    .hub-section {
      padding: 56px 0 76px;
    }

    .section-intro {
      text-align: center;
      max-width: 720px;
      margin: 0 auto 40px;
    }

    .section-intro h2 {
      font-size: 2.1rem;
      font-weight: 800;
      color: var(--text-main);
      letter-spacing: -0.025em;
      margin-bottom: 8px;
    }

    .section-intro p {
      color: var(--text-muted);
      font-size: 1rem;
    }

    .hub-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 24px;
    }

    .hub-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 24px;
      box-shadow: var(--shadow-sm);
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
      display: flex;
      flex-direction: column;
    }

    .hub-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
      border-color: var(--border-focus);
    }

    .hub-card-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 10px;
    }

    .hub-icon {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      background: var(--primary-light);
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 0.95rem;
    }

    .hub-card-header h3 {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text-main);
    }

    .hub-card-desc {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 18px;
      line-height: 1.5;
    }

    .hub-subgroup {
      margin-bottom: 14px;
    }

    .hub-subgroup-title {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-light);
      margin-bottom: 6px;
      display: flex;
      justify-content: space-between;
      border-bottom: 1px dashed var(--border);
      padding-bottom: 4px;
    }

    .hub-links-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .hub-links-list a {
      font-size: 0.885rem;
      color: var(--text-muted);
      text-decoration: none;
      padding: 6px 8px;
      border-radius: 6px;
      transition: all 0.15s ease;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .hub-links-list a:hover {
      color: var(--primary);
      background: var(--primary-light);
    }

    .tag-badge {
      font-size: 0.72rem;
      font-weight: 600;
      color: #64748b;
      background: #f1f5f9;
      padding: 2px 8px;
      border-radius: 9999px;
      transition: all 0.15s ease;
    }

    .hub-links-list a:hover .tag-badge {
      color: var(--primary);
      background: #dbeafe;
    }

    .hub-card-action {
      margin-top: auto;
      padding-top: 14px;
      border-top: 1px solid var(--border);
    }

    .hub-card-action a {
      font-size: 0.885rem;
      font-weight: 600;
      color: var(--primary);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .hub-card-action a:hover {
      text-decoration: underline;
    }

    /* ==================== 1450+ WORDS EDITORIAL SEO CONTENT ==================== */
    .content-section {
      background: #ffffff;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 80px 0;
    }

    .content-wrapper {
      max-width: 880px;
      margin: 0 auto;
    }

    .content-wrapper h2 {
      font-size: 2.1rem;
      font-weight: 800;
      color: var(--text-main);
      margin: 44px 0 16px;
      letter-spacing: -0.025em;
      line-height: 1.25;
    }

    .content-wrapper h2:first-of-type {
      margin-top: 0;
    }

    .content-wrapper h3 {
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--text-main);
      margin: 28px 0 12px;
      letter-spacing: -0.015em;
    }

    .content-wrapper p {
      color: var(--text-muted);
      font-size: 1.025rem;
      line-height: 1.78;
      margin-bottom: 20px;
    }

    .content-wrapper ul, .content-wrapper ol {
      margin: 0 0 24px 22px;
      color: var(--text-muted);
    }

    .content-wrapper li {
      font-size: 1rem;
      line-height: 1.7;
      margin-bottom: 10px;
    }

    .pipeline-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      margin: 28px 0 36px;
    }

    .pipeline-step {
      background: var(--bg-body);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 18px;
      position: relative;
    }

    .step-number {
      font-size: 1.6rem;
      font-weight: 800;
      color: var(--primary);
      opacity: 0.35;
      margin-bottom: 6px;
    }

    .pipeline-step h4 {
      font-size: 0.925rem;
      font-weight: 700;
      margin-bottom: 6px;
      color: var(--text-main);
    }

    .pipeline-step p {
      font-size: 0.85rem;
      line-height: 1.5;
      color: var(--text-muted);
      margin-bottom: 0;
    }

    .info-callout {
      background: var(--primary-light);
      border-left: 4px solid var(--primary);
