              <!-- Right: Compression & Parameters Controls -->
              <div class="controls-panel">
                <div class="control-row">
                  <div class="control-group">
                    <label for="targetSizeInput">Target Size</label>
                    <input type="number" id="targetSizeInput" value="50" min="5" max="50000" />
                  </div>
                  <div class="control-group">
                    <label for="targetUnit">Unit</label>
                    <select id="targetUnit">
                      <option value="KB" selected>KB</option>
                      <option value="MB">MB</option>
                    </select>
                  </div>
                </div>

                <!-- Image-specific sliders -->
                <div id="imageFilters">
                  <div class="control-group">
                    <label for="brightnessSlider">Brightness <span id="brightnessVal">100%</span></label>
                    <input type="range" id="brightnessSlider" min="50" max="150" value="100" />
                  </div>

                  <div class="control-group">
                    <label for="contrastSlider">Contrast <span id="contrastVal">100%</span></label>
                    <input type="range" id="contrastSlider" min="50" max="150" value="100" />
                  </div>

                  <div class="control-row">
                    <div class="control-group">
                      <label for="dpiSelect">Target DPI</label>
                      <select id="dpiSelect">
                        <option value="72">72 DPI (Web)</option>
                        <option value="150">150 DPI (Form Upload)</option>
                        <option value="200" selected>200 DPI (Exam Spec)</option>
                        <option value="300">300 DPI (Print)</option>
                      </select>
                    </div>

                    <div class="control-group">
                      <label for="formatSelect">Format</label>
                      <select id="formatSelect">
                        <option value="image/jpeg">JPG / JPEG</option>
                        <option value="image/png">PNG</option>
                        <option value="image/webp">WebP</option>
                        <option value="application/pdf">Compile to PDF</option>
                      </select>
