                  <p id="pdfFilesize" style="font-size: 14px; color: var(--slate-600);"></p>
                </div>

                <!-- Cropper Controls -->
                <div id="imageToolButtons" style="margin-top: 14px;" class="btn-group">
                  <button type="button" class="tool-icon-btn" id="btnCropSquare">1:1 Square</button>
                  <button type="button" class="tool-icon-btn" id="btnCropPassport">3.5:4.5 Passport</button>
                  <button type="button" class="tool-icon-btn" id="btnCropSignature">2:1 Signature</button>
                  <button type="button" class="tool-icon-btn" id="btnCropFree">Freeform</button>
                  <button type="button" class="tool-icon-btn" id="btnRotateLeft">&#8634; 90&deg;</button>
                  <button type="button" class="tool-icon-btn" id="btnRotateRight">&#8635; 90&deg;</button>
                  <button type="button" class="tool-icon-btn" id="btnFlipH">&#8644; Flip</button>
                </div>
