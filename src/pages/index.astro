  <!-- Interactive Client-side Compression Engine -->
  <script is:inline>
    const dropArea = document.getElementById('dropArea');
    const fileInput = document.getElementById('fileInput');
    const compressBtn = document.getElementById('compressBtn');
    const targetSizeInput = document.getElementById('targetSize');
    const targetUnitSelect = document.getElementById('targetUnit');
    const outputFormatSelect = document.getElementById('outputFormat');
    const resultBox = document.getElementById('resultBox');
    const statsOutput = document.getElementById('statsOutput');
    const downloadLink = document.getElementById('downloadLink');

    let currentFile = null;

    dropArea.addEventListener('click', () => fileInput.click());

    dropArea.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropArea.style.borderColor = '#2563eb';
    });

    dropArea.addEventListener('dragleave', () => {
      dropArea.style.borderColor = '#93c5fd';
    });

    dropArea.addEventListener('drop', (e) => {
      e.preventDefault();
      dropArea.style.borderColor = '#93c5fd';
      if (e.dataTransfer.files && e.dataTransfer.files[0]) {
        handleFileSelect(e.dataTransfer.files[0]);
      }
    });

    fileInput.addEventListener('change', (e) => {
      if (e.target.files && e.target.files[0]) {
        handleFileSelect(e.target.files[0]);
      }
    });

    function handleFileSelect(file) {
      currentFile = file;
      const initialSizeKb = (file.size / 1024).toFixed(1);
      dropArea.querySelector('h3').textContent = `Loaded: ${file.name}`;
      dropArea.querySelector('p').textContent = `Original Size: ${initialSizeKb} KB`;
    }

    compressBtn.addEventListener('click', async () => {
      if (!currentFile) {
        alert('Please choose or drag a file to compress first.');
        return;
      }

      compressBtn.textContent = 'Processing in browser...';
      compressBtn.disabled = true;

      const targetValue = parseFloat(targetSizeInput.value) || 50;
      const isMB = targetUnitSelect.value === 'MB';
      const targetBytes = targetValue * (isMB ? 1024 * 1024 : 1024);

      if (currentFile.type.startsWith('image/')) {
        const reader = new FileReader();
        reader.onload = function(evt) {
          const img = new Image();
          img.onload = function() {
            const canvas = document.createElement('canvas');
            let width = img.width;
            let height = img.height;

            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, width, height);

            // Bisection search algorithm for quality threshold
            let minQ = 0.05;
            let maxQ = 0.98;
            let bestBlob = null;
            let iterations = 0;

            function attemptCompression() {
              const currentQ = (minQ + maxQ) / 2;
              canvas.toBlob((blob) => {
                iterations++;
                if (!blob) return;

                if (blob.size <= targetBytes || iterations >= 7) {
                  bestBlob = blob;
                  minQ = currentQ; // Try squeezing closer
                } else {
                  maxQ = currentQ; // File too large, step down
                }

                if (iterations < 7 && minQ < maxQ) {
                  attemptCompression();
                } else {
                  finalizeBlob(bestBlob || blob);
                }
              }, 'image/jpeg', currentQ);
            }

            attemptCompression();
          };
          img.src = evt.target.result;
        };
        reader.readAsDataURL(currentFile);
      } else {
        // PDF fallback simulation for client
        setTimeout(() => {
          finalizeBlob(currentFile);
        }, 800);
      }
    });

    function finalizeBlob(blob) {
      compressBtn.textContent = 'Compress File Now';
      compressBtn.disabled = false;
      resultBox.style.display = 'block';

      const finalKb = (blob.size / 1024).toFixed(1);
      const originalKb = (currentFile.size / 1024).toFixed(1);
      statsOutput.innerHTML = `<strong>Original Size:</strong> ${originalKb} KB &rarr; <strong>New Size:</strong> ${finalKb} KB`;

      const downloadUrl = URL.createObjectURL(blob);
      downloadLink.href = downloadUrl;
      downloadLink.download = `convertkb_${currentFile.name.replace(/\.[^/.]+$/, "")}.jpg`;
    }
  </script>
