  <!-- CLIENT-SIDE SCRIPT LOGIC -->
  <script is:inline>
    // State variables
    let rawImage = null;
    let rotation = 0;
    let isGrayscale = false;
    let currentAspect = 'free';

    const fileInput = document.getElementById('fileInput');
    const dropzone = document.getElementById('dropzone');
    const workbench = document.getElementById('workbench');
    const previewCanvas = document.getElementById('previewCanvas');
    const ctx = previewCanvas.getContext('2d');

    const brightnessInput = document.getElementById('brightnessInput');
    const contrastInput = document.getElementById('contrastInput');
    const brightnessVal = document.getElementById('brightnessVal');
    const contrastVal = document.getElementById('contrastVal');
    const grayscaleBtn = document.getElementById('grayscaleBtn');
    const rotateBtn = document.getElementById('rotateBtn');

    const origSizeText = document.getElementById('origSizeText');
    const outputSizeText = document.getElementById('outputSizeText');
    const compressBtn = document.getElementById('compressBtn');
    const downloadBtn = document.getElementById('downloadBtn');

    // Drag & Drop handlers
    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('dragover');
    });

    dropzone.addEventListener('dragleave', () => {
      dropzone.classList.remove('dragover');
    });

    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('dragover');
      if (e.dataTransfer.files && e.dataTransfer.files[0]) {
        handleFile(e.dataTransfer.files[0]);
      }
    });

    fileInput.addEventListener('change', (e) => {
      if (e.target.files && e.target.files[0]) {
        handleFile(e.target.files[0]);
      }
    });

    function formatBytes(bytes) {
      if (bytes === 0) return '0 KB';
      const k = 1024;
      return (bytes / k).toFixed(2) + ' KB';
    }

    function handleFile(file) {
      origSizeText.innerText = formatBytes(file.size);
      const reader = new FileReader();
      reader.onload = (event) => {
        rawImage = new Image();
        rawImage.onload = () => {
          workbench.style.display = 'grid';
          downloadBtn.style.display = 'none';
          outputSizeText.innerText = '--';
          renderPreview();
        };
        rawImage.src = event.target.result;
      };
      reader.readAsDataURL(file);
    }

    // Aspect Ratio Selectors
    document.querySelectorAll('.button-pill-grid .pill-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.button-pill-grid .pill-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentAspect = btn.getAttribute('data-aspect');
        renderPreview();
      });
    });

    // Editor Event Listeners
    brightnessInput.addEventListener('input', (e) => {
      brightnessVal.innerText = e.target.value + '%';
      renderPreview();
    });

    contrastInput.addEventListener('input', (e) => {
      contrastVal.innerText = e.target.value + '%';
      renderPreview();
    });

    grayscaleBtn.addEventListener('click', () => {
      isGrayscale = !isGrayscale;
      grayscaleBtn.classList.toggle('active', isGrayscale);
      renderPreview();
    });

    rotateBtn.addEventListener('click', () => {
      rotation = (rotation + 90) % 360;
      renderPreview();
    });

    // Draw image to preview canvas considering crop, filters, and rotation
    function renderPreview() {
      if (!rawImage) return;

      let sw = rawImage.naturalWidth;
      let sh = rawImage.naturalHeight;
      let sx = 0;
      let sy = 0;

      // Crop calculations based on selected aspect ratio
      if (currentAspect === '1-1') {
        const size = Math.min(sw, sh);
        sx = (sw - size) / 2;
        sy = (sh - size) / 2;
        sw = size;
        sh = size;
      } else if (currentAspect === 'passport') { // 3.5 : 4.5
        const targetRatio = 3.5 / 4.5;
        if (sw / sh > targetRatio) {
          const newW = sh * targetRatio;
          sx = (sw - newW) / 2;
          sw = newW;
        } else {
          const newH = sw / targetRatio;
          sy = (sh - newH) / 2;
          sh = newH;
        }
      } else if (currentAspect === 'signature') { // 7 : 2
        const targetRatio = 7 / 2;
        if (sw / sh > targetRatio) {
          const newW = sh * targetRatio;
          sx = (sw - newW) / 2;
          sw = newW;
        } else {
          const newH = sw / targetRatio;
          sy = (sh - newH) / 2;
          sh = newH;
        }
      } else if (currentAspect === '4-3') {
        const targetRatio = 4 / 3;
        if (sw / sh > targetRatio) {
          const newW = sh * targetRatio;
          sx = (sw - newW) / 2;
          sw = newW;
        } else {
          const newH = sw / targetRatio;
          sy = (sh - newH) / 2;
          sh = newH;
        }
      } else if (currentAspect === '16-9') {
        const targetRatio = 16 / 9;
        if (sw / sh > targetRatio) {
          const newW = sh * targetRatio;
          sx = (sw - newW) / 2;
          sw = newW;
        } else {
          const newH = sw / targetRatio;
          sy = (sh - newH) / 2;
          sh = newH;
        }
      }

      // Handle Canvas Dimensions accounting for 90 or 270 degree rotation
      if (rotation === 90 || rotation === 270) {
        previewCanvas.width = sh;
        previewCanvas.height = sw;
      } else {
        previewCanvas.width = sw;
        previewCanvas.height = sh;
      }

      ctx.save();
      ctx.clearRect(0, 0, previewCanvas.width, previewCanvas.height);

      // Center for rotation
      ctx.translate(previewCanvas.width / 2, previewCanvas.height / 2);
      ctx.rotate((rotation * Math.PI) / 180);

      // Apply Filter Matrix
      const b = brightnessInput.value;
      const c = contrastInput.value;
      const g = isGrayscale ? 100 : 0;
      ctx.filter = `brightness(${b}%) contrast(${c}%) grayscale(${g}%)`;

      // Render image centered
      ctx.drawImage(rawImage, sx, sy, sw, sh, -sw / 2, -sh / 2, sw, sh);
      ctx.restore();
    }

    // Binary search compression targeting strictly <= 10KB (10240 bytes)
    compressBtn.addEventListener('click', async () => {
      if (!rawImage) return;

      compressBtn.innerText = 'Compressing...';
      compressBtn.disabled = true;

      const targetBytes = 10 * 1024; // 10240 bytes
      const sourceCanvas = previewCanvas;

      // Downscale maximum dimension if it's too large to ever fit in 10KB
      let maxDim = Math.max(sourceCanvas.width, sourceCanvas.height);
      let scale = 1.0;
      if (maxDim > 600) {
        scale = 600 / maxDim;
      }

      let currentCanvas = document.createElement('canvas');
      currentCanvas.width = Math.floor(sourceCanvas.width * scale);
      currentCanvas.height = Math.floor(sourceCanvas.height * scale);
      let cCtx = currentCanvas.getContext('2d');
      cCtx.drawImage(sourceCanvas, 0, 0, currentCanvas.width, currentCanvas.height);

      let low = 0.05;
      let high = 0.92;
      let bestBlob = null;
      let bestQuality = low;

      // Helper to generate blob
      const getBlob = (canvas, q) => {
        return new Promise(resolve => canvas.toBlob(b => resolve(b), 'image/jpeg', q));
      };

      // Perform Binary Search for Quality Level
      for (let i = 0; i < 7; i++) {
        let mid = (low + high) / 2;
        let blob = await getBlob(currentCanvas, mid);

        if (blob.size <= targetBytes) {
          bestBlob = blob;
          bestQuality = mid;
          low = mid; // Try for higher quality
        } else {
          high = mid; // Too large, decrease quality
        }
      }

      // If lowest quality is still over 10KB, progressively downsample dimensions
      if (!bestBlob || bestBlob.size > targetBytes) {
        let attempts = 0;
        while ((!bestBlob || bestBlob.size > targetBytes) && attempts < 5) {
          scale *= 0.8;
          currentCanvas.width = Math.floor(sourceCanvas.width * scale);
          currentCanvas.height = Math.floor(sourceCanvas.height * scale);
          cCtx = currentCanvas.getContext('2d');
          cCtx.drawImage(sourceCanvas, 0, 0, currentCanvas.width, currentCanvas.height);

          bestBlob = await getBlob(currentCanvas, 0.45);
          attempts++;
        }
      }

      if (bestBlob) {
        outputSizeText.innerText = formatBytes(bestBlob.size);
        const downloadUrl = URL.createObjectURL(bestBlob);
        downloadBtn.href = downloadUrl;
        downloadBtn.style.display = 'flex';
        downloadBtn.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else {
        outputSizeText.innerText = 'Failed: Scale down image';
      }

      compressBtn.innerHTML = '<span>&#9889;</span> Compress to Under 10KB';
      compressBtn.disabled = false;
    });
  </script>

