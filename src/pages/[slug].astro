  <!-- Interactive Client-Side Engine -->
  <script is:inline>
    if (window.pdfjsLib) {
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';
    }

    let studioCropper = null;
    let studioFile = null;
    let isPdfStudio = false;
    let pdfDocObj = null;
    let currentPdfPageIdx = 1;
    let totalPdfPageCount = 1;

    const studioRoot = document.querySelector('.studio-card');
    const initialMode = studioRoot ? (studioRoot.getAttribute('data-default-mode') || 'image') : 'image';
    const initialRatio = studioRoot ? (parseFloat(studioRoot.getAttribute('data-default-ratio')) || 0) : 0;

    const tabImg = document.getElementById('tabImageMode');
    const tabPdf = document.getElementById('tabPdfMode');
    const dropBox = document.getElementById('dropArea');
    const filePicker = document.getElementById('fileInput');
    const workArea = document.getElementById('editorWorkspace');
    const previewImg = document.getElementById('imageToCrop');
    const pdfCard = document.getElementById('pdfViewerCard');
    const pdfCanvas = document.getElementById('pdfRenderCanvas');
    const imgTools = document.getElementById('imageToolbar');
    const pdfTools = document.getElementById('pdfToolbar');
    const imgCtrls = document.getElementById('imageControlGroup');
    const pdfCtrls = document.getElementById('pdfControlGroup');
    const execBtn = document.getElementById('btnExecuteProcess');
    const progressBox = document.getElementById('progressBarContainer');
    const progressBar = document.getElementById('progressBarFill');
    const outBanner = document.getElementById('resultBanner');
    const outMetrics = document.getElementById('resultMetrics');
    const downloadAnchor = document.getElementById('downloadLinkBtn');

    const bSlider = document.getElementById('sliderBrightness');
    const cSlider = document.getElementById('sliderContrast');
    const sSlider = document.getElementById('sliderSaturation');
    const bVal = document.getElementById('valBrightness');
    const cVal = document.getElementById('valContrast');
    const sVal = document.getElementById('valSaturation');
    const filterPreset = document.getElementById('selectFilterPreset');

    function switchMode(toPdf) {
      isPdfStudio = toPdf;
      if (toPdf) {
        if (tabPdf) tabPdf.classList.add('active');
        if (tabImg) tabImg.classList.remove('active');
        if (filePicker) filePicker.accept = "application/pdf";
        const title = document.getElementById('dropzoneTitle');
        if (title) title.textContent = "Select or drop a PDF document";
      } else {
        if (tabImg) tabImg.classList.add('active');
        if (tabPdf) tabPdf.classList.remove('active');
        if (filePicker) filePicker.accept = "image/*";
        const title = document.getElementById('dropzoneTitle');
        if (title) title.textContent = "Select or drop an Image";
      }
    }

    if (initialMode === 'pdf') {
      switchMode(true);
    } else {
      switchMode(false);
    }

    if (tabImg) tabImg.addEventListener('click', () => switchMode(false));
    if (tabPdf) tabPdf.addEventListener('click', () => switchMode(true));

    if (dropBox && filePicker) {
      dropBox.addEventListener('click', () => filePicker.click());
      dropBox.addEventListener('dragover', (e) => { e.preventDefault(); dropBox.style.borderColor = '#4f46e5'; });
      dropBox.addEventListener('dragleave', () => { dropBox.style.borderColor = '#cbd5e1'; });
      dropBox.addEventListener('drop', (e) => {
        e.preventDefault();
        dropBox.style.borderColor = '#cbd5e1';
        if (e.dataTransfer.files && e.dataTransfer.files[0]) handleIncoming(e.dataTransfer.files[0]);
      });
      filePicker.addEventListener('change', (e) => {
        if (e.target.files && e.target.files[0]) handleIncoming(e.target.files[0]);
      });
    }

    function handleIncoming(file) {
      studioFile = file;
      if (outBanner) outBanner.style.display = 'none';

      if (file.type === 'application/pdf' || file.name.endsWith('.pdf')) {
        switchMode(true);
        if (previewImg) previewImg.style.display = 'none';
        if (studioCropper) studioCropper.destroy();
        if (imgTools) imgTools.style.display = 'none';
        if (imgCtrls) imgCtrls.style.display = 'none';
        if (pdfCard) pdfCard.style.display = 'flex';
        if (pdfTools) pdfTools.style.display = 'flex';
        if (pdfCtrls) pdfCtrls.style.display = 'flex';

        const pTitle = document.getElementById('pdfCardTitle');
        if (pTitle) pTitle.textContent = file.name;
        const reader = new FileReader();
        reader.onload = async function() {
          const typedarray = new Uint8Array(this.result);
          pdfDocObj = await pdfjsLib.getDocument({ data: typedarray }).promise;
          totalPdfPageCount = pdfDocObj.numPages;
          currentPdfPageIdx = 1;
          const pStats = document.getElementById('pdfCardStats');
          if (pStats) pStats.textContent = `${totalPdfPageCount} Pages • ${(file.size / 1024).toFixed(1)} KB`;
          renderPdfPage(currentPdfPageIdx);
        };
        reader.readAsArrayBuffer(file);
      } else {
        switchMode(false);
        if (pdfCard) pdfCard.style.display = 'none';
        if (pdfTools) pdfTools.style.display = 'none';
        if (pdfCtrls) pdfCtrls.style.display = 'none';
        if (previewImg) previewImg.style.display = 'block';
        if (imgTools) imgTools.style.display = 'flex';
        if (imgCtrls) imgCtrls.style.display = 'flex';

        const reader = new FileReader();
        reader.onload = function(evt) {
          if (previewImg) previewImg.src = evt.target.result;
          if (studioCropper) studioCropper.destroy();
          studioCropper = new Cropper(previewImg, {
            viewMode: 1,
            aspectRatio: initialRatio || NaN,
            autoCropArea: 0.9,
            responsive: true
          });
        };
        reader.readAsDataURL(file);
      }
      if (workArea) workArea.style.display = 'block';
    }

    async function renderPdfPage(pageNum) {
      if (!pdfDocObj) return;
      const ind = document.getElementById('pdfPageIndicator');
      if (ind) ind.textContent = `Page ${pageNum} of ${totalPdfPageCount}`;
      const page = await pdfDocObj.getPage(pageNum);
      const viewport = page.getViewport({ scale: 1.0 });
      if (pdfCanvas) {
        pdfCanvas.width = viewport.width;
        pdfCanvas.height = viewport.height;
        pdfCanvas.style.display = 'block';
        await page.render({ canvasContext: pdfCanvas.getContext('2d'), viewport: viewport }).promise;
      }
    }

    const pPrev = document.getElementById('btnPdfPrevPage');
    const pNext = document.getElementById('btnPdfNextPage');
    if (pPrev) pPrev.addEventListener('click', () => {
      if (currentPdfPageIdx > 1) { currentPdfPageIdx--; renderPdfPage(currentPdfPageIdx); }
    });
    if (pNext) pNext.addEventListener('click', () => {
      if (currentPdfPageIdx < totalPdfPageCount) { currentPdfPageIdx++; renderPdfPage(currentPdfPageIdx); }
    });

    const bSquare = document.getElementById('btnAspectSquare');
    const bPass = document.getElementById('btnAspectPassport');
    const bSign = document.getElementById('btnAspectSignature');
    const bFree = document.getElementById('btnAspectFree');
    const rL = document.getElementById('btnRotateL');
    const rR = document.getElementById('btnRotateR');
    const fH = document.getElementById('btnFlipH');
    const fV = document.getElementById('btnFlipV');

    if (bSquare) bSquare.addEventListener('click', () => studioCropper && studioCropper.setAspectRatio(1));
    if (bPass) bPass.addEventListener('click', () => studioCropper && studioCropper.setAspectRatio(3.5 / 4.5));
    if (bSign) bSign.addEventListener('click', () => studioCropper && studioCropper.setAspectRatio(2 / 1));
    if (bFree) bFree.addEventListener('click', () => studioCropper && studioCropper.setAspectRatio(NaN));
    if (rL) rL.addEventListener('click', () => studioCropper && studioCropper.rotate(-90));
    if (rR) rR.addEventListener('click', () => studioCropper && studioCropper.rotate(90));
    if (fH) fH.addEventListener('click', () => {
      if (!studioCropper) return;
      const d = studioCropper.getData();
      studioCropper.scaleX(d.scaleX === -1 ? 1 : -1);
    });
    if (fV) fV.addEventListener('click', () => {
      if (!studioCropper) return;
      const d = studioCropper.getData();
      studioCropper.scaleY(d.scaleY === -1 ? 1 : -1);
    });

    [bSlider, cSlider, sSlider].forEach(el => {
      if (el) {
        el.addEventListener('input', () => {
          if (bVal && bSlider) bVal.textContent = `${bSlider.value}%`;
          if (cVal && cSlider) cVal.textContent = `${cSlider.value}%`;
          if (sVal && sSlider) sVal.textContent = `${sSlider.value}%`;
          updateFilters();
        });
      }
    });
    if (filterPreset) filterPreset.addEventListener('change', updateFilters);

    function updateFilters() {
      if (!studioCropper || !studioRoot) return;
      const imgEl = studioRoot.querySelector('.cropper-view-box img, .cropper-canvas img');
      if (!imgEl) return;
      let s = `brightness(${bSlider ? bSlider.value : 100}%) contrast(${cSlider ? cSlider.value : 100}%) saturate(${sSlider ? sSlider.value : 100}%)`;
      if (filterPreset && filterPreset.value === 'grayscale') s += ' grayscale(100%)';
      if (filterPreset && filterPreset.value === 'highcontrast') s += ' contrast(160%) grayscale(100%)';
      imgEl.style.filter = s;
    }

    if (execBtn) {
      execBtn.addEventListener('click', async () => {
        if (!studioFile) return;
        execBtn.disabled = true;
        execBtn.textContent = 'Processing...';
        if (progressBox) progressBox.style.display = 'block';
        if (progressBar) progressBar.style.width = '30%';

        const tInput = document.getElementById('targetSizeVal');
        const uInput = document.getElementById('targetSizeUnit');
        const targetVal = tInput ? (parseFloat(tInput.value) || 50) : 50;
        const targetUnit = uInput ? uInput.value : 'KB';
        const targetBytes = targetVal * (targetUnit === "MB" ? 1024 * 1024 : 1024);

        try {
          if (isPdfStudio) {
            await processPdf(targetBytes);
          } else {
            await processImg(targetBytes);
          }
        } catch (err) {
          alert("Processing error: " + err.message);
        } finally {
          if (progressBar) progressBar.style.width = '100%';
          setTimeout(() => { 
            if (progressBox) progressBox.style.display = 'none'; 
            if (progressBar) progressBar.style.width = '0%'; 
          }, 500);
          execBtn.disabled = false;
          execBtn.textContent = 'Execute & Compress File';
        }
      });
    }

    async function processPdf(targetBytes) {
      const profEl = document.getElementById('pdfCompressionLevel');
      const colorEl = document.getElementById('pdfColorMode');
      const profile = profEl ? profEl.value : 'balanced';
      const colorMode = colorEl ? colorEl.value : 'color';

      let scale = profile === 'extreme' ? 0.8 : (profile === 'low' ? 1.6 : 1.2);
      let quality = profile === 'extreme' ? 0.5 : (profile === 'low' ? 0.88 : 0.72);

      const { PDFDocument } = PDFLib;
      const newDoc = await PDFDocument.create();

      for (let i = 1; i <= totalPdfPageCount; i++) {
        const page = await pdfDocObj.getPage(i);
        const viewport = page.getViewport({ scale: scale });
        const c = document.createElement('canvas');
        c.width = viewport.width;
        c.height = viewport.height;
        const ctx = c.getContext('2d');
        await page.render({ canvasContext: ctx, viewport: viewport }).promise;

        if (colorMode === 'grayscale') {
          const idata = ctx.getImageData(0, 0, c.width, c.height);
          const d = idata.data;
          for (let j = 0; j < d.length; j += 4) {
            const avg = 0.299 * d[j] + 0.587 * d[j+1] + 0.114 * d[j+2];
            d[j] = avg; d[j+1] = avg; d[j+2] = avg;
          }
          ctx.putImageData(idata, 0, 0);
        }

        const imgUrl = c.toDataURL('image/jpeg', quality);
        const embedded = await newDoc.embedJpg(imgUrl);
        const p = newDoc.addPage([viewport.width, viewport.height]);
        p.drawImage(embedded, { x: 0, y: 0, width: viewport.width, height: viewport.height });
        if (progressBar) progressBar.style.width = `${30 + Math.round((i / totalPdfPageCount) * 60)}%`;
      }

      const pdfBytes = await newDoc.save({ useObjectStreams: true });
      const blob = new Blob([pdfBytes], { type: 'application/pdf' });
      showResult(blob, 'pdf');
    }

    async function processImg(targetBytes) {
      const canvas = studioCropper.getCroppedCanvas();
      if (!canvas) return;

      const wLock = document.getElementById('customWidthLock');
      const customWidth = wLock ? parseInt(wLock.value, 10) : NaN;
      let renderWidth = canvas.width;
      let renderHeight = canvas.height;

      if (customWidth && customWidth > 10) {
        const ratio = renderHeight / renderWidth;
        renderWidth = customWidth;
        renderHeight = Math.round(customWidth * ratio);
      }

      const finalC = document.createElement('canvas');
      finalC.width = renderWidth;
      finalC.height = renderHeight;
      const ctx = finalC.getContext('2d');

      let s = `brightness(${bSlider ? bSlider.value : 100}%) contrast(${cSlider ? cSlider.value : 100}%) saturate(${sSlider ? sSlider.value : 100}%)`;
      if (filterPreset && filterPreset.value === 'grayscale') s += ' grayscale(100%)';
      if (filterPreset && filterPreset.value === 'highcontrast') s += ' contrast(160%) grayscale(100%)';
      ctx.filter = s;
      ctx.drawImage(canvas, 0, 0, renderWidth, renderHeight);

      const fSelect = document.getElementById('selectImageOutputFormat');
      const format = fSelect ? fSelect.value : 'image/jpeg';

      if (format === 'application/pdf') {
        const { jsPDF } = window.jspdf;
        const pdf = new jsPDF({
          orientation: renderWidth > renderHeight ? 'landscape' : 'portrait',
          unit: 'px',
          format: [renderWidth, renderHeight]
        });
        pdf.addImage(finalC.toDataURL('image/jpeg', 0.85), 'JPEG', 0, 0, renderWidth, renderHeight);
        showResult(pdf.output('blob'), 'pdf');
        return;
      }

      let minQ = 0.05, maxQ = 0.98, bestBlob = null, iters = 0;
      function bisect() {
        const q = (minQ + maxQ) / 2;
        finalC.toBlob((blob) => {
          iters++;
          if (!blob) return;
          if (blob.size <= targetBytes || iters >= 8) {
            bestBlob = blob;
            minQ = q;
          } else {
            maxQ = q;
          }
          if (iters < 8 && minQ < maxQ) {
            bisect();
          } else {
            showResult(bestBlob || blob, format.split('/')[1] || 'jpg');
          }
        }, format, q);
      }
      bisect();
    }

    function showResult(blob, ext) {
      if (outBanner) outBanner.style.display = 'flex';
      const oKb = studioFile ? (studioFile.size / 1024).toFixed(1) : "0";
      const nKb = (blob.size / 1024).toFixed(1);
      if (outMetrics) outMetrics.innerHTML = `Original: <strong>${oKb} KB</strong> &rarr; Processed: <strong>${nKb} KB</strong> (Verified)`;
      const url = URL.createObjectURL(blob);
      if (downloadAnchor) {
        downloadAnchor.href = url;
        downloadAnchor.download = `convertkb_${Date.now()}.${ext}`;
      }
    }
  </script>
</body>
</html>

