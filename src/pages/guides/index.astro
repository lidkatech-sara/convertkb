---
import Layout from '../../layouts/Layout.astro';
import { GUIDES } from '../../data/guides.js';
---
<Layout title="Guides – Photo, Signature and PDF Size Help | ConvertKB" description="Plain-language guides on why uploads get rejected, image formats, signatures, PDF size and HEIC photos.">
  <section class="hero"><div class="wrap"><div class="eyebrow">Guides</div><h1>Practical guides</h1><p class="lead">Short explanations of the problems behind rejected uploads and oversized files.</p></div></section>
  <section class="section"><div class="wrap"><div class="grid g2">
    {GUIDES.map((g) => <a class="card" href={'/guides/' + g.slug}><h3>{g.title}</h3><p>{g.desc}</p><p style="margin-top:10px;font-size:13px">{g.read} min read</p></a>)}
  </div></div></section>
</Layout>
